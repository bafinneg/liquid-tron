// Ares helm: the primary figure of the sentinel lock (FEAT-ares-sentinel-lock).
// The helm is the Herm Ares eikon drawn as a 96x96 field of LED dots (shaders/helm.frag, assets/ares-atlas.png).
// Its pose comes from the eikon's own rendered frames, driven by spring physics instead of a fixed timer:
//   yaw track  = listening 0..30  (three-quarter left -> facing the viewer at 13 -> three-quarter right)
//   bow track  = speaking 26..46  (facing the viewer -> head lowered)
// Behaviours: turns its head to follow the subject (also across monitors), patrols when unattended, startles
// when movement resumes, lowers its head to read while you type, faces you on a wrong password, nods and
// dissolves on access.
import QtQuick

Item {
    id: helm

    readonly property var ctx: LockContext
    property real centerGX: 0
    property real centerGY: 0
    property real reachX: 1700
    property real reachY: 1100

    // Atlas layout and pose tracks. Generated by `tools/eikon/ares_atlas.py --tracks`; regenerate if the eikon changes.
    // arc = normalised visual distance (changed dots) along the track, so equal pose steps look like equal motion.
    readonly property int atlasCols: 20
    readonly property int atlasRows: 18
    readonly property var yawTrack: ({"frames": [65, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76, 77, 78, 79, 80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93, 94, 95], "arc": [0.0, 0.043, 0.0942, 0.1263, 0.1754, 0.2098, 0.2552, 0.2824, 0.3237, 0.3483, 0.3837, 0.4186, 0.4414, 0.4731, 0.4941, 0.5292, 0.5519, 0.5869, 0.6109, 0.647, 0.6866, 0.7193, 0.7616, 0.7894, 0.8316, 0.8582, 0.8963, 0.9193, 0.9523, 0.9752, 1.0]})
    readonly property var bowTrack: ({"frames": [78, 206, 207, 208, 209, 210, 211, 212, 213, 214, 215, 216, 217, 218, 219, 220, 221, 222, 223, 224, 225, 226], "arc": [0.0, 0.1742, 0.2259, 0.308, 0.3581, 0.4366, 0.4838, 0.5699, 0.5868, 0.6017, 0.6164, 0.6406, 0.6841, 0.7526, 0.8248, 0.8813, 0.9176, 0.9379, 0.9609, 0.972, 0.9792, 1.0]})
    readonly property int yawFront: 13          // yaw track frame facing the viewer (= bow track frame 0)

    // Pose (springs)
    property real yaw: 0          // -1 viewer-left .. +1 viewer-right
    property real yawV: 0
    property real bow: 0          // 0 upright .. 1 lowered
    property real bowV: 0
    property real pitch: 0        // small vertical lean toward the subject
    property real pitchV: 0

    // Effects
    property real t: 0
    property real energy: 0
    property real alert: 0
    property real check: 0
    property real caps: 0
    property real glitch: 0
    property real dissolve: 0
    property real dim: 1
    property real lockOn: 0
    property real scan: -1
    property real ripple: 9

    // Bookkeeping
    property real _acc: 0
    property real _stiffUntil: 0
    property real _patrolYaw: 0
    property real _patrolUntil: 0
    property real _nextScan: Date.now() + 2500
    property bool _wasStill: false
    property real _yawS: 0
    property real _pitchS: 0
    property real _w: 5
    property real _glanceYaw: 0
    property real _glanceUntil: 0
    property real lean: 0         // -1 moved away .. +1 moved closer (relative to the recent baseline)
    property real _nearBase: 0

    signal startled()

    function _ease(cur, target, rate, dt) { return cur + (target - cur) * (1 - Math.exp(-rate * dt)); }
    function _clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
    function _soft(v) { return Math.tanh(v * 1.25) / Math.tanh(1.25); }

    // Arc parameter s (0..1) -> fractional frame position on a track.
    function _posForArc(track, s) {
        const a = track.arc;
        if (s <= 0) return 0;
        for (let i = 1; i < a.length; i++)
            if (s <= a[i]) return i - 1 + (s - a[i - 1]) / Math.max(1e-6, a[i] - a[i - 1]);
        return a.length - 1;
    }
    // Fractional frame position -> four tiles with Gaussian weights (sigma 0.7 frames), clamped at the track ends.
    function _kernel(track, p) {
        const n = track.frames.length, base = Math.floor(p);
        const f = [], w = [];
        let sum = 0;
        for (let k = -1; k <= 2; k++) {
            const i = Math.max(0, Math.min(n - 1, base + k));
            const d = (base + k) - p;
            const wk = Math.exp(-d * d / (2 * 0.49));
            f.push(track.frames[i]); w.push(wk); sum += wk;
        }
        return [Qt.vector4d(f[0], f[1], f[2], f[3]), Qt.vector4d(w[0] / sum, w[1] / sum, w[2] / sum, w[3] / sum)];
    }
    // Pose -> kernel. Upright: yaw track. Lowered: bow track, which starts on the frontal yaw frame (seamless).
    function _frames() {
        if (bow > 0.0005) return _kernel(bowTrack, _posForArc(bowTrack, bow));
        const sf = yawTrack.arc[yawFront];
        const s = yaw < 0 ? sf * (1 + yaw) : sf + (1 - sf) * yaw;
        return _kernel(yawTrack, _posForArc(yawTrack, s));
    }

    function startScan() { if (scan < 0) scan = 0; }

    Connections {
        target: helm.ctx
        function onKeystroke(erase) { helm.energy = Math.min(1, helm.energy + (erase ? 0.05 : 0.14)); }
        function onDenied(count) { helm.glitch = 1.0; helm._stiffUntil = Date.now() + 500; }
        function onGranted() { helm.startScan(); }
        // Acquisition: the head snaps onto the subject, the crest flares and a scan sweeps the helm.
        function onArrived() { helm._stiffUntil = Date.now() + 320; helm.energy = 1; helm.startScan(); helm.startled(); }
    }

    FrameAnimation {
        running: helm.visible
        onTriggered: {
            helm._acc += frameTime;
            if (helm.ctx.dormant && helm._acc < 0.05) return;
            const dt = Math.min(0.06, helm._acc);
            helm._acc = 0;
            const now = Date.now();
            const c = helm.ctx;
            const st = c.state;
            helm.t += dt;
            helm.ripple = c.lastKey > 0 ? (now - c.lastKey) / 1000 : 9;

            // ---- Subject: the person seen by the camera first, then the pointer ----
            // A face seen in the last 3.5 s is the subject; after it leaves, the helm holds on the spot where it
            // was last seen until the hold runs out, then patrols. Without a camera the pointer drives it as before.
            const camHeld = c.camSeenAt > 0 && now - c.camSeenAt < c.camHoldMs;
            const camLive = c.faceSeen(now);
            const ptrFresh = c.pointerValid && now - c.lastPointer < 8000;
            const motionFresh = !camHeld && c.camMotionAt > 0 && now - c.camMotionAt < 1200;
            const still = !camHeld && now - c.lastInput > 8000;
            if (helm._wasStill && !still && st === "watch") {      // movement after stillness: startle
                helm._stiffUntil = now + 260;
                helm.startScan();
                helm.startled();
            }
            helm._wasStill = still;

            const ptrYaw = helm._soft(helm._clamp((c.pointerX - helm.centerGX) / helm.reachX, -1.4, 1.4));
            const ptrPitch = helm._clamp((c.pointerY - helm.centerGY) / helm.reachY, -1, 1);
            const hasSubj = camHeld || ptrFresh || c.pointerValid;
            let subjYaw = camHeld ? helm._clamp(c.camYaw, -1, 1) : ptrYaw;
            const subjPitch = camHeld ? c.camPitch * 0.8 : ptrPitch;

            // Several people: now and then a short glance at one of the others, then back to the main subject.
            if (camLive && c.camOthers.length > 0) {
                if (now > helm._glanceUntil + 2500 && Math.random() < dt * 0.25) {
                    helm._glanceYaw = c.camOthers[Math.floor(Math.random() * c.camOthers.length)];
                    helm._glanceUntil = now + 700 + Math.random() * 500;
                    helm._stiffUntil = now + 180;
                }
                if (now < helm._glanceUntil) subjYaw = helm._clamp(helm._glanceYaw, -1, 1);
            }

            // Distance, relative to the subject's own recent position (standing or seated alike): a slow baseline
            // follows camNear over ~8 s, so only a deliberate move toward or away from the screen leans the helm.
            if (camLive) helm._nearBase = helm._ease(helm._nearBase, c.camNear, c.camTrackStart > now - 1500 ? 6 : 0.12, dt);
            helm.lean = helm._ease(helm.lean, camLive ? helm._clamp((c.camNear - helm._nearBase) * 1.6, -1, 1) : 0, 2.5, dt);

            // ---- Targets ----
            let yawT = 0, bowT = 0, pitchT = 0;
            if (st === "typing" || st === "checking") {
                bowT = st === "checking" ? 0.8 : 1.0;          // reads the credential line
            } else if (st === "granted") {
                bowT = helm.dissolve < 0.05 ? 0.55 : 0.55;     // a nod: stand down
            } else if (st === "denied") {
                yawT = hasSubj ? subjYaw * 0.6 : 0;            // turns on the subject
                pitchT = hasSubj ? subjPitch : 0;
            } else if (camHeld || (ptrFresh && !still)) {
                yawT = subjYaw;
                pitchT = subjPitch;
            } else if (motionFresh && c.camMotion > 0.02 && st === "watch") {
                yawT = helm._clamp(c.camMotionYaw, -1, 1) * 0.8;   // nobody facing it: glance toward movement
            } else {
                // Patrol: hold, look aside, return; in dormancy rarely, and only partly.
                if (now > helm._patrolUntil) {
                    const toSide = helm._patrolYaw === 0 && Math.random() < (c.dormant ? 0.35 : 0.7);
                    if (toSide) {
                        helm._patrolYaw = (Math.random() < 0.5 ? -1 : 1) * (c.dormant ? 0.35 : 0.55 + Math.random() * 0.45);
                        helm._patrolUntil = now + 1800 + Math.random() * 2200;
                    } else {
                        // Return to centre, or back to where the subject was last seen.
                        helm._patrolYaw = hasSubj && Math.random() < 0.4 ? subjYaw : 0;
                        helm._patrolUntil = now + (c.dormant ? 9000 : 3500) + Math.random() * 4000;
                    }
                }
                yawT = helm._patrolYaw;
            }
            // Living sway: two slow incommensurate sines, so the head is never perfectly still.
            const swayAmp = st === "granted" ? 0 : (c.dormant ? 0.015 : 0.035);
            yawT += swayAmp * (Math.sin(helm.t * 0.37) + 0.6 * Math.sin(helm.t * 0.83 + 1.7));
            pitchT += swayAmp * 0.8 * Math.sin(helm.t * 0.29 + 0.4);

            // Lowered head faces front; it raises before turning. Coupled smoothly, not by hard switches.
            const lowered = helm._clamp(helm.bow / 0.12, 0, 1);
            yawT *= 1 - lowered;
            if (bowT > 0) bowT *= 1 - helm._clamp((Math.abs(helm.yaw) - 0.04) / 0.12, 0, 1);

            // Target smoothing (removes pointer-event stepping) and eased stiffness (no abrupt gear change).
            // Camera subject: brisker target filter and spring (90% of a turn in about 0.5 s instead of 0.9 s).
            const tr = now < helm._stiffUntil ? 40 : (camHeld ? 20 : 14);
            helm._yawS += (yawT - helm._yawS) * (1 - Math.exp(-tr * dt));
            helm._pitchS += (pitchT - helm._pitchS) * (1 - Math.exp(-6 * dt));
            const wTarget = now < helm._stiffUntil ? 16 : (c.dormant ? 2.2 : (camHeld ? 8.5 : 5.0));
            helm._w += (wTarget - helm._w) * (1 - Math.exp(-10 * dt));

            // ---- Springs: head turn slightly underdamped (zeta 0.82), a living settle without a visible bounce ----
            const w = helm._w, z = 0.82;
            helm.yawV += (w * w * (helm._yawS - helm.yaw) - 2 * z * w * helm.yawV) * dt;
            helm.yaw = helm._clamp(helm.yaw + helm.yawV * dt, -1, 1);
            const wb = 5.2;
            helm.bowV += (wb * wb * (bowT - helm.bow) - 2 * 0.9 * wb * helm.bowV) * dt;
            helm.bow = helm._clamp(helm.bow + helm.bowV * dt, 0, 1);
            const wp = 3.6;
            helm.pitchV += (wp * wp * (helm._pitchS - helm.pitch) - 2 * wp * helm.pitchV) * dt;
            helm.pitch += helm.pitchV * dt;

            // ---- Look ----
            const tracking = (camHeld || (ptrFresh && !still)) && (st === "watch" || st === "denied");
            helm.lockOn = helm._ease(helm.lockOn, tracking ? 1 : 0, 4, dt);

            // Focus point for the tracking bracket: the inverse of the pointer-to-pose mapping, applied to the pose
            // the helm actually shows (springs, sway and glances included), so the bracket sits where it looks.
            const kSoft = Math.tanh(1.25);
            const v = helm._clamp(helm.yaw * kSoft, -0.999, 0.999);
            c.gazeX = helm.centerGX + 0.5 * Math.log((1 + v) / (1 - v)) / 1.25 * helm.reachX;
            c.gazeY = helm.centerGY + helm._clamp(helm.pitch, -1, 1) * helm.reachY;
            c.gazeOn = (st === "watch" || st === "denied") && helm.bow < 0.15;
            c.gazeLock = helm.lockOn;
            c.gazeYaw = helm.yaw;
            helm.dim = helm._ease(helm.dim, st === "dormant" ? 0.32 : 1.0, st === "dormant" ? 0.6 : 5, dt);
            helm.alert = helm._ease(helm.alert, (st === "denied" || (c.redAlert && st !== "checking" && st !== "granted")) ? 1 : (c.failures >= 3 ? 0.22 : 0), 10, dt);
            helm.check = helm._ease(helm.check, st === "checking" ? 1 : 0, 12, dt);
            helm.caps = helm._ease(helm.caps, c.caps ? 1 : 0, 8, dt);
            helm.glitch = Math.max(0, helm.glitch - dt * 1.4);
            helm.energy = Math.max(0, helm.energy - dt * 0.35);
            if (st === "granted") helm.dissolve = Math.min(1, helm.dissolve + dt * (helm.bow > 0.45 ? 1.4 : 0));
            else helm.dissolve = Math.max(0, helm.dissolve - dt * 3);

            // Sentinel scan beam: periodic sweep; fast and repeated while checking.
            if (helm.scan >= 0) {
                helm.scan += dt * (st === "checking" ? 2.4 : 0.9);
                if (helm.scan > 1.1) helm.scan = -1;
            } else if (now > helm._nextScan || st === "checking") {
                helm.scan = 0;
                helm._nextScan = now + (c.dormant ? 20000 : 9000) + Math.random() * 5000;
            }
        }
    }

    Image {
        id: atlasImg
        source: Qt.resolvedUrl("assets/ares-atlas.png")
        visible: false
        smooth: false
        mipmap: false
    }

    // Breathing: a very slow swell of the whole figure.
    // Leaning in: up to 5% larger as the subject comes close, slightly smaller as they sit back.
    readonly property real breath: (1 + 0.008 * Math.sin(t * 2 * Math.PI / 5.5)) * (1 + 0.05 * lean)

    // LEDs per source dot along each axis: about 6 screen pixels per LED (2x2 on the 1200 px 4K helm, a 192x192
    // LED field; chosen over 3x3, which read as noise at 4K), never below the original 96x96 grid in small previews.
    readonly property int density: Math.max(1, Math.min(4, Math.round(width / 96 / 6)))

    // Pass 1: smooth high-resolution silhouette of the blended pose, one texel per LED (offscreen only).
    ShaderEffect {
        id: fieldFx
        width: 96 * helm.density
        height: width
        visible: false
        layer.enabled: true
        layer.smooth: true
        layer.textureSize: Qt.size(width, height)
        fragmentShader: Qt.resolvedUrl("shaders/helm-field.frag.qsb")
        readonly property var fr: helm._frames()
        property variant atlas: atlasImg
        property vector4d frames: fr[0]
        property vector4d weights: fr[1]
        property real cols: helm.atlasCols
        property real rows: helm.atlasRows
    }

    // Pass 2: the LEDs and all effects, at full screen resolution.
    ShaderEffect {
        id: fx
        anchors.fill: parent
        blending: false
        fragmentShader: Qt.resolvedUrl("shaders/helm.frag.qsb")
        transform: [
            Scale { origin.x: fx.width / 2; origin.y: fx.height; xScale: helm.breath; yScale: helm.breath },
            Translate { y: helm.pitch * 18 * helm.height / 1000 }
        ]
        property variant field: fieldFx
        property real time: helm.t
        property real energy: helm.energy
        property real alert: helm.alert
        property real check: helm.check
        property real caps: helm.caps
        property real glitch: helm.glitch
        property real ripple: helm.ripple
        property real dissolve: helm.dissolve
        property real dim: helm.dim
        property real scan: helm.scan
        property real lockon: helm.lockOn
        property real minor: 0
        property real density: helm.density
    }
}

##### Connection #####
mpd_host = "localhost"
mpd_port = 6600
mpd_music_dir = "~/Music"

##### UI #####
user_interface = alternative
startup_screen = playlist
display_bitrate = yes

##### Visualizer #####
visualizer_data_source = "/tmp/mpd.fifo"
visualizer_output_name = "cava_fifo"
visualizer_in_stereo = yes
visualizer_type = spectrum

##### Song Format #####
song_columns_list_format = "(6f)[cyan]{NE} (25)[blue]{a} (40)[white]{t|f:Title} (30)[cyan]{b} (7f)[blue]{l} (5f)[white]{br}"
song_status_format = "{$5%a $8- $2%t}|{%f}"
song_list_format = "{$5%a $8- $2%t}|{%f} $R{$3%l}"

##### Colors — Tron Compute #####
colors_enabled = yes
main_window_color = cyan
progressbar_color = cyan:b
progressbar_elapsed_color = blue:b
statusbar_color = white
header_window_color = cyan
volume_color = cyan
state_line_color = cyan
state_flags_color = cyan:b
current_item_prefix = "$(yellow)$r"
current_item_suffix = "$/r$(end)"
current_item_inactive_column_prefix = "$(cyan)"
current_item_inactive_column_suffix = "$(end)"
color1 = cyan
color2 = blue

##### Misc #####
follow_now_playing_lyrics = yes
message_delay_time = 1
playlist_show_remaining_time = yes
playlist_shorten_total_times = yes
media_library_primary_tag = album_artist

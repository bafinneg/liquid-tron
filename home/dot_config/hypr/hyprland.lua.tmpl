-- ── Workspaces ────────────────────────────────────────────────────────
-- FEAT-workspace-split-monitor: no named workspaces, no summon scripts, and no
-- number-key direct jumps. Focus a monitor, then cycle within that monitor's
-- local 1..6 workspace stack.
--
-- FEAT-lt26r-5 OD-F: one direction policy for every local-cycle route. Slot 1 is the top of the stack;
-- "+1" (next, down) always slides the new slot in from below and "-1" from above, including the 6 -> 1 and
-- 1 -> 6 wraps. Hyprland derives slidevert direction from workspace IDs, so only a wrap is flipped
-- (slidevert -100%), and the configured style is restored straight after the dispatch: bar clicks and
-- System Map picks never inherit a reversed slide. The global is also the target of
-- scripts/workspace-cycle-vertical (hyprctl dispatch) for callers outside this config.
LT26R_SLOTS_PER_MONITOR = 6
function LT26R_CYCLE_LOCAL(delta)
    local ws = hl.get_active_workspace()
    local wrap = false
    if ws and ws.id and ws.id > 0 then
        local slot = ((ws.id - 1) % LT26R_SLOTS_PER_MONITOR) + 1
        wrap = (delta == "+1" and slot == LT26R_SLOTS_PER_MONITOR) or (delta == "-1" and slot == 1)
    end
    if wrap then
        LT_MOTION.with_style("workspaces", "slidevert -100%")
    end
    local result = hl.plugin.split_monitor_workspaces.cycle_workspaces(delta)
    if wrap then
        LT_MOTION.leaf("workspaces")
    end
    return result
end
hl.bind(mainMod .. " + bracketleft", function() return LT26R_CYCLE_LOCAL("-1") end, { description = "Workspace: Cycle stack up" })
hl.bind(mainMod .. " + bracketright", function() return LT26R_CYCLE_LOCAL("+1") end, { description = "Workspace: Cycle stack down" })
-- Vertical workspace stack — SUPER+ALT+Up/Down cycles the focused monitor's
-- local 1..6 stack. Workspace 1 is the top of the stack.
hl.bind(mainMod .. " + ALT + up", function() return LT26R_CYCLE_LOCAL("-1") end, { description = "Workspace: Cycle stack up" })
hl.bind(mainMod .. " + ALT + down", function() return LT26R_CYCLE_LOCAL("+1") end, { description = "Workspace: Cycle stack down" })


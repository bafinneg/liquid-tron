-- MX Master 4 gesture targets (logid → /etc/logid.cfg)
-- These binds exist for the thumb gesture button on the MX Master 4.
-- logid emits KEY_PROG1/2/3/4 (evdev 148/149/202/203) for the four
-- directional gestures.
--
-- Using Hyprland's `code:N` syntax rather than keysym names because the
-- current XKB layout doesn't map KEY_PROG1-4 to XF86Launch1-4 keysyms,
-- so bind = , XF86Launch1, ... never fires. code:N bypasses keysym
-- resolution and matches on the raw XKB keycode (evdev + 8).
--
-- Evdev 148 KEY_PROG1 → XKB 156 (Up gesture)
-- Evdev 149 KEY_PROG2 → XKB 157 (Down gesture)
-- Evdev 202 KEY_PROG3 → XKB 210 (Left gesture)
-- Evdev 203 KEY_PROG4 → XKB 211 (Right gesture)
--
-- See machines/7800x/fixes/mx-master-4-logid-solaar-split.md.
-- FEAT-lt26r-5 OD-F: up/down use the shared direction policy (local stack, wrapping, physical slide).
hl.bind("code:156", function() return LT26R_CYCLE_LOCAL("+1") end, { description = "Gesture: Next workspace slot" })
hl.bind("code:157", function() return LT26R_CYCLE_LOCAL("-1") end, { description = "Gesture: Previous workspace slot" })
hl.bind("code:210", hl.dsp.window.move({ workspace = "m-1" }), { description = "Gesture: Move window to previous workspace" })
hl.bind("code:211", hl.dsp.window.move({ workspace = "m+1" }), { description = "Gesture: Move window to next workspace" })

-- ── Macro Keys (M1-M4 → F13-F16) ────────────────────────────────────
-- M1 mirrors Super+| window-mode toggles: plain = per-window, Shift = whole workspace.
hl.bind("XF86Tools", hl.dsp.exec_cmd("~/.config/hypr/scripts/toggle-window-mode.sh"), { description = "Window: Toggle floating mode" })
hl.bind(mainMod .. " + SHIFT + XF86Tools", hl.dsp.exec_cmd("~/.config/hypr/scripts/workspace-float-toggle.sh"), { description = "Window: Toggle floating mode" })
hl.bind("XF86Launch5", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/noctalia-primary-msg panel-toggle launcher"), { description = "Launch: Noctalia app palette" })
hl.bind("XF86Launch6", hl.dsp.workspace.toggle_special("scratch"), { description = "Workspace: Toggle scratchpad" })
hl.bind("XF86Launch7", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/ares-lock"), { description = "Session: Lock screen" })

-- ── Overlay Tools ─────────────────────────────────────────────────────
-- FEAT-lt26r-5 OD-A: native read-only shortcut reference (Noctalia launcher via `noctalia dmenu`; rows never execute).
hl.bind(mainMod .. " + slash", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/shortcut-reference"), { description = "Overlay: Shortcut reference" })
hl.bind(mainMod .. " + A", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/noctalia-primary-msg panel-toggle liquidtron/ares:panel"), { description = "Overlay: Ares presence panel" })
hl.bind(mainMod .. " + SPACE", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/noctalia-primary-msg panel-toggle liquidtron/ares:askchat"), { description = "Overlay: Ask Ares" })
-- FEAT-lt32 C2: push-to-talk. Press opens the chat window listening; release stops the recorder (transcribe + send).
hl.bind(mainMod .. " + SHIFT + SPACE", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/ares-listen ptt-down"), { description = "Overlay: Ask Ares (hold to talk)" })
hl.bind(mainMod .. " + SHIFT + SPACE", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/ares-listen ptt-up"), { release = true, description = "Overlay: Ask Ares (release to send)" })
-- FEAT-lt32 C3 (D10): the release bind above stays silent when SHIFT or SUPER goes up before SPACE (Hyprland matches
-- no release bind once a modifier left). This hook arms on a SPACE press made with SUPER and SHIFT held and sends
-- ptt-up on that SPACE's release in any key order. xkb keycodes = evdev + 8. A second ptt-up is harmless.
local pttMods, pttArmed = {}, false
hl.on("input.keyboard.key", function(keycode, _timeMs, state)
    if keycode == 133 or keycode == 134 or keycode == 50 or keycode == 62 then -- LEFT/RIGHT META, LEFT/RIGHT SHIFT
        pttMods[keycode] = state == 1
    elseif keycode == 65 then -- SPACE
        if state == 1 then -- pressed (2 = repeat: keep the armed state)
            pttArmed = (pttMods[133] or pttMods[134]) and (pttMods[50] or pttMods[62]) or false
        elseif state == 0 and pttArmed then
            pttArmed = false
            hl.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/ares-listen ptt-up")
        end
    end
end)
hl.bind(mainMod .. " + SHIFT + A", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/noctalia-primary-msg panel-toggle liquidtron/ares:brief replay"), { description = "Overlay: Return Brief replay" })

-- ── Scratchpad / Special Workspaces ──────────────────────────────────
hl.bind(mainMod .. " + grave", hl.dsp.workspace.toggle_special("scratch"), { description = "Workspace: Toggle scratchpad" })
hl.bind(mainMod .. " + SHIFT + grave", hl.dsp.window.move({ workspace = "special:scratch" }), { description = "Workspace: Move to scratchpad" })
-- SUPER+U — dashboard deck (wtfutil). Mirrors the scratch special-workspace
-- pattern; deck summons on whichever monitor has focus.
hl.bind(mainMod .. " + U", hl.dsp.workspace.toggle_special("deck"), { description = "Workspace: Toggle dashboard deck" })

-- ── Monitor Focus ─────────────────────────────────────────────────────
hl.bind(mainMod .. " + comma", hl.dsp.focus({ monitor = "l" }), { description = "Monitor: Focus left" })
hl.bind(mainMod .. " + period", hl.dsp.focus({ monitor = "r" }), { description = "Monitor: Focus right" })
hl.bind(mainMod .. " + SHIFT + comma", hl.dsp.window.move({ monitor = "l" }), { description = "Monitor: Move window left" })
hl.bind(mainMod .. " + SHIFT + period", hl.dsp.window.move({ monitor = "r" }), { description = "Monitor: Move window right" })

-- ── Tabbed/Grouped Windows ───────────────────────────────────────────
hl.bind(mainMod .. " + G", hl.dsp.group.toggle(), { description = "Group: Toggle group" })
-- SUPER+SHIFT+G — system-mode toggle (intelligent ↔ gaming).  The `p` flag
-- bypasses a game's shortcut-inhibition request, making this an escape hotkey
-- from gaming mode.  Use explicit desktop paths so the canonical state file is
-- never redirected by a caller's XDG_STATE_HOME or PATH.
-- SUPER+G is taken by togglegroup; the SHIFT variant is free.
hl.bind(mainMod .. " + SHIFT + G", hl.dsp.exec_cmd("env HOME={{ .chezmoi.homeDir }} XDG_STATE_HOME={{ .chezmoi.homeDir }}/.local/state {{ .chezmoi.homeDir }}/.local/bin/system-mode-toggle"), { dont_inhibit = true, description = "Session: System mode toggle" })
-- Group cycling lives on SUPER+CTRL+TAB — SUPER+TAB is the Quickshell
-- workspace overview toggle (see overview-tools-binds.conf).
hl.bind(mainMod .. " + CTRL + TAB", hl.dsp.group.next(), { description = "Group: Cycle active" })
hl.bind(mainMod .. " + CTRL + SHIFT + TAB", hl.dsp.group.prev(), { description = "Group: Cycle active backward" })
-- FEAT-lt26r-5 OD-B: ALT+Tab — Noctalia's live-window carousel (hold Alt, Tab/Shift+Tab to move, release to switch,
-- quick tap = previous window, Escape cancels; the chosen window is pulled to the focused monitor). Distinct from SUPER+Tab (System Map) and SUPER+CTRL+Tab (groups).
hl.bind("ALT + Tab", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/noctalia-switcher-hold"), { description = "Window: Switcher carousel" })

-- ── Mouse ─────────────────────────────────────────────────────────────
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(), { description = "Mouse: Drag window" })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { description = "Mouse: Resize window" })
hl.bind(mainMod .. " + mouse:275", hl.dsp.window.move({ monitor = "l" }), { description = "Move: Window to left monitor" }) -- Meta + Mouse Back  → send to left monitor
hl.bind(mainMod .. " + mouse:276", hl.dsp.window.move({ monitor = "r" }), { description = "Move: Window to right monitor" }) -- Meta + Mouse Forward → send to right monitor

-- ── Screenshots ───────────────────────────────────────────────────────
-- Print family — image bytes on clipboard (paste into Claude CLI, Discord, GIMP)
hl.bind(mainMod .. " + Print", hl.dsp.exec_cmd("sh -c 'f=~/Pictures/Screenshots/shot-$(date +%Y%m%d-%H%M%S).png; g=$(slurp) && grim -g \"$g\" \"$f\" && wl-copy -t image/png < \"$f\" && notify-send -u low -i camera-photo \"Screenshot\" \"$f\"'"), { description = "Capture: Region to clipboard" })
hl.bind("Print", hl.dsp.exec_cmd("sh -c 'f=~/Pictures/Screenshots/shot-$(date +%Y%m%d-%H%M%S).png; grim \"$f\" && wl-copy -t image/png < \"$f\" && notify-send -u low -i camera-photo \"Screenshot\" \"$f\"'"), { description = "Capture: Screen to clipboard" })
-- SHIFT variants — file URI on clipboard (paste into Thunar, terminal, file dialogs)
hl.bind("SHIFT + Print", hl.dsp.exec_cmd("sh -c 'f=~/Pictures/Screenshots/shot-$(date +%Y%m%d-%H%M%S).png; g=$(slurp) && grim -g \"$g\" \"$f\" && printf \"file://%s\" \"$f\" | wl-copy -t text/uri-list && notify-send -u low -i camera-photo \"Screenshot\" \"$f\"'"), { description = "Capture: Region as file link" })
hl.bind(mainMod .. " + SHIFT + Print", hl.dsp.exec_cmd("sh -c 'f=~/Pictures/Screenshots/shot-$(date +%Y%m%d-%H%M%S).png; grim \"$f\" && printf \"file://%s\" \"$f\" | wl-copy -t text/uri-list && notify-send -u low -i camera-photo \"Screenshot\" \"$f\"'"), { description = "Capture: Screen as file link" })
-- SUPER+CTRL+Print — region capture → satty annotate. Ctrl+C in satty copies the annotated image; Ctrl+S saves to the output file.
hl.bind(mainMod .. " + CTRL + Print", hl.dsp.exec_cmd("sh -c 'g=$(slurp) && grim -g \"$g\" - | satty --filename - --output-filename ~/Pictures/Screenshots/annotated-$(date +%Y%m%d-%H%M%S).png --early-exit --copy-command wl-copy'"), { description = "Capture: Region annotate satty" })


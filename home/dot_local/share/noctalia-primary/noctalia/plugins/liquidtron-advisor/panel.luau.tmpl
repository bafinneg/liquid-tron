-- ARES signals panel: what the advisor is showing on the centre meter, and the last 20 it resolved.
--
-- While open it reads `ares-signal-act list` every 2 s (second ticks stop when the panel closes, so nothing runs at
-- idle). OPEN and DISMISS call ares-signal-act, which runs one allowlisted read-only action (or records the dismissal)
-- and never restarts, stops or edits anything. Journal and task advisories are read here, not in a terminal: the
-- panel opens on that advisory (context = signal id, from a meter click or OPEN) and shows `ares-signal-act <id>
-- detail`, the unit's recent journal lines or the task's status; reading it records `read`, which clears the meter's
-- amber follow-up tint. Esc and a click anywhere else close it (Noctalia's attached-panel
-- behaviour). Labels inherit the shell font; only size is set. Colours are palette roles only:
--   tertiary (amber) = needs you, error = critical, primary = advisory / nominal, secondary = done.

local ACT = "{{ .chezmoi.homeDir }}/.local/bin/ares-signal-act"
local REFRESH_EVERY_S = 2
local W_AGE = 70
local W_BTN = 96

local DIM = "on_surface_variant"
local SEVERITY = { [1] = "tertiary", [2] = "error", [3] = "primary", [4] = "secondary" }

local COPIED_FOR_S = 2 -- the COPY button reads COPIED for this many second ticks

local isOpen = false
local focus = nil -- signal id shown in detail view; nil = list
local detail = nil
local detailMsg = ""
local gen = 0 -- bumped on every open/close; stale async results are dropped
local loading = false
local ticks = 0
local data = nil
local hovered = nil
local message = ""

local function clip(s, n)
  s = string.gsub(s or "", "%s+", " ")
  local len = utf8.len(s)
  if len == nil then
    return string.sub(s, 1, n)
  end
  if len <= n then
    return s
  end
  return string.sub(s, 1, utf8.offset(s, n) - 1) .. "…"
end

-- Mirrors the allowlist in ares-signal-act: OPEN is shown only for an action hint it will run.
local function openable(action)
  action = action or ""
  if action == "panel:liquidtron/cpu:detail" or action == "panel:control-center network" then
    return true
  end
  local scope, unit = string.match(action, "^journal:(%a+):([%w@._:%-]+)$")
  if scope == "system" or scope == "user" then
    return string.match(unit, "%.service$") ~= nil or string.match(unit, "%.timer$") ~= nil
      or string.match(unit, "%.socket$") ~= nil or string.match(unit, "%.mount$") ~= nil
  end
  if string.match(action, "^open:hermes:%w[%w_.%-]*$") or string.match(action, "^open:task:[%w_][%w_.%-]*$") then
    return true
  end
  return string.match(action, "^open:claude:%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") ~= nil
end

-- Advisories whose detail renders inside this panel (the rest open their own surface and close the panel).
local function isSummon(action)
  action = action or ""
  return string.match(action, "^open:hermes:") ~= nil or string.match(action, "^open:claude:") ~= nil
end

-- everything except an approval opens its plain-language brief here
local function inPanel(action)
  return not isSummon(action)
end

local function lineColor(p)
  if type(p) ~= "number" then
    return DIM
  elseif p <= 3 then
    return "error"
  elseif p == 4 then
    return "tertiary"
  end
  return "on_surface"
end

local function ageText(fromMs, nowMs)
  if type(fromMs) ~= "number" or type(nowMs) ~= "number" then
    return ""
  end
  local s = math.max(0, math.floor((nowMs - fromMs) / 1000))
  if s < 60 then
    return tostring(s) .. "S"
  elseif s < 3600 then
    return tostring(math.floor(s / 60)) .. "M"
  elseif s < 86400 then
    return tostring(math.floor(s / 3600)) .. "H"
  end
  return tostring(math.floor(s / 86400)) .. "D"
end

local render -- forward

local function refresh()
  if loading then
    return
  end
  loading = true
  local myGen = gen
  noctalia.runAsync({ ACT, "list" }, function(result)
    loading = false
    if myGen ~= gen or result.exitCode ~= 0 then
      return
    end
    local ok, d = pcall(noctalia.json.decode, result.stdout or "")
    if ok and type(d) == "table" then
      data = d
      render()
    end
  end)
end

local function loadDetail(id)
  local myGen = gen
  noctalia.runAsync({ ACT, id, "detail" }, function(result)
    if myGen ~= gen or focus ~= id then
      return
    end
    if result.exitCode ~= 0 then
      detail = nil
      detailMsg = "All clear. This has already resolved."
      render()
      return
    end
    local ok, d = pcall(noctalia.json.decode, result.stdout or "")
    if ok and type(d) == "table" then
      detail = d
      detailMsg = ""
      render()
      noctalia.runAsync({ ACT, id, "read" }) -- reading it here is the follow-up: the meter's amber tint clears
    end
  end)
end

local function showDetail(id)
  focus = id
  detail = nil
  detailMsg = ""
  hovered = nil
  render()
  loadDetail(id)
end

local function act(sig, verb, action, id)
  if verb == "open" and inPanel(action) then
    showDetail(id or sig)
    return
  end
  local myGen = gen
  noctalia.runAsync({ ACT, sig, verb }, function(result)
    if myGen ~= gen then
      return
    end
    if result.exitCode ~= 0 then
      message = "Not done: " .. verb .. " " .. clip(sig, 30)
      render()
      return
    end
    if verb == "open" or verb == "go" then
      panel.close()
    else
      message = ""
      if focus ~= nil then
        focus = nil
        detail = nil
      end
      refresh()
    end
  end)
end

local function onRowHover(state, key)
  local next = (state == "true") and key or nil
  if next ~= hovered then
    hovered = next
    render()
  end
end

local function activeRow(s, nowMs)
  local k = "a-" .. tostring(s.sig)
  local color = SEVERITY[s.priority] or "primary"
  return ui.row({
    key = k,
    gap = 12,
    align = "center",
    paddingH = 10,
    paddingV = 4,
    radius = 8,
    fill = hovered == k and "surface_variant/0.5" or nil,
    onHover = onRowHover,
  }, {
    ui.glyph({ name = s.glyph or "info-circle", size = 16, color = color }),
    ui.label({ text = s.text or "", fontSize = 14, fontWeight = "semibold", color = "on_surface",
      maxLines = 1, autoScroll = true, flexGrow = 1 }),
    ui.column({ width = W_AGE, align = "end" }, {
      ui.label({ text = ageText(s.opened_ms, nowMs), fontSize = 12, color = DIM }),
    }),
    ui.button({ key = "open-" .. k, text = isSummon(s.action) and "OPEN" or "VIEW", variant = "outline", controlSize = "sm",
      width = W_BTN, visible = openable(s.action), onClick = function() act(s.sig, "open", s.action, s.id) end }),
    ui.button({ key = "dismiss-" .. k, text = "DISMISS", variant = "ghost", controlSize = "sm", width = W_BTN,
      onClick = function() act(s.sig, "dismiss") end }),
  })
end

local function recentRow(s, nowMs)
  return ui.row({ key = "r-" .. tostring(s.sig) .. "-" .. tostring(s.resolved_ms), gap = 12, align = "center",
    paddingH = 10, paddingV = 2 }, {
    ui.box({ width = 8, height = 8, radius = 4, fill = "on_surface_variant/0.5" }),
    ui.label({ text = s.text or "", fontSize = 13, color = DIM, maxLines = 1, autoScroll = true, flexGrow = 1 }),
    ui.column({ width = W_AGE, align = "end" }, {
      ui.label({ text = ageText(s.resolved_ms, nowMs) .. " AGO", fontSize = 12, color = DIM }),
    }),
  })
end

local showTech = false
local copiedTicks = 0
local copiedWhat = nil -- "code" or "prompt": which COPY button reads COPIED

local function urgencyMeter(level, tone)
  local segs = {}
  for i = 1, 3 do
    table.insert(segs, ui.box({ key = "u" .. i, width = 18, height = 4, radius = 2,
      fill = i <= level and tone or "on_surface_variant/0.25" }))
  end
  return ui.row({ key = "umeter", gap = 3, align = "center" }, segs)
end

local function chip(key, k, v, tone)
  return ui.row({ key = key, gap = 6, align = "center", paddingH = 10, paddingV = 4, radius = 12,
    fill = (tone or "primary") .. "/0.12", border = (tone or "primary") .. "/0.35", borderWidth = 1 }, {
    ui.label({ text = k, fontSize = 11, color = DIM }),
    ui.label({ text = v, fontSize = 12, fontWeight = "bold", color = tone or "on_surface" }),
  })
end

local function point(key, glyph, tone, head, body, strong)
  return ui.row({ key = key, gap = 12, align = "start" }, {
    ui.box({ width = 3, height = 34, radius = 2, fill = tone }),
    ui.column({ gap = 2, flexGrow = 1 }, {
      ui.row({ gap = 6, align = "center" }, {
        ui.glyph({ name = glyph, size = 13, color = tone }),
        ui.label({ text = head, fontSize = 11, fontWeight = "bold", color = tone }),
      }),
      ui.label({ text = body, fontSize = strong and 15 or 14, fontWeight = strong and "semibold" or "normal",
        color = "on_surface", maxLines = 3 }),
    }),
  })
end

-- The paste-ready text: ares-signal-act's `code` rows (comment lines plus read-only commands), one per line.
local function codeText(d)
  local out = {}
  for _, r in ipairs(d.code or {}) do
    table.insert(out, r.s or "")
  end
  return table.concat(out, "\n")
end

local function copyCode(d)
  local text = codeText(d)
  if text ~= "" and noctalia.copyToClipboard(text .. "\n", "text/plain") then
    copiedTicks = COPIED_FOR_S
    copiedWhat = "code"
  end
  render()
end

-- The exact prompt to paste into Hermes (ares-signal-act's brief.prompt), copied with no trailing newline so a
-- paste into a Conversation composer does not send it before it can be read.
local function copyPrompt(text)
  if text ~= "" and noctalia.copyToClipboard(text, "text/plain") then
    copiedTicks = COPIED_FOR_S
    copiedWhat = "prompt"
  end
  render()
end

-- ASK HERMES as a code block: the prompt in the shell font on a dark well, with its own COPY button.
-- What it shows is exactly what COPY puts on the clipboard.
local function promptBlock(text, tone)
  local copied = copiedTicks > 0 and copiedWhat == "prompt"
  return ui.column({ key = "pblock", gap = 6, padding = 12, radius = 10, fill = "surface/0.85",
    border = tone .. "/0.45", borderWidth = 1 }, {
    ui.row({ key = "phead", gap = 8, align = "center" }, {
      ui.glyph({ name = "message-chatbot", size = 13, color = tone }),
      ui.label({ text = "ASK HERMES · PROMPT", fontSize = 11, fontWeight = "bold", color = tone, flexGrow = 1 }),
      ui.button({ key = "pcopy", text = copied and "COPIED" or "COPY", glyph = copied and "copy-check" or "copy",
        variant = "outline", controlSize = "sm", width = W_BTN, onClick = function() copyPrompt(text) end }),
    }),
    ui.label({ key = "ptext", text = text, fontSize = 12, color = "on_surface", maxLines = 12 }),
  })
end

-- TECHNICAL DETAILS as a code block: the shell font (monospace) on a dark well, with a COPY button in its header.
-- What it shows is exactly what COPY puts on the clipboard.
local function codeBlock(d)
  local copied = copiedTicks > 0 and copiedWhat == "code"
  local rows = {
    ui.row({ key = "chead", gap = 8, align = "center" }, {
      ui.glyph({ name = "terminal-2", size = 13, color = DIM }),
      ui.label({ text = d.source or "", fontSize = 11, color = DIM, maxLines = 1, flexGrow = 1 }),
      ui.button({ key = "copy", text = copied and "COPIED" or "COPY", glyph = copied and "copy-check" or "copy",
        variant = "outline", controlSize = "sm", width = W_BTN, visible = #(d.code or {}) > 0,
        onClick = function() copyCode(d) end }),
    }),
  }
  for i, r in ipairs(d.code or {}) do
    local color = r.cmd and "primary" or (r.p ~= nil and lineColor(r.p) or DIM)
    table.insert(rows, ui.label({ key = "c" .. i, text = r.s or "", fontSize = 11, color = color, maxLines = 3,
      fontWeight = r.cmd and "semibold" or nil }))
  end
  return ui.column({ key = "dlines", gap = 3, padding = 12, radius = 10, fill = "surface/0.85",
    border = "outline/0.5", borderWidth = 1 }, rows)
end

local function renderDetail(nowMs)
  local d = detail or {}
  local b = d.brief or {}
  local tone = b.tone or SEVERITY[d.priority] or "primary"
  local children = {
    ui.row({ key = "dhead", gap = 10, align = "center" }, {
      ui.button({ key = "back", glyph = "chevron-left", variant = "ghost", controlSize = "sm",
        onClick = function() focus = nil; detail = nil; hovered = nil; showTech = false; copiedTicks = 0; copiedWhat = nil; render(); refresh() end }),
      urgencyMeter(b.level or 0, tone),
      ui.label({ text = b.urgency or "", fontSize = 12, fontWeight = "bold", color = tone, flexGrow = 1 }),
      ui.label({ text = ageText(d.opened_ms, nowMs), fontSize = 12, color = DIM }),
    }),
  }
  if detailMsg ~= "" then
    table.insert(children, ui.column({ key = "dmsg", paddingV = 18, align = "center", gap = 8 }, {
      ui.glyph({ name = "circle-check", size = 34, color = "secondary" }),
      ui.label({ text = detailMsg, fontSize = 15, color = "on_surface" }),
    }))
    return children
  elseif detail == nil then
    table.insert(children, ui.label({ key = "dload", text = "…", fontSize = 13, color = DIM }))
    return children
  end
  -- hero: one glyph in a tinted disc, one sentence
  table.insert(children, ui.row({ key = "hero", gap = 16, align = "center", paddingV = 6 }, {
    ui.column({ width = 56, height = 56, radius = 28, fill = tone .. "/0.14", border = tone .. "/0.55",
      borderWidth = 1, align = "center", justify = "center" }, {
      ui.glyph({ name = b.glyph or "info-circle", size = 28, color = tone }),
    }),
    ui.label({ text = b.what or (d.text or ""), fontSize = 19, fontWeight = "bold", color = "on_surface",
      maxLines = 3, flexGrow = 1 }),
  }))
  if b.facts and #b.facts > 0 then
    local chips = {}
    for i, f in ipairs(b.facts) do
      table.insert(chips, chip("f" .. i, f.k or "", f.v or "", f.tone or tone))
    end
    table.insert(children, ui.row({ key = "facts", gap = 8, align = "center" }, chips))
  end
  local points = {}
  if (b.impact or "") ~= "" then
    table.insert(points, point("impact", "alert-triangle", "on_surface_variant", "WHAT THIS MEANS", b.impact))
  end
  if (b.next or "") ~= "" then
    table.insert(points, point("next", "chevron-right", tone, "WHAT TO DO", b.next, true))
  end
  table.insert(children, ui.column({ key = "points", gap = 12, paddingV = 4 }, points))
  if (b.prompt or "") ~= "" then
    table.insert(children, promptBlock(b.prompt, tone))
  end
  -- technical lines stay available, folded away
  if #(d.lines or {}) > 0 then
    table.insert(children, ui.button({ key = "tech", text = showTech and "HIDE DETAILS" or "TECHNICAL DETAILS",
      glyph = showTech and "chevron-up" or "chevron-down", variant = "ghost", controlSize = "sm", contentAlign = "start",
      onClick = function() showTech = not showTech; render() end }))
    if showTech then
      table.insert(children, codeBlock(d))
    end
  end
  return children
end

render = function()
  if not isOpen then
    return
  end
  if focus ~= nil then
    local nowMs = data and data.now_ms or nil
    local d = detail or {}
    local b = d.brief or {}
    local tone = b.tone or SEVERITY[d.priority] or "primary"
    panel.render(ui.column({ padding = 18, gap = 10, flexGrow = 1 }, {
      ui.scroll({ key = "dbody", gap = 12, flexGrow = 1 }, renderDetail(nowMs)),
      ui.separator({ key = "sep2" }),
      ui.row({ key = "dfoot", gap = 10, align = "center" }, {
        ui.spacer({ flexGrow = 1 }),
        ui.button({ key = "ddismiss", text = "GOT IT", variant = "ghost", controlSize = "sm", width = W_BTN,
          visible = d.sig ~= nil, onClick = function() act(d.sig, "dismiss") end }),
        ui.button({ key = "dgo", text = b.button or "", glyph = "chevron-right", variant = "primary", controlSize = "sm",
          visible = d.sig ~= nil and (b.button or "") ~= "", onClick = function() act(d.sig, "go") end }),
      }),
    }))
    return
  end
  local nowMs = data and data.now_ms or nil
  local active = data and data.active or {}
  local resolved = data and data.resolved or {}
  local children = {
    ui.row({ key = "head", gap = 12, align = "center" }, {
      ui.glyph({ name = "activity", size = 20, color = "primary" }),
      ui.label({ text = "ARES // SIGNALS", fontSize = 16, fontWeight = "bold", color = "primary", flexGrow = 1 }),
      ui.label({ text = (data and #(data.active or {}) > 0) and (tostring(#data.active) .. " NEED A LOOK") or "",
        fontSize = 12, fontWeight = "bold", color = "tertiary" }),
    }),
    ui.separator({ key = "sep1" }),
  }
  if data ~= nil and #active == 0 then
    table.insert(children, ui.column({ key = "nominal", paddingV = 14, align = "center" }, {
      ui.label({ text = "ALL CLEAR", fontSize = 18, fontWeight = "bold", color = "primary" }),
    }))
  else
    local rows = {}
    for _, s in ipairs(active) do
      table.insert(rows, activeRow(s, nowMs))
    end
    table.insert(children, ui.column({ key = "active", gap = 2 }, rows))
  end
  if #resolved > 0 then
    table.insert(children, ui.label({ key = "recent-h", text = "RECENT", fontSize = 12, color = DIM }))
    local rows = {}
    for _, s in ipairs(resolved) do
      table.insert(rows, recentRow(s, nowMs))
    end
    table.insert(children, ui.column({ key = "recent", gap = 0 }, rows))
  end
  local foot = "…"
  if data ~= nil then
    foot = string.format("BASELINE %d SAMPLES · MODEL %s", data.baseline_n or 0, string.upper(tostring(data.model or "?")))
  end
  panel.render(ui.column({ padding = 18, gap = 10, flexGrow = 1 }, {
    ui.scroll({ key = "body", gap = 8, flexGrow = 1 }, children),
    ui.separator({ key = "sep2" }),
    ui.row({ key = "foot", gap = 12, align = "center" }, {
      ui.label({ text = message ~= "" and message or foot, fontSize = 12, color = message ~= "" and "error" or DIM,
        maxLines = 1, flexGrow = 1 }),
    }),
  }))
end

function onOpen(context)
  gen += 1
  isOpen = true
  data = nil
  hovered = nil
  message = ""
  loading = false
  ticks = 0
  focus = nil
  detail = nil
  detailMsg = ""
  showTech = false
  copiedTicks = 0
  copiedWhat = nil
  panel.setWantsSecondTicks(true)
  -- context = a signal id when the meter (or OPEN) asks for one advisory; same id rule as the meter
  if type(context) == "string" and string.match(context, "^[%w][%w._:@%-]*$") and #context <= 64 then
    focus = context
    render()
    refresh()
    loadDetail(context)
    return
  end
  render()
  refresh()
end

function onClose()
  gen += 1
  isOpen = false
  loading = false
  panel.setWantsSecondTicks(false)
end

function update()
  if not isOpen then
    return
  end
  ticks += 1
  if copiedTicks > 0 then
    copiedTicks -= 1
    if copiedTicks == 0 then
      render()
    end
  end
  if ticks >= REFRESH_EVERY_S then
    ticks = 0
    refresh() -- the detail view keeps its snapshot; only the list (and the age clock) refreshes
  end
end

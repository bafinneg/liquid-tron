  return 2 + math.floor(3 * (it.frac or 0) + 0.5)
end

-- Orthogonal connector cell left of one child: a lead from the parent (first child only), the shared trunk (from the
-- top unless first, down to the bottom unless last) and a stub into the child, at the child node's mid-height.
-- Every segment is a fixed-size box, so the drawing does not depend on flex sizing.
local function link(key, first, last, height, color, thick)
  local top = math.floor(NODE_H / 2 - thick / 2)
  local stubW = W_LINK - LINK_LEAD - TRUNK_W
  local below = height - top - thick
  return ui.row({ key = key, width = W_LINK, height = height, gap = 0, align = "start" }, {
    ui.column({ width = LINK_LEAD, gap = 0 }, {
      seg(LINK_LEAD, top, CLEAR),
      seg(LINK_LEAD, thick, first and color or CLEAR),
    }),
    ui.column({ width = TRUNK_W, gap = 0 }, {
      seg(TRUNK_W, top, first and CLEAR or LINE_TRUNK),
      seg(TRUNK_W, thick, color),
      seg(TRUNK_W, below, last and CLEAR or LINE_TRUNK),
    }),
    ui.column({ width = stubW, gap = 0 }, {
      seg(stubW, top, CLEAR),
      seg(stubW, thick, color),
    }),
  })
end

local function diagramNode(it, width)
  local key = "d" .. it.key
  local selected = tab == "overview" and it.go ~= nil and (selKey == it.key or diagramActions[diagIdx] == it.key)
  local isRepo = it.kind == "repo"
  local textW = width - (isRepo and 112 or 130)
  local right
  if isRepo then
    right = ui.column({ width = 52, align = "end" }, {
      ui.label({ text = fmt(it.tokens), fontSize = 13, color = "on_surface" }),
      ui.label({ text = "today", fontSize = 11.5, color = DIM }),
    })
  elseif it.badge ~= nil then
    right = ui.column({ width = 64, align = "end" }, { ui.label({ text = it.badge, fontSize = 12, color = DIM }) })
  else
    right = ui.column({ width = 64, gap = 5, align = "end" }, {
      ui.label({ text = fmt(it.tokens), fontSize = 13, color = "on_surface" }),
      ui.progress({ progress = math.max(0.03, it.frac or 0), width = 56, height = 3, radius = 1.5,
        fill = it.kind == "sub" and BLUE or "primary", track = "on_surface/0.08" }),
    })
  end
  local props = { key = key, width = width, height = NODE_H, gap = 10, align = "center", paddingH = 12, radius = 10,
    fill = isRepo and REPO_FILL or NODE_FILL, border = edge(key, selected, it.live), borderWidth = 1,
    onHover = onRowHover }
  if it.go ~= nil then
    local key0 = it.key
    props.onClick = function()
      selectKey(key0)
    end
    props.tooltip = "Show its latest state"
  end
  return ui.row(props, {
    ui.glyph({ name = KIND_GLYPH[it.kind] or "point", size = isRepo and 18 or 16,
      color = it.live and GREEN or (KIND_COLOR[it.kind] or "primary") }),
    ui.column({ gap = 2, flexGrow = 1 }, {
      ui.label({ text = clip(it.title, math.floor(textW / (isRepo and 7.6 or 8))), fontSize = isRepo and 15 or 14, fontWeight = "semibold",
        color = isRepo and "primary" or "on_surface", maxLines = 1, maxWidth = textW }),
      ui.label({ text = clip(it.sub or "", math.floor(textW / (isRepo and 7.4 or 7.8))), fontSize = 12, color = DIM, maxLines = 1,
        maxWidth = textW }),
    }),
    right,
  })
end


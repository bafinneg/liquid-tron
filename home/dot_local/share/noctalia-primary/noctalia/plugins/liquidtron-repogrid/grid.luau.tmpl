      setTab("details")
    end }, {
    ui.glyph({ name = "dots", size = 14, color = DIM }),
    ui.label({ text = "+" .. tostring(n) .. " more " .. what .. " · DETAILS", fontSize = 12.5, color = DIM, maxLines = 1,
      maxWidth = width - 50 }),
  })
end

-- Rows a top node's block occupies: its kids (and their "+N" line), at least one.
local function blockRows(dt)
  local n = #dt.kids
  if dt.more > 0 then
    n += 1
  end
  return math.max(1, n)
end

local function kidColumn(dt)
  local rows = {}
  local count = #dt.kids + (dt.more > 0 and 1 or 0)
  for i, kid in ipairs(dt.kids) do
    table.insert(rows, ui.row({ key = "kr:" .. kid.key, height = PITCH, gap = 0, align = "start" }, {
      link("kl:" .. kid.key, i == 1, i == count, PITCH, lineColor(kid), lineThickness(kid)),
      diagramNode(kid, W_KID_NODE),
    }))
  end
  if dt.more > 0 then
    local mk = "km:" .. dt.item.key
    table.insert(rows, ui.row({ key = mk .. "-r", height = PITCH, gap = 0, align = "start" }, {
      link(mk .. "-l", count == 1, true, PITCH, LINE_TRUNK, 2),
      moreNode(mk, W_KID_NODE, dt.more, "under it"),
    }))
  end
  return ui.column({ key = "kc:" .. dt.item.key, gap = 0 }, rows)
end

-- Collapse chevron at the left of a repo block: a square button centred on the repo pill, DIM glyph, a border only
-- while the pointer is over it, and CHEV_GAP of clear space so its hover frame never touches the pill (owner round 8).
local function chevronCell(dg)
  local key = "ch:" .. dg.head.key
  local hk = dg.head.key
  return ui.row({ key = "chw:" .. dg.head.key, width = W_CHEV, height = NODE_H, gap = 0, align = "center",
    justify = "center" }, {
    ui.row({ key = key, width = W_CHEV, height = W_CHEV, gap = 0, align = "center", justify = "center", radius = 8,
      fill = CLEAR, border = rowEdge(key, false), borderWidth = 1, onHover = onRowHover,
      tooltip = dg.collapsed and "Show this repo's Conversations" or "Collapse this repo", onClick = function()
        toggleRepo(hk)
      end }, {
      ui.glyph({ name = dg.collapsed and "chevron-right" or "chevron-down", size = 16, color = DIM }),
    }),
  })
end

-- Collapsed repo: one node-height line to the right of the repo node; clicking it expands. It spans the whole width
-- the expanded block would use (owner round 8: at 360 px the counts overflowed the pill), so the worst case
-- "999 Conversations · 99 live · 999 subagents / jobs · 999.9M today" (about 545 px at 13 px mono) fits inside.
local W_COLLAPSED_LINE = W_LINK + W_CONV_NODE + W_LINK + W_KID_NODE - 12
local function collapsedLine(dg)
  local key = "cs:" .. dg.head.key
  local hk = dg.head.key
  local s0 = dg.sum
  local w = W_COLLAPSED_LINE
  local parts = {
    ui.label({ text = tostring(s0.convs) .. (s0.convs == 1 and " Conversation" or " Conversations"), fontSize = 13,
      color = "on_surface", maxLines = 1 }),
  }
  local function add(text, color)
    table.insert(parts, ui.label({ text = "·", fontSize = 13, color = DIM }))
    table.insert(parts, ui.label({ text = text, fontSize = 13, color = color, maxLines = 1 }))
  end
  add(tostring(s0.live) .. " live", s0.live > 0 and GREEN or DIM)
  add(tostring(s0.subs) .. " subagents / jobs", "on_surface")
  add(fmt(dg.head.tokens) .. " today", "on_surface")
  return ui.row({ key = key, width = w, height = NODE_H, gap = 8, align = "center", paddingH = 14, radius = 10, fill = CLEAR,
    border = hovered == key and EDGE_HOVER or WELL, borderWidth = 1, onHover = onRowHover,
    tooltip = "Show this repo's Conversations", onClick = function()
      toggleRepo(hk)
    end }, parts)
end

local function groupBlock(dg)
  local head = ui.row({ key = "gh:" .. dg.head.key, gap = CHEV_GAP, align = "start" }, {
    chevronCell(dg),
    diagramNode(dg.head, W_REPO_NODE),
  })
  if dg.collapsed then
    local line = collapsedLine(dg)
    return ui.row({ key = "g:" .. dg.head.key, gap = 12, align = "start" }, { head, line })
  end
  local rows = {}
  local count = #dg.tops + (dg.more > 0 and 1 or 0)
  for i, dt in ipairs(dg.tops) do
    local h = blockRows(dt) * PITCH
    local cells = {
      link("tl:" .. dt.item.key, i == 1, i == count, h, lineColor(dt.item), lineThickness(dt.item)),
      diagramNode(dt.item, W_CONV_NODE),
    }
    if #dt.kids > 0 or dt.more > 0 then
      table.insert(cells, kidColumn(dt))
    end
    table.insert(rows, ui.row({ key = "tr:" .. dt.item.key, height = h, gap = 0, align = "start" }, cells))
  end
  if dg.more > 0 then
    local mk = "gm:" .. dg.head.key
    table.insert(rows, ui.row({ key = mk .. "-r", height = PITCH, gap = 0, align = "start" }, {
      link(mk .. "-l", count == 1, true, PITCH, LINE_TRUNK, 2),
      moreNode(mk, W_CONV_NODE, dg.more, "Conversations"),
    }))
  end
  return ui.row({ key = "g:" .. dg.head.key, gap = 0, align = "start" }, {
    head,
    ui.column({ key = "gc:" .. dg.head.key, gap = 0 }, rows),
  })
end

local function legendSwatch(color, thick, text)
  return ui.row({ gap = 6, align = "center" }, {
    seg(22, thick, color),
    ui.label({ text = text, fontSize = 12, color = DIM }),
  })
end

-- ------------------------------------------------------------------ view: STATE pane (right rail)
-- Greedy word wrap to `n` characters; blank lines are kept as paragraph gaps.
local function wrapText(text, n)
  local out = {}
  for line in string.gmatch(text .. "\n", "(.-)\n") do
    local lead = string.match(line, "^( *)") or ""
    local body = string.sub(line, #lead + 1)
    if body == "" then
      table.insert(out, "")
    else
      local cur = ""
      for word in string.gmatch(body, "%S+") do
        if cur == "" then
          cur = word
        elseif #lead + #cur + 1 + #word <= n then
          cur = cur .. " " .. word
        else
          table.insert(out, lead .. cur)
          cur = word
        end
        while #lead + #cur > n and #cur > 8 do
          table.insert(out, lead .. string.sub(cur, 1, n - #lead))
          cur = string.sub(cur, n - #lead + 1)
        end
      end
      if cur ~= "" then
        table.insert(out, lead .. cur)
      end
    end
  end
  return out
end

-- One wrapped body line; leading spaces become a fixed indent box (ui.spacer is a flex filler).
local function bodyLine(key, text)
  local lead = #(string.match(text, "^( *)") or "")
  local label = ui.label({ text = string.sub(text, lead + 1), fontSize = 13, color = "on_surface", maxLines = 1,
    maxWidth = 470 - lead * INDENT_PX, flexGrow = 1 })
  if lead == 0 then
    return ui.row({ key = key }, { label })
  end
  return ui.row({ key = key }, { ui.box({ width = lead * INDENT_PX, height = 1, opacity = 0 }), label })
end

local function stateHeader(info, d)
  local title = d ~= nil and d.title or (info ~= nil and info.title or selKey)
  local kind = d ~= nil and d.kind or (info ~= nil and info.kind or "repo")
  local tone = d ~= nil and d.status_tone or "idle"
  local status = d ~= nil and d.status or "Loading…"
  local target = goTarget()
  local tip = target ~= nil and (GO_TIP[target.kind] or "Open") or "Nothing to open"
  local row = {
    ui.glyph({ name = KIND_GLYPH[kind] or "point", size = 20, color = KIND_COLOR[kind] or "primary" }),
    ui.label({ text = clip(title or "", 34), fontSize = 15, fontWeight = "bold", maxLines = 1, maxWidth = 250,
      flexGrow = 1 }),
    ui.row({ key = "st-chip", gap = 6, align = "center", padding = 4, paddingH = 10, radius = 12, border = TONE[tone] or DIM,
      borderWidth = 1, fill = NODE_FILL }, {
      ui.label({ text = clip(status, 16), fontSize = 12, fontWeight = "bold", color = TONE[tone] or DIM, maxLines = 1,
        maxWidth = 110 }),
    }),
    ui.button({ key = "st-go", glyph = GO_GLYPH, variant = "ghost", controlSize = "sm", tooltip = tip,
      enabled = target ~= nil, onClick = goToSelected }),
    ui.button({ key = "st-close", glyph = "x", variant = "ghost", controlSize = "sm",
      tooltip = "Back to tokens and budgets", onClick = clearSelection }),
  }
  return ui.row({ key = "st-head", gap = 8, align = "center" }, row)
end

-- Executive summary pieces. Every card uses a constant fill and a constant rest border; only the left accent bar and
-- text carry colour, so nothing here depends on the pointer.
local W_CARD_TEXT = 430 -- text width inside a card (rail 520 - well padding 24 - accent 4 - card padding 2 x 10 - slack)
local LH = 1.4 -- line height factor used to size accent bars

local function lineBlock(keyPrefix, text, fontSize, color, weight, chars)
  local lines = wrapText(text, chars)
  local out = {}
  for i, ln in ipairs(lines) do
    table.insert(out, ui.label({ key = keyPrefix .. i, text = ln == "" and " " or ln, fontSize = fontSize, color = color,
      fontWeight = weight, maxLines = 1, maxWidth = W_CARD_TEXT }))
  end
  return out, #lines
end

-- A labelled card with a left accent bar: glyph + small caps label, then the wrapped text.
local function infoCard(key, glyph, label, text, accent, chars)
  local lines, n = lineBlock(key .. "-t", text, 13.5, "on_surface", nil, chars or 50)
  local body = { ui.row({ key = key .. "-h", gap = 6, align = "center" }, {
    ui.glyph({ name = glyph, size = 14, color = accent }),
    ui.label({ text = label, fontSize = 11.5, fontWeight = "bold", color = accent }),
  }) }
  for _, l in ipairs(lines) do
    table.insert(body, l)
  end
  local h = 16 + 14 * LH + 4 + n * 13.5 * LH + 6
  return ui.row({ key = key, gap = 0, align = "start", radius = 10, fill = CARD_FILL, border = EDGE_REST, borderWidth = 1 }, {
    ui.box({ key = key .. "-bar", width = 4, height = math.floor(h), fill = accent, border = CLEAR, borderWidth = 0 }),
    ui.box({ width = 10, height = 1, opacity = 0 }),
    ui.column({ key = key .. "-c", gap = 3, paddingV = 8 }, body),
  })
end

local function chipRows(chips)
  local rows, cur, curW = {}, {}, 0
  local function flush()
    if #cur > 0 then
      table.insert(rows, ui.row({ key = "st-chips" .. #rows, gap = 6, align = "center" }, cur))
    end
    cur, curW = {}, 0
  end
  for i, c in ipairs(chips or {}) do
    local text = clip(tostring(c.text or ""), 22)
    local w = utf8.len(text) * 7 + 24
    if curW + w > 440 and #cur > 0 then
      flush()
    end
    local tone = TONE[c.tone or "idle"] or DIM
    table.insert(cur, ui.row({ key = "st-chip" .. i, padding = 3, paddingH = 9, radius = 11, border = tone,
      borderWidth = 1, fill = NODE_FILL }, {
      ui.label({ text = text, fontSize = 11.5, color = tone, maxLines = 1, maxWidth = 200 }),
    }))
    curW = curW + w + 6
  end
  flush()
  return rows
end

local function bulletList(key, items, color, dotColor)
  local out = {}
  for i, t in ipairs(items) do
    local lines = wrapText(tostring(t), 50)
    local col = {}
    for j, ln in ipairs(lines) do
      table.insert(col, ui.label({ key = key .. i .. "-" .. j, text = ln, fontSize = 13, color = color, maxLines = 1,
        maxWidth = W_CARD_TEXT - 22 }))
    end
    table.insert(out, ui.row({ key = key .. i, gap = 8, align = "start" }, {
      ui.glyph({ name = "point-filled", size = 10, color = dotColor }),
      ui.column({ gap = 1 }, col),
    }))
  end
  return out
end

local function sinceText(t)
  local s = math.max(0, nowSec() - (tonumber(t) or 0))
  if s < 45 then
    return "just now"
  elseif s < 5400 then
    return string.format("%d min ago", math.floor(s / 60 + 0.5))
  end
  return string.format("%d h ago", math.floor(s / 3600 + 0.5))
end

-- Dim rounded bars standing in for text that is not decided yet (no words that could later change).
local function skeletonBar(key, w, h)
  return ui.box({ key = key, width = w, height = h, radius = h / 2, fill = "on_surface/0.10", border = CLEAR,
    borderWidth = 0 })
end

local function skeletonCard(key, label, glyph, accent, widths)
  local body = { ui.row({ key = key .. "-h", gap = 6, align = "center" }, {
    ui.glyph({ name = glyph, size = 14, color = accent }),
    ui.label({ text = label, fontSize = 11.5, fontWeight = "bold", color = accent }),
  }) }
  for i, w in ipairs(widths) do
    table.insert(body, skeletonBar(key .. "-b" .. i, w, 10))
  end
  local h = 16 + 14 * LH + 3 + #widths * 13 + 14
  return ui.row({ key = key, gap = 0, align = "start", radius = 10, fill = CARD_FILL, border = EDGE_REST, borderWidth = 1 }, {
    ui.box({ key = key .. "-bar", width = 4, height = math.floor(h), fill = accent, border = CLEAR, borderWidth = 0 }),
    ui.box({ width = 10, height = 1, opacity = 0 }),
    ui.column({ key = key .. "-c", gap = 3, paddingV = 8 }, body),
  })
end

-- Short facts (chips, progress) may change live; the prose below comes from `b`, the pinned brief (nil = skeleton).
local function progressRow(p)
  return ui.row({ key = "st-prog", gap = 10, align = "center" }, {
    ui.progress({ progress = math.max(0.02, math.min(1, (p.done or 0) / p.total)), width = 250, height = 6, radius = 3,
      fill = "primary", track = "on_surface/0.10" }),
    ui.label({ text = tostring(p.label or ""), fontSize = 12, color = DIM, maxLines = 1, maxWidth = 170 }),
  })
end

local function summaryKids(d, b)
  local kids = {}
  for _, r in ipairs(chipRows(d.chips)) do
    table.insert(kids, r)
  end
  local p = type(d.brief) == "table" and d.brief.progress or nil
  if b == nil then
    local head = { skeletonBar("st-hl-sk1", 360, 16), skeletonBar("st-hl-sk2", 230, 16),
      ui.label({ key = "st-wait-sum", text = "zgx-02 is writing the summary…", fontSize = 12, color = DIM, maxLines = 1,
        maxWidth = W_CARD_TEXT }) }
    if type(p) == "table" and (p.total or 0) > 0 then
      table.insert(head, progressRow(p))
    end
    table.insert(kids, ui.column({ key = "st-headline", gap = 8, padding = 12, radius = 10, fill = CARD_FILL,
      border = EDGE_REST, borderWidth = 1 }, head))
    table.insert(kids, skeletonCard("st-left", "WHERE IT LEFT OFF", "map-pin", "primary", { 400, 360, 210 }))
    table.insert(kids, skeletonCard("st-next", "NEXT", "player-track-next", BLUE, { 380, 250 }))
    return kids
  end
  -- HEADLINE card
  local hl = lineBlock("st-hl", tostring(b.headline or ""), 16, "on_surface", "bold", 38)
  local head = {}
  for _, l in ipairs(hl) do
    table.insert(head, l)
  end
  if b.phase ~= nil and b.phase ~= "" then
    table.insert(head, ui.label({ key = "st-phase", text = string.upper(clip(b.phase, 44)), fontSize = 11.5,
      fontWeight = "bold", color = "primary", maxLines = 1, maxWidth = W_CARD_TEXT }))
  end
  if type(p) == "table" and (p.total or 0) > 0 then
    table.insert(head, progressRow(p))
  end
  table.insert(kids, ui.column({ key = "st-headline", gap = 5, padding = 12, radius = 10, fill = CARD_FILL,
    border = EDGE_REST, borderWidth = 1 }, head))
  table.insert(kids, infoCard("st-left", "map-pin", "WHERE IT LEFT OFF", tostring(b.left_off or ""), "primary"))
  table.insert(kids, infoCard("st-next", "player-track-next", "NEXT", tostring(b.next or ""), BLUE))
  if type(b.needs_you) == "string" and b.needs_you ~= "" then
    table.insert(kids, infoCard("st-needs", "alert-triangle", "NEEDS YOU", b.needs_you, AMBER))
  end
  if type(b.highlights) == "table" and #b.highlights > 0 then
    table.insert(kids, ui.label({ key = "st-kp-h", text = "KEY POINTS", fontSize = 11.5, fontWeight = "bold",
      color = "primary" }))
    for _, r in ipairs(bulletList("st-kp", b.highlights, "on_surface", "primary")) do
      table.insert(kids, r)
    end
  end
  if type(b.risks) == "table" and #b.risks > 0 then
    table.insert(kids, ui.label({ key = "st-rk-h", text = "RISKS", fontSize = 11.5, fontWeight = "bold", color = AMBER }))
    for _, r in ipairs(bulletList("st-rk", b.risks, AMBER, AMBER)) do
      table.insert(kids, r)
    end
  end
  return kids
end

local function detailsKids(d)
  local kids = {}
  for i, f in ipairs(d.facts or {}) do
    table.insert(kids, ui.row({ key = "st-f" .. i, gap = 10 }, {
      ui.label({ text = clip(tostring(f[1] or ""), 16), fontSize = 12.5, color = DIM, maxLines = 1,
        maxWidth = W_FACT_LABEL, width = W_FACT_LABEL }),
      ui.label({ text = clip(tostring(f[2] or ""), 90), fontSize = 13, maxLines = 2, maxWidth = 340, flexGrow = 1 }),
    }))
  end
  for si, sec in ipairs(d.sections or {}) do
    table.insert(kids, ui.box({ key = "st-gap" .. si, height = 6, opacity = 0 }))
    table.insert(kids, ui.label({ key = "st-h" .. si, text = string.upper(tostring(sec.heading or "")), fontSize = 11.5,
      fontWeight = "bold", color = "primary" }))
    local shown = 0
    for _, raw in ipairs(sec.lines or {}) do
      for _, w in ipairs(wrapText(tostring(raw), WRAP_CHARS)) do
        shown += 1
        if shown <= MAX_SECTION_LINES then
          table.insert(kids, bodyLine("st-s" .. si .. "-" .. shown, w))
        end
      end
    end
    if shown > MAX_SECTION_LINES then
      table.insert(kids, ui.label({ key = "st-more" .. si, text = "…and " .. tostring(shown - MAX_SECTION_LINES) .. " more lines",
        fontSize = 12, color = DIM }))
    end
  end
  return kids
end

local function stateBody()
  local info = nodeInfo[selKey]
  local d = (detail ~= nil and detail.key == selKey) and detail or nil
  local kids = {}
  if d == nil then
    local sub = info ~= nil and info.sub or ""
    table.insert(kids, ui.label({ key = "st-wait", text = detailError and "Could not read the latest state." or "Reading the latest state…",
      fontSize = 13, color = detailError and AMBER or DIM }))
    if sub ~= "" then
      table.insert(kids, ui.label({ key = "st-sub", text = clip(sub, 60), fontSize = 12, color = DIM, maxLines = 1,
        maxWidth = 470 }))
    end
  else
    local b = pinned -- nil until pinned: skeleton, never text that will change
    kids = summaryKids(d, b)
    local foot
    if b == nil then
      foot = "Looking for the saved summary…"
    elseif b.source == "zgx-02" then
      foot = "Summary by zgx-02 · " .. sinceText(b.generated_at)
      if briefBusy then
        foot = foot .. " · checking for newer…"
      end
    else
      foot = "Summary from records (zgx-02 unavailable)"
    end
    local foots = { ui.label({ key = "st-foot", text = foot, fontSize = 11, color = DIM, maxLines = 1, flexGrow = 1,
      maxWidth = 300 }) }
    if pending ~= nil then
      table.insert(foots, ui.row({ key = "st-newer", gap = 6, align = "center", paddingV = 3, paddingH = 10, radius = 12,
        fill = NODE_FILL, border = hovered == "st-newer" and EDGE_SELECT or EDGE_HOVER, borderWidth = 1,
        onHover = onRowHover, tooltip = "Replace the text above with the newer summary", onClick = showPending }, {
        ui.glyph({ name = "refresh", size = 12, color = "primary" }),
        ui.label({ text = "Newer summary · Show", fontSize = 11.5, fontWeight = "bold", color = "primary", maxLines = 1 }),
      }))
    end
    table.insert(kids, ui.row({ key = "st-footer", gap = 8, align = "center" }, foots))
    -- collapsed DETAILS
    local hasDetails = #(d.facts or {}) > 0 or #(d.sections or {}) > 0
    if hasDetails then
      table.insert(kids, ui.row({ key = "st-dt", gap = 8, align = "center", paddingV = 4, paddingH = 6, radius = 8,
        border = rowEdge("st-dt", false), borderWidth = 1, onHover = onRowHover, tooltip = showDetails and "Hide details" or "Show details",
        onClick = toggleDetails }, {
        ui.glyph({ name = showDetails and "chevron-down" or "chevron-right", size = 14, color = DIM }),
        ui.label({ text = "DETAILS", fontSize = 11.5, fontWeight = "bold", color = DIM }),
        ui.label({ text = showDetails and "facts and full text" or "facts, last request, reply and tool", fontSize = 11.5, color = DIM,
          maxLines = 1, flexGrow = 1 }),
      }))
      if showDetails then
        for _, k in ipairs(detailsKids(d)) do
          table.insert(kids, k)
        end
      end
    end
  end
  return ui.column({ key = "ov-r", gap = 8, width = W_RAIL }, {
    stateHeader(info, d),
    ui.scroll({ key = "st-s", gap = 8, flexGrow = 1, padding = 12, radius = 12, border = WELL, borderWidth = 1 }, kids),
  })
end

local function overviewBody()
  local blocks = {}
  for _, dg in ipairs(diagram) do
    table.insert(blocks, groupBlock(dg))
  end
  if #blocks == 0 then
    table.insert(blocks, ui.label({ key = "d-none", text = st and "No agent activity in the last day." or "",
      fontSize = 13.5, color = DIM }))
  end
  local tokenRows, budgetRows = {}, {}
  for i, e in ipairs(bars.tokens) do
    if i > RAIL_ROWS then
      break
    end
    table.insert(tokenRows, barRow(e, tokenColor(e)))
  end
  for i, e in ipairs(bars.budgets) do
    if i > RAIL_ROWS then
      break
    end
    table.insert(budgetRows, barRow(e, budgetColor(e)))
  end
  local rail
  if selKey ~= nil then
    rail = stateBody()
  else
    rail = ui.column({ key = "ov-r", gap = 8, width = W_RAIL }, {
      sectionHead("ov-tok-h", "TOKENS TODAY", "top " .. tostring(math.min(RAIL_ROWS, #bars.tokens)) .. " by repo"),
      ui.scroll({ key = "ov-tok-s", gap = 3, flexGrow = 1, padding = 8, radius = 12, border = WELL, borderWidth = 1 },
        tokenRows),
      sectionHead("ov-bud-h", "BUDGETS AT RISK", "closest to the limit"),
      ui.scroll({ key = "ov-bud-s", gap = 3, flexGrow = 1, padding = 8, radius = 12, border = WELL, borderWidth = 1 },
        budgetRows),
    })
  end
  return ui.row({ key = "ov", gap = 20, flexGrow = 1 }, {
    ui.column({ key = "ov-d", gap = 8, flexGrow = 1 }, {
      ui.row({ key = "ov-dh", gap = 18, align = "center", paddingH = 4 }, {
        ui.label({ text = "AGENT DIAGRAM", fontSize = 13.5, fontWeight = "bold", color = "primary" }),
        ui.label({ text = "repo → Conversation → subagent / Claude job", fontSize = 12, color = DIM, maxLines = 1,
          flexGrow = 1 }),
        ui.button({ key = "d-collapse", glyph = "fold", text = "Collapse all", variant = "ghost", controlSize = "sm",
          tooltip = "Fold every repo to one line", onClick = function()
            setAllCollapsed(true)
          end }),
        ui.button({ key = "d-expand", glyph = "fold-down", text = "Expand all", variant = "ghost", controlSize = "sm",
          tooltip = "Show every repo's Conversations", onClick = function()
            setAllCollapsed(false)
          end }),
        legendSwatch(LINE_CONV, 3, "Conversation"),
        legendSwatch(LINE_SUB, 3, "subagent"),
        legendSwatch(LINE_JOB, 2, "Claude job"),
        ui.label({ text = "line weight = tokens", fontSize = 12, color = DIM }),
      }),
      ui.scroll({ key = "diagram-s", gap = 14, flexGrow = 1, padding = 14, radius = 12, border = WELL, borderWidth = 1,
        revealKey = tab == "overview" and ("d" .. (diagramActions[diagIdx] or "")) or "" }, blocks),
    }),
    rail,
  })
end

-- ------------------------------------------------------------------ view: DETAILS
local function agentRow(it)
  local selected = tab == "details" and pane == "agents" and agentActions[agentIdx] == it.key
  local indent = (it.depth or 0) * 26
  local children = {}
  if indent > 0 then
    -- Fixed-width empty box: ui.spacer is a flex filler and would swallow the row's free space.
    table.insert(children, ui.box({ width = indent, height = 1, opacity = 0 }))
  end
  -- Live rows tint their glyph green: a separate dot in a nested row would escape the column's width and overlap the
  -- token column, while direct column children are sized (and elided) to it.
  table.insert(children, ui.glyph({ name = KIND_GLYPH[it.kind] or "point", size = it.kind == "repo" and 18 or 16,
    color = it.live and GREEN or (KIND_COLOR[it.kind] or "primary") }))
  if it.kind == "more" then
    table.insert(children, ui.label({ text = it.title, fontSize = 13, color = DIM, flexGrow = 1, maxLines = 1 }))
    return ui.row({ key = it.key, gap = 10, align = "center", paddingH = 10, paddingV = 6, radius = 8, fill = CLEAR,
      border = rowEdge(it.key, false), borderWidth = 1, onHover = onRowHover }, children)
  end
  table.insert(children, ui.column({ gap = 2, flexGrow = 1 }, {
    ui.label({ text = clip(it.title, it.kind == "repo" and 40 or 56), fontSize = it.kind == "repo" and 16 or 15,
      fontWeight = "semibold", color = it.kind == "repo" and "primary" or "on_surface", maxLines = 1,
      maxWidth = W_AGENT_TEXT - indent }),
    ui.label({ text = it.sub or "", fontSize = 12.5, color = DIM, maxLines = 1, maxWidth = W_AGENT_TEXT - indent }),
  }))
  if it.kind == "repo" then
    table.insert(children, ui.label({ text = fmt(it.tokens) .. " today", fontSize = 12.5, color = DIM }))
  elseif it.tokens ~= nil then
    table.insert(children, ui.column({ gap = 4, width = W_TOK, align = "end" }, {
      ui.label({ text = fmt(it.tokens), fontSize = 13, color = "on_surface" }),
      ui.progress({ progress = math.max(0.02, it.frac or 0), width = W_TOK, height = 4, radius = 2,
        fill = it.kind == "sub" and BLUE or "primary", track = "on_surface/0.08" }),
    }))
  else
    table.insert(children, ui.column({ width = W_TOK, align = "end" }, {
      ui.label({ text = it.badge or "Claude", fontSize = 12, color = DIM }),
    }))
  end
  local props = { key = it.key, gap = 10, align = "center", paddingH = 10, paddingV = it.kind == "repo" and 8 or 6,
    radius = 8, fill = CLEAR, border = rowEdge(it.key, selected), borderWidth = 1, onHover = onRowHover }
  if it.action ~= nil then
    local action = it.action
    props.onClick = function()
      runAction(action)
    end
    props.tooltip = actionTip(action)
  end
  return ui.row(props, children)
end

local function repoRow(row)
  local selected = tab == "details" and pane == "repos" and worktreeKeys[repoIdx] == row.key
  local props = { key = row.key, gap = 10, align = "center", paddingH = 10, paddingV = 5, radius = 7, fill = CLEAR,
    border = rowEdge(row.key, selected), borderWidth = 1, onHover = onRowHover }
  if row.kind == "wt" then
    local path = worktreePath[row.key]
    props.onClick = function()
      openWorktree(path)
    end
    props.tooltip = "Open a terminal in " .. (path or "")
  end
  return ui.row(props, {
    ui.glyph({ name = row.kind == "wt" and "git-branch" or "file-description", size = 15,
      color = row.kind == "wt" and "primary" or DIM }),
    ui.label({ text = clip(row.label, 40), fontSize = 13.5, color = "on_surface", maxLines = 1, maxWidth = 300,
      flexGrow = 1 }),
    ui.label({ text = row.right, fontSize = 12.5, color = row.color, maxLines = 1, maxWidth = 150 }),
  })
end

local function repoCard(card)
  local statusRow = {}
  for i, s in ipairs(card.status) do
    if i > 1 then
      table.insert(statusRow, ui.label({ text = "·", fontSize = 12.5, color = DIM }))
    end
    table.insert(statusRow, ui.label({ text = s.text, fontSize = 12.5, color = s.color, maxLines = 1 }))
  end
  local body = {
    ui.row({ gap = 10, align = "center" }, {
      ui.glyph({ name = "folder-code", size = 17, color = "primary" }),
      ui.label({ text = string.upper(card.name), fontSize = 15, fontWeight = "bold", color = "on_surface", maxLines = 1 }),
    }),
    ui.row({ gap = 6, align = "center" }, statusRow),
  }
  if card.meta ~= "" then
    table.insert(body, 2, ui.label({ text = card.meta, fontSize = 12, color = DIM, maxLines = 1, maxWidth = W_REPOS - 60 }))
  end
  for _, row in ipairs(card.rows) do
    table.insert(body, repoRow(row))
  end
  return ui.column({ key = card.key, gap = 6, padding = 12, radius = 10, fill = CARD_FILL,
    border = edge(card.key, false, false), borderWidth = 1, onHover = onRowHover }, body)
end

local function detailsBody()
  local agentRows = {}
  for _, it in ipairs(agents) do
    table.insert(agentRows, agentRow(it))
  end
  if #agentRows == 0 then
    table.insert(agentRows, ui.label({ key = "none", text = st and "No agent activity in the last day." or "",
      fontSize = 13.5, color = DIM }))
  end
  local cards = {}
  for _, c in ipairs(repoCards) do
    table.insert(cards, repoCard(c))
  end
  local tokenRows = {}
  for _, e in ipairs(bars.tokens) do
    table.insert(tokenRows, barRow(e, tokenColor(e)))
  end
  local budgetRows = {}
  for _, e in ipairs(bars.budgets) do
    table.insert(budgetRows, barRow(e, budgetColor(e)))
  end
  local agentsNote = "repo → Conversation → subagent / Claude job"
  if pane == "agents" then
    agentsNote = agentsNote .. "  ·  keyboard"
  end
  local reposNote = "local git · worktrees open a terminal"
  if pane == "repos" then
    reposNote = reposNote .. "  ·  keyboard"
  end
  return ui.row({ key = "body", gap = 20, flexGrow = 1 }, {
    ui.column({ key = "agents", gap = 8, flexGrow = 1 }, {
      sectionHead("agents-h", "AGENTS", agentsNote),
      ui.scroll({ key = "agents-s", gap = 3, flexGrow = 1, padding = 8, radius = 12, border = WELL, borderWidth = 1,
        revealKey = pane == "agents" and (agentActions[agentIdx] or "") or "" }, agentRows),
    }),
    ui.column({ key = "repos", gap = 8, width = W_REPOS }, {
      sectionHead("repos-h", "REPOS", reposNote),
      ui.scroll({ key = "repos-s", gap = 10, flexGrow = 1, padding = 8, radius = 12, border = WELL, borderWidth = 1,
        revealKey = pane == "repos" and (worktreeKeys[repoIdx] or "") or "" }, cards),
    }),
    ui.column({ key = "bars", gap = 8, width = W_BARS }, {
      sectionHead("tok-h", "TODAY · TOKENS BY REPO", "state.db, last 24 h"),
      ui.scroll({ key = "tok-s", gap = 3, flexGrow = 1, padding = 8, radius = 12, border = WELL, borderWidth = 1 }, tokenRows),
      sectionHead("bud-h", "TASK BUDGETS", tostring(#bars.budgets) .. " tasks · task-state.py"),
      ui.scroll({ key = "bud-s", gap = 3, flexGrow = 1, padding = 8, radius = 12, border = WELL, borderWidth = 1 }, budgetRows),
    }),
  })
end

-- ------------------------------------------------------------------ render
render = function()
  if not isOpen then
    return
  end
  local stale = isStale()
  wasStale = stale
  local headInfo
  if st == nil then
    headInfo = collectorError and "No snapshot yet." or "Collecting…"
  else
    headInfo = "snapshot " .. noctalia.formatTime("%H:%M:%S", math.floor(st.generated_at or 0))
  end
  local header = {
    ui.glyph({ name = "git-fork", size = 24, color = "primary" }),
    ui.label({ text = "REPO GRID", fontSize = 19, fontWeight = "bold", color = "primary" }),
    ui.box({ width = 10, height = 1, opacity = 0 }),
    tabChip("overview", "layout-dashboard", "OVERVIEW"),
    tabChip("details", "list-details", "DETAILS"),
    ui.box({ width = 10, height = 1, opacity = 0 }),
    ui.label({ text = headInfo, fontSize = 13, color = DIM, maxLines = 1, flexGrow = 1 }),
  }
  if stale then
    table.insert(header, ui.label({ text = "STALE", fontSize = 13, fontWeight = "bold", color = AMBER }))
  end
  if collectorError then
    table.insert(header, ui.label({ text = "COLLECTOR ERROR", fontSize = 13, fontWeight = "bold", color = RED }))
  end
  local hint = tab == "overview" and "←→ VIEW  ·  ↑↓  ·  ENTER STATE / GO-TO  ·  ESC"
    or "←→ VIEW  ·  TAB AGENTS / REPOS  ·  ↑↓  ·  ENTER OPEN  ·  ESC"
  table.insert(header, ui.label({ text = hint, fontSize = 12, color = DIM }))
  table.insert(header, ui.button({ key = "refresh", glyph = "refresh", variant = "ghost", controlSize = "sm",
    tooltip = "Refresh now", enabled = not collecting, onClick = function()
      collect()
      render()
    end }))
  if not winMode then
    table.insert(header, ui.button({ key = "popout", glyph = "app-window", variant = "ghost", controlSize = "sm",
      tooltip = "Pop out to a window", onClick = popOut }))
  end

  local body
  if tab == "overview" then
    body = { ui.row({ key = "head", gap = 12, align = "center" }, header), ui.separator({ key = "sep" }), tiles(),
      overviewBody() }
  else
    body = { ui.row({ key = "head", gap = 12, align = "center" }, header), ui.separator({ key = "sep" }), detailsBody() }
  end
  panel.render(ui.column({ padding = 22, gap = 14, flexGrow = 1 }, body))
end

-- ------------------------------------------------------------------ lifecycle
-- The bar glyph shows the open tint; the runtime marker lets `repo-grid` (SUPER+C) close an open grid without
-- re-running its admission gates.
local function tellButton(state)
  if winMode then
    return
  end
  noctalia.runAsync({ MSG, "plugin", BUTTON, "all", "state", state })
  noctalia.writeFile(PANEL_STATE_PATH, state .. "\n")
end

function onOpen(_context)
  gen += 1
  isOpen = true
  winMode = panel.isWindow ~= nil and panel.isWindow() == true -- lt14 API; nil on lt13 -> dropdown
  selKey = nil
  detail = nil
  detailError = false
  detailReq += 1
  detailBusy = false
  resetPin()
  lastSynth = {}
  showDetails = false
  hovered = nil
  collecting = false
  collectorError = false
  ticks = 0
  tab = "overview"
  pane = "agents"
  agentIdx = 1
  repoIdx = 1
  diagIdx = 1
  panel.setWantsSecondTicks(true)
  tellButton("open")
  render()
  -- Collapsed repos are shared between the dropdown and the pop-out window through COLLAPSE_PATH.
  local myGen = gen
  noctalia.readFileAsync(COLLAPSE_PATH, function(contents, _err)
    if myGen ~= gen then
      return
    end
    applyCollapsed(contents)
    rebuild()
    render()
  end)
  readState(gen, false) -- last snapshot at once
  collect()
end

function onClose()
  gen += 1
  isOpen = false
  collecting = false
  detailReq += 1
  detailBusy = false
  briefReq += 1
  briefBusy = false
  hovered = nil
  panel.setWantsSecondTicks(false)
  tellButton("closed")
end

function update()
  if not isOpen then
    return
  end
  ticks += 1
  if ticks >= REFRESH_EVERY_S then
    ticks = 0
    collect()
    if selKey ~= nil then
      fetchDetail()
    end
  end
  if selKey ~= nil and pinned == nil and detail ~= nil and nowSec() - pinStart > PIN_FALLBACK_S then
    pinRules()
    render()
  end
  if isStale() ~= wasStale then
    render()
  end
end

-- capture_keys = Tab, Left, Right, Up, Down, Return (the host consumes only these; Esc always closes).
function onKey(chord, pressed)
  if not pressed or not isOpen then
    return
  end
  if chord == "Left" then
    tab = "overview"
  elseif chord == "Right" then
    tab = "details"
  elseif chord == "Tab" then
    if tab == "overview" then
      tab = "details"
    else
      pane = pane == "agents" and "repos" or "agents"
    end
  elseif chord == "Up" or chord == "Down" then
    local d = chord == "Up" and -1 or 1
    if tab == "overview" then
      diagIdx = math.max(1, math.min(#diagramActions, diagIdx + d))
    elseif pane == "agents" then
      agentIdx = math.max(1, math.min(#agentActions, agentIdx + d))
    else
      repoIdx = math.max(1, math.min(#worktreeKeys, repoIdx + d))
    end
  elseif chord == "Return" then
    if tab == "overview" then
      local key = diagramActions[diagIdx]
      if key ~= nil and key == selKey then
        goToSelected()
      elseif key ~= nil then
        selectKey(key)
      end
    elseif pane == "agents" then
      runAction(actionByKey[agentActions[agentIdx] or ""])
    else
      openWorktree(worktreePath[worktreeKeys[repoIdx] or ""])
    end
    return
  end
  hovered = nil
  render()
end

-- ------------------------------------------------------------------ helpers
local function fmt(n)
  n = n or 0
  if n >= 1e6 then
    return string.format("%.1fM", n / 1e6)
  elseif n >= 1e3 then
    return string.format("%dk", math.floor(n / 1e3 + 0.5))
  end
  return tostring(math.floor(n))
end

local function age(secs)
  secs = math.max(0, secs or 0)
  if secs < 90 then
    return string.format("%ds", math.floor(secs + 0.5))
  elseif secs < 5400 then
    return string.format("%dm", math.floor(secs / 60 + 0.5))
  end
  return string.format("%dh", math.floor(secs / 3600 + 0.5))
end

local function clip(s, n)
  s = string.gsub(s or "", "%s+", " ")
  local len = utf8.len(s)
  if len == nil then
    return string.sub(s, 1, n)
  end
  if len <= n then
    return s
  end
  return string.sub(s, 1, utf8.offset(s, n) - 1) .. "…"
end

local function baseName(p)
  return string.match(p or "", "([^/]+)/*$") or (p or "")
end

local function nowSec()
  return noctalia.nowMs() / 1000
end

local function isStale()
  return st ~= nil and (nowSec() - (st.generated_at or 0)) > STALE_S
end

local function onRowHover(state, key)
  local nextKey = (state == "true" or state == true) and key or nil
  if nextKey == "" then
    nextKey = nil
  end
  if nextKey ~= hovered then
    hovered = nextKey
    render()
  end
end

-- Border for a framed node (diagram node, tile, card): never nil, so leaving the pointer always repaints the rest colour.
local function edge(key, selected, live)
  if selected then
    return EDGE_SELECT
  elseif hovered == key then
    return EDGE_HOVER
  elseif live then
    return EDGE_LIVE
  end
  return EDGE_REST
end

-- Border for a plain list row: invisible at rest, never nil.
local function rowEdge(key, selected)
  if selected then
    return EDGE_SELECT
  elseif hovered == key then
    return EDGE_HOVER
  end
  return CLEAR
end

-- One connector segment. Empty segments are invisible (`opacity = 0`; a bare box draws a hairline); drawn segments set
-- an explicit clear border so only the fill shows.
local function seg(w, h, color)
  if color == nil or color == CLEAR or h <= 0 then
    return ui.box({ width = w, height = math.max(0, h), opacity = 0 })
  end
  return ui.box({ width = w, height = h, fill = color, border = CLEAR, borderWidth = 0 })
end

-- ------------------------------------------------------------------ model
local function buildTree(s)
  local out = {}
  if s == nil then
    return out
  end
  local convs = s.conversations or {}
  local byId = {}
  for _, c in ipairs(convs) do
    byId[c.id] = c
  end
  local function topOf(c)
    local guard = 0
    while c.parent ~= nil and byId[c.parent] ~= nil and guard < 10 do
      c = byId[c.parent]
      guard += 1
    end
    return c
  end
  local kids, tops, topJobs = {}, {}, {}
  for _, c in ipairs(convs) do
    local t = topOf(c)
    if t.id == c.id then
      table.insert(tops, c)
    else
      kids[t.id] = kids[t.id] or {}
      table.insert(kids[t.id], { kind = "conv", c = c, at = c.last_activity_at or 0 })
    end
  end
  for _, j in ipairs(s.jobs or {}) do
    if j.parent ~= nil and byId[j.parent] ~= nil then
      local t = topOf(byId[j.parent])
      kids[t.id] = kids[t.id] or {}
      table.insert(kids[t.id], { kind = "job", j = j, at = j.mtime or 0 })
    else
      table.insert(topJobs, j)
    end
  end
  table.sort(tops, function(a, b)
    if (a.live == true) ~= (b.live == true) then
      return a.live == true
    end
    return (a.last_activity_at or 0) > (b.last_activity_at or 0)
  end)

  local xs = {}
  for _, x in ipairs(s.codex or {}) do
    table.insert(xs, x)
  end
  table.sort(xs, function(a, b)
    return (a.last_activity_at or 0) > (b.last_activity_at or 0)
  end)
  local order, present, byName = {}, {}, {}
  local repoByName = {}
  for _, r in ipairs(s.repos or {}) do
    table.insert(order, r.name)
    present[r.name] = true
    repoByName[r.name] = r
  end
  local function group(name)
    if byName[name] == nil then
      byName[name] = { tops = {}, jobs = {}, xs = {} }
      if not present[name] and name ~= UNSCOPED then
        table.insert(order, name)
        present[name] = true
      end
    end
    return byName[name]
  end
  for _, c in ipairs(tops) do
    table.insert(group(c.repo or UNSCOPED).tops, c)
  end
  for _, j in ipairs(topJobs) do
    table.insert(group(j.repo or UNSCOPED).jobs, j)
  end
  for _, x in ipairs(xs) do
    table.insert(group(x.repo or UNSCOPED).xs, x)
  end
  table.insert(order, UNSCOPED)

  local maxTok = 1
  for _, c in ipairs(convs) do
    maxTok = math.max(maxTok, c.tokens or 0)
  end
  local gen_at = s.generated_at or nowSec()

  local function convItem(c, depth)
    local idle = c.last_activity_at and (gen_at - c.last_activity_at) or 0
    return {
      key = "c:" .. c.id, kind = depth > 1 and "sub" or "conv", depth = depth, live = c.live == true,
      title = (c.title ~= nil and c.title ~= "") and c.title or string.sub(c.id, 1, 8),
      sub = (c.source or "hermes") .. " · " .. (c.live and "live" or ("idle " .. age(idle))),
      tokens = c.tokens or 0, frac = (c.tokens or 0) / maxTok,
      action = { kind = "hermes", id = c.id },
      go = { kind = "hermes", id = c.id, cwd = "{{ .chezmoi.homeDir }}" },
    }
  end
  local function jobItem(j, depth, cwd)
    local a = j.mtime and (gen_at - j.mtime) or 0
    return {
      key = "j:" .. j.id, kind = "job", depth = depth, live = a < 120,
      title = (j.kind or "job") .. " " .. (j.task or string.sub(j.id, 1, 8)),
      sub = "Claude " .. (j.kind or "job") .. " · " .. age(a) .. " ago",
      tokens = nil, frac = 0,
      action = { kind = "claude", id = j.id, cwd = cwd },
      go = { kind = "claude", id = j.id, cwd = cwd },
      badge = "Claude",
    }
  end
  local function codexItem(x)
    local idle = x.last_activity_at and (gen_at - x.last_activity_at) or 0
    local act = { kind = "codex", id = x.id, cwd = x.cwd ~= nil and x.cwd ~= "" and x.cwd or "{{ .chezmoi.homeDir }}" }
    return {
      key = "x:" .. x.id, kind = "codex", depth = 1, live = x.live == true,
      title = (x.title ~= nil and x.title ~= "") and x.title or string.sub(x.id, 1, 8),
      sub = "codex · " .. (x.live and "live" or ("idle " .. age(idle))),
      tokens = nil, frac = 0, action = act, go = act, badge = "Codex",
    }
  end

  for _, name in ipairs(order) do
    local grp = byName[name]
    if grp ~= nil then
      local rec = repoByName[name]
      local cwd = rec and rec.checkout or "{{ .chezmoi.homeDir }}"
      local tokensToday = rec and rec.tokens_today or s.unscoped_tokens or 0
      local sub
      if name == UNSCOPED then
        sub = "no repo in cwd" -- the pill already shows the token count at its right edge
      elseif rec ~= nil and rec.present then
        sub = (rec.branch or "detached") .. " · " .. tostring(rec.dirty or 0) .. " changed · "
          .. tostring(#(rec.worktrees or {})) .. " worktrees"
      else
        sub = "not checked out"
      end
      local head = { key = "r:" .. name, kind = "repo", depth = 0, live = false,
        title = name == UNSCOPED and "~ UNSCOPED" or string.upper(name), sub = sub, tokens = tokensToday, frac = 0,
        go = { kind = "kitty", id = name, cwd = (rec ~= nil and rec.present) and cwd or "{{ .chezmoi.homeDir }}" } }
      local g = { head = head, tops = {} }
      for _, c in ipairs(grp.tops) do
        if c.live then
          head.live = true
        end
        local node = { item = convItem(c, 1), kids = {} }
        local list = kids[c.id] or {}
        table.sort(list, function(a, b)
          return a.at > b.at
        end)
        for _, kid in ipairs(list) do
          if kid.kind == "conv" then
            table.insert(node.kids, convItem(kid.c, 2))
          else
            table.insert(node.kids, jobItem(kid.j, 2, cwd))
          end
        end
        table.insert(g.tops, node)
      end
      for _, x in ipairs(grp.xs) do
        if x.live then
          head.live = true
        end
        table.insert(g.tops, { item = codexItem(x), kids = {} })
      end
      for _, j in ipairs(grp.jobs) do
        table.insert(g.tops, { item = jobItem(j, 1, cwd), kids = {} })
      end
      table.insert(out, g)
    end
  end
  return out
end

-- DETAILS list: the tree flattened with indent depth, capped at MAX_AGENT_ROWS.
local function flatten(tree)
  local items, actions, hidden = {}, {}, 0
  local function push(item)
    if #items >= MAX_AGENT_ROWS then
      hidden += 1
      return false
    end
    table.insert(items, item)
    if item.action ~= nil then
      table.insert(actions, item.key)
    end
    return true
  end
  for _, g in ipairs(tree) do
    if push(g.head) then
      for _, t in ipairs(g.tops) do
        push(t.item)
        for k, kid in ipairs(t.kids) do
          if k > MAX_KIDS then
            hidden += #t.kids - MAX_KIDS
            break
          end
          push(kid)
        end
      end
    else
      hidden += #g.tops
    end
  end
  if hidden > 0 then
    table.insert(items, { key = "more", kind = "more", depth = 0, title = "+" .. tostring(hidden) .. " more (older or nested)" })
  end
  return items, actions
end

-- OVERVIEW diagram: repos with agent activity, MAX_TOPS Conversations each, MAX_DIAGRAM_KIDS kids under each. A repo in
-- `collapsed` keeps only its head node (and keyboard stop) plus counts for the one-line summary.
local function buildDiagram(tree)
  local out, actions = {}, {}
  for _, g in ipairs(tree) do
    if #g.tops > 0 then
      local dg = { head = g.head, tops = {}, more = 0, collapsed = collapsed[g.head.key] == true,
        sum = { convs = #g.tops, live = 0, subs = 0 } }
      for _, t in ipairs(g.tops) do
        if t.item.live then
          dg.sum.live += 1
        end
        for _, kid in ipairs(t.kids) do
          dg.sum.subs += 1
          if kid.live then
            dg.sum.live += 1
          end
        end
      end
      table.insert(actions, g.head.key)
      if not dg.collapsed then
        for i, t in ipairs(g.tops) do
          if i > MAX_TOPS then
            dg.more = #g.tops - MAX_TOPS
            break
          end
          local dt = { item = t.item, kids = {}, more = 0 }
          table.insert(actions, t.item.key)
          for k, kid in ipairs(t.kids) do
            if k > MAX_DIAGRAM_KIDS then
              dt.more = #t.kids - MAX_DIAGRAM_KIDS
              break
            end
            table.insert(dt.kids, kid)
            table.insert(actions, kid.key)
          end
          table.insert(dg.tops, dt)
        end
      end
      table.insert(out, dg)
    end
  end
  return out, actions
end

local function buildRepos(s)
  local cards, keys, paths = {}, {}, {}
  if s == nil then
    return cards, keys, paths
  end
  for _, r in ipairs(s.repos or {}) do
    local status = {}
    if not r.present then
      table.insert(status, { text = "not checked out", color = DARK })
    elseif r.error ~= nil then
      table.insert(status, { text = "error", color = RED })
    else
      table.insert(status, { text = r.branch or "detached", color = "on_surface" })
      if (r.dirty or 0) > 0 then
        table.insert(status, { text = tostring(r.dirty) .. " changed", color = AMBER })
      else
        table.insert(status, { text = "clean", color = DIM })
      end
      if (r.ahead or 0) > 0 then
        table.insert(status, { text = "+" .. tostring(r.ahead), color = "on_surface" })
      end
      if (r.behind or 0) > 0 then
        table.insert(status, { text = "↓" .. tostring(r.behind), color = BLUE })
      end
    end
    local rows = {}
    for _, w in ipairs(r.worktrees or {}) do
      if w.path ~= r.checkout then
        local right, color
        if w.prunable then
          right, color = "prunable", RED
        elseif (w.dirty or 0) > 0 then
          right, color = tostring(w.dirty) .. " changed", AMBER
        else
          right, color = "clean", DIM
        end
        local key = "w:" .. w.path
        table.insert(rows, { key = key, kind = "wt", label = w.branch or (baseName(w.path) .. " (detached)"),
          right = right, color = color })
        table.insert(keys, key)
        paths[key] = w.path
      end
    end
    for _, sp in ipairs(r.specs or {}) do
      local color = DIM
      if sp.status == "ready" then
        color = BLUE
      elseif sp.status == "draft" then
        color = AMBER
      end
      table.insert(rows, { key = "s:" .. r.name .. ":" .. (sp.slug or "?"), kind = "spec", label = sp.slug or "?",
        right = (sp.status or "") .. (sp.tier and (" · " .. sp.tier) or ""), color = color })
    end
    local meta = {}
    if r.visibility then
      table.insert(meta, r.visibility)
    end
    if r.role then
      table.insert(meta, r.role)
    end
    table.insert(cards, { key = "rc:" .. r.name, name = r.name, meta = table.concat(meta, " · "), status = status,
      rows = rows })
  end
  return cards, keys, paths
end

local function buildBars(s)
  local res = { tokens = {}, budgets = {} }
  if s == nil then
    return res
  end
  local list = { { name = "~ unscoped", tokens = s.unscoped_tokens or 0, dim = true } }
  for _, r in ipairs(s.repos or {}) do
    if (r.tokens_today or 0) > 0 then
      table.insert(list, { name = r.name, tokens = r.tokens_today, dim = false })
    end
  end
  table.sort(list, function(a, b)
    return a.tokens > b.tokens
  end)
  local top = math.max(1, list[1] and list[1].tokens or 1)
  for _, e in ipairs(list) do
    table.insert(res.tokens, { key = "t:" .. e.name, name = e.name, right = fmt(e.tokens), frac = e.tokens / top,
      dim = e.dim })
  end
  for _, t in ipairs(s.tasks or {}) do
    if (t.budget_tokens or 0) > 0 then
      local f = math.min(1, (t.tokens_used or 0) / t.budget_tokens)
      table.insert(res.budgets, { key = "b:" .. t.id, name = t.ref or t.title or t.id, title = t.title or "",
        right = fmt(t.tokens_used) .. " / " .. fmt(t.budget_tokens) .. " · " .. tostring(math.floor(f * 100 + 0.5)) .. "%",
        frac = f, hot = f >= 0.8 })
    end
  end
  -- Closest to the limit first, so the tasks that matter stay in view.
  table.sort(res.budgets, function(a, b)
    return a.frac > b.frac
  end)
  return res
end

local function buildSummary(s)
  if s == nil then
    return nil
  end
  local sum = { repos = 0, dirtyRepos = 0, missing = 0, worktrees = 0, dirtyWt = 0, prunable = 0, specs = 0, ready = 0,
    draft = 0, convs = 0, live = 0, subs = 0, jobs = 0, liveJobs = 0, tokens = s.unscoped_tokens or 0, topRepo = nil,
    topTokens = 0, budgets = 0, hot = 0 }
  for _, r in ipairs(s.repos or {}) do
    sum.repos += 1
    if not r.present then
      sum.missing += 1
    elseif (r.dirty or 0) > 0 then
      sum.dirtyRepos += 1
    end
    for _, w in ipairs(r.worktrees or {}) do
      if w.path ~= r.checkout then
        sum.worktrees += 1
        if w.prunable then
          sum.prunable += 1
        elseif (w.dirty or 0) > 0 then
          sum.dirtyWt += 1
        end
      end
    end
    for _, sp in ipairs(r.specs or {}) do
      sum.specs += 1
      if sp.status == "ready" then
        sum.ready += 1
      elseif sp.status == "draft" then
        sum.draft += 1
      end
    end
    sum.tokens += r.tokens_today or 0
    if (r.tokens_today or 0) > sum.topTokens then
      sum.topTokens = r.tokens_today
      sum.topRepo = r.name
    end
  end
  for _, c in ipairs(s.conversations or {}) do
    sum.convs += 1
    if c.live then
      sum.live += 1
    end
    if c.parent ~= nil then
      sum.subs += 1
    end
  end
  local gen_at = s.generated_at or nowSec()
  for _, j in ipairs(s.jobs or {}) do
    sum.jobs += 1
    if j.mtime and (gen_at - j.mtime) < 120 then
      sum.liveJobs += 1
    end
  end
  for _, t in ipairs(s.tasks or {}) do
    if (t.budget_tokens or 0) > 0 then
      sum.budgets += 1
      if (t.tokens_used or 0) / t.budget_tokens >= 0.8 then
        sum.hot += 1
      end
    end
  end
  return sum
end

local function rebuild()
  local keepKey = diagramActions[diagIdx]
  groups = buildTree(st)
  agents, agentActions = flatten(groups)
  diagram, diagramActions = buildDiagram(groups)
  actionByKey = {}
  nodeInfo = {}
  for _, g in ipairs(groups) do
    nodeInfo[g.head.key] = g.head
    for _, t in ipairs(g.tops) do
      actionByKey[t.item.key] = t.item.action
      nodeInfo[t.item.key] = t.item
      for _, kid in ipairs(t.kids) do
        actionByKey[kid.key] = kid.action
        nodeInfo[kid.key] = kid
      end
    end
  end
  repoCards, worktreeKeys, worktreePath = buildRepos(st)
  bars = buildBars(st)
  summary = buildSummary(st)
  agentIdx = math.max(1, math.min(agentIdx, #agentActions))
  repoIdx = math.max(1, math.min(repoIdx, #worktreeKeys))
  diagIdx = math.max(1, math.min(diagIdx, #diagramActions))
  if keepKey ~= nil then
    for i, k in ipairs(diagramActions) do
      if k == keepKey then
        diagIdx = i
      end
    end
  end
end

-- Collapsed repos persist in COLLAPSE_PATH ({"collapsed":["r:name",...]}), written through a temp file and renamed in
-- one step. Unknown keys are harmless: only repos present in the diagram look the set up.
local function saveCollapsed()
  local list = {}
  for k, v in pairs(collapsed) do
    if v then
      table.insert(list, k)
    end
  end
  table.sort(list)
  noctalia.mkdirAll(COLLAPSE_DIR)
  local tmp = COLLAPSE_PATH .. ".tmp"
  if noctalia.writeFile(tmp, noctalia.json.encode({ collapsed = list }) .. "\n") then
    noctalia.renameFile(tmp, COLLAPSE_PATH)
  end
end

local function applyCollapsed(contents)
  local ok, d = pcall(noctalia.json.decode, contents or "")
  collapsed = {}
  if ok and type(d) == "table" and type(d.collapsed) == "table" then
    for _, k in ipairs(d.collapsed) do
      if type(k) == "string" then
        collapsed[k] = true
      end
    end
  end
end

-- ------------------------------------------------------------------ data
local function applyState(contents)
  local ok, d = pcall(noctalia.json.decode, contents or "")
  if ok and type(d) == "table" and d.schema == 1 then
    st = d
    rebuild()
    return true
  end
  return false
end

local warmBriefs -- forward: defined with the brief pinning below

local function readState(myGen, markError)
  local queued = noctalia.readFileAsync(STATE_PATH, function(contents, _err)
    if myGen ~= gen then
      return
    end
    local good = contents ~= nil and applyState(contents)
    if markError then
      collectorError = not good
    end
    if good and warmedGen ~= gen then
      warmedGen = gen
      warmBriefs()
    end
    render()
  end)
  if not queued and markError then
    collectorError = true
    render()
  end
end

local function collect()
  if collecting then
    return
  end
  collecting = true
  local myGen = gen
  noctalia.runAsync({ COLLECT, "--out", STATE_PATH }, function(result)
    collecting = false
    if myGen ~= gen then
      return
    end
    if result.exitCode ~= 0 then
      collectorError = true
      render()
      return
    end
    readState(myGen, true)
  end)
end


local function actionTip(a)
  if a.kind == "hermes" then
    return "Resume this Conversation"
  elseif a.kind == "codex" then
    return "Resume this Codex session"
  end
  return "Resume this Claude job"
end

-- Executive summary, pinned (round 7). The prose of a card is pinned per selected key the first time it is shown and is
-- never replaced by itself, so a reader is not moved mid-sentence. Pin order: (a) any cached zgx-02 brief
-- (`--brief KEY --cached-only`, <1 s, run right after select); (b) the fresh synthesis when it returns; (c) the rules
-- brief only when synthesis fails or takes over PIN_FALLBACK_S. A newer brief that arrives afterwards waits in `pending`
-- behind the "Newer summary · Show" pill. Short facts (chips, status, progress) stay live.
local function briefSig(b)
  return type(b) == "table" and (tostring(b.headline) .. "|" .. tostring(b.phase) .. "|" .. tostring(b.left_off) .. "|"
    .. tostring(b.next) .. "|" .. tostring(b.needs_you) .. "|" .. tostring(b.highlights and #b.highlights) .. "|"
    .. tostring(b.risks and #b.risks)) or ""
end

local function detailFp(d)
  return d ~= nil and (tostring(d.status) .. "|" .. tostring(d.brief and d.brief.left_off) .. "|"
    .. tostring(d.brief and d.brief.headline) .. "|" .. tostring(d.brief and d.brief.next)) or nil
end

-- A brief that is ready: pin it when nothing is pinned yet, otherwise hold it back when it reads differently.
local function offerBrief(b)
  if type(b) ~= "table" then
    return
  end
  if pinned == nil then
    pinned = b
    pending = nil
  elseif b.source == "zgx-02" and briefSig(b) ~= briefSig(pinned) then
    pending = b
  end
end

-- Pin the rules brief when zgx-02 failed, was off, or has not answered within PIN_FALLBACK_S.
local function pinRules()
  if pinned == nil and detail ~= nil and type(detail.brief) == "table" then
    pinned = detail.brief
  end
end

local function synthesise()
  if selKey == nil or briefBusy then
    return
  end
  local key, myGen, req = selKey, gen, briefReq
  briefBusy = true
  lastSynth[key] = nowSec()
  briefStamp = detailFp(detail) or briefStamp
  noctalia.runAsync({ COLLECT, "--brief", key }, function(result)
    if myGen ~= gen or req ~= briefReq then
      return
    end
    briefBusy = false
    local ok, b = false, nil
    if result.exitCode == 0 then
      ok, b = pcall(noctalia.json.decode, result.stdout or "")
    end
    if ok and type(b) == "table" and b.key == key and type(b.brief) == "table" then
      offerBrief(b.brief)
    elseif pinned == nil then
      pinRules()
    end
    render()
  end, SYNTH_TIMEOUT_MS)
end

local function fetchCached()
  if selKey == nil then
    return
  end
  local key, myGen, req = selKey, gen, briefReq
  noctalia.runAsync({ COLLECT, "--brief", key, "--cached-only" }, function(result)
    if myGen ~= gen or req ~= briefReq then
      return
    end
    local ok, b = false, nil
    if result.exitCode == 0 then
      ok, b = pcall(noctalia.json.decode, result.stdout or "")
    end
    local cached = ok and type(b) == "table" and b.key == key and b.cached == true and type(b.brief) == "table"
    if cached then
      offerBrief(b.brief)
    end
    if not (cached and b.fresh == true) then
      synthesise() -- nothing cached or the cache is older than the item's activity: the result is pinned or held back
    end
    render()
  end)
end

-- Ask for a re-synthesis when the item's activity changed: at most once per RESYNTH_MIN_S per key; it always lands in
-- `pending` because something is already pinned.
local function maybeResynth(d)
  local fp = detailFp(d)
  if briefStamp == nil then
    briefStamp = fp
    return
  end
  if fp ~= briefStamp and pinned ~= nil and not briefBusy and nowSec() - (lastSynth[selKey] or 0) >= RESYNTH_MIN_S then
    synthesise()
  end
end

-- Background warm-up on open: synthesise briefs for the visible diagram nodes (live first, at most WARM_MAX) so most
-- clicks pin a cached brief at once.
warmBriefs = function()
  local live, rest = {}, {}
  for _, k in ipairs(diagramActions) do
    local it = nodeInfo[k]
    table.insert(it ~= nil and it.live and live or rest, k)
  end
  local argv = { COLLECT, "--warm" }
  for _, k in ipairs(live) do
    if #argv < 2 + WARM_MAX then
      table.insert(argv, k)
    end
  end
  for _, k in ipairs(rest) do
    if #argv < 2 + WARM_MAX then
      table.insert(argv, k)
    end
  end
  if #argv > 2 then
    noctalia.runAsync(argv, function(_result) end, 60000)
  end
end

-- STATE pane: selection and the asynchronous detail fetch.
local function fetchDetail()
  if selKey == nil then
    return
  end
  detailReq += 1
  local req, key, myGen = detailReq, selKey, gen
  detailBusy = true
  noctalia.runAsync({ COLLECT, "--detail", key }, function(result)
    if myGen ~= gen or req ~= detailReq then
      return
    end
    detailBusy = false
    local ok, d = false, nil
    if result.exitCode == 0 then
      ok, d = pcall(noctalia.json.decode, result.stdout or "")
    end
    if ok and type(d) == "table" and d.key == key then
      detail = d
      detailError = false
      if pinned == nil and not briefBusy and nowSec() - pinStart > PIN_FALLBACK_S then
        pinRules()
      end
      maybeResynth(d)
    else
      detailError = true
    end
    render()
  end)
end

local function toggleDetails()
  showDetails = not showDetails
  hovered = nil
  render()
end

local function showPending()
  if pending ~= nil then
    pinned = pending
    pending = nil
  end
  hovered = nil
  render()
end

local function resetPin()
  pinned = nil
  pending = nil
  pinStart = nowSec()
  briefBusy = false
  briefStamp = nil
  briefReq += 1
end

local function selectKey(key)
  if key ~= selKey then
    selKey = key
    detail = nil
    detailError = false
    resetPin()
    showDetails = false
    fetchCached()
  end
  for i, k in ipairs(diagramActions) do
    if k == key then
      diagIdx = i
    end
  end
  hovered = nil
  fetchDetail()
  render()
end

local function clearSelection()
  selKey = nil
  detail = nil
  detailError = false
  detailReq += 1
  detailBusy = false
  resetPin()
  hovered = nil
  render()
end

local function toggleRepo(key)
  if collapsed[key] then
    collapsed[key] = nil
  else
    collapsed[key] = true
  end
  hovered = nil
  rebuild()
  saveCollapsed()
  render()
end

local function setAllCollapsed(on)
  collapsed = {}
  if on then
    for _, g in ipairs(groups) do
      if #g.tops > 0 then
        collapsed[g.head.key] = true
      end
    end
  end
  hovered = nil
  rebuild()
  saveCollapsed()
  render()
end

local function goTarget()
  if selKey == nil then
    return nil
  end
  if detail ~= nil and detail.key == selKey and type(detail.open) == "table" then
    return { kind = detail.open.kind, id = detail.open.id, cwd = detail.open.cwd }
  end
  local it = nodeInfo[selKey]
  return it ~= nil and it.go or nil
end

local function goToSelected()
  runAction(goTarget())
end

local function popOut()
  noctalia.runAsync({ MSG, "panel-open", "liquidtron/repogrid:window", "window" })
  panel.close()
end

local function setTab(id)
  if tab ~= id then
    tab = id
    hovered = nil
    render()
  end
end


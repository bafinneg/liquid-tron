#!/usr/bin/env bash
set -euo pipefail
# Record a selected screen region via wf-recorder + slurp
# Output: ~/Videos/recordings/<timestamp>.mp4

dir="$HOME/Videos/recordings"
mkdir -p "$dir"

geometry=$(slurp) || { echo "Selection cancelled"; exit 1; }
outfile="$dir/$(date +%Y%m%d-%H%M%S).mp4"

wf-recorder -g "$geometry" -f "$outfile" &
notify-send -u normal -i media-record "Recording" "Region → $outfile (PID $!)"

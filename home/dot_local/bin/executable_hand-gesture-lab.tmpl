class Keys:
    def __init__(self, on):
        self.on = on and sys.stdin.isatty()
        self.saved = None
        if self.on:
            import termios
            import tty
            self.saved = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())

    def get(self):
        if not self.on:
            return None
        r, _, _ = select.select([sys.stdin], [], [], 0)
        return sys.stdin.read(1) if r else None

    def close(self):
        if self.saved is not None:
            import termios
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.saved)
            self.saved = None


def play(name):
    try:
        subprocess.Popen(["pw-play", os.path.join(SOUNDS, name)], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


AMBER, GREEN, GREY, BOLD, RESET = "\x1b[38;5;214m", "\x1b[1;38;5;46m", "\x1b[38;5;244m", "\x1b[1m", "\x1b[0m"


class Session:
    """Prompt state machine, driven once per camera frame. Times are time.monotonic(), the frame clock."""

    def __init__(self, steps, interactive, out=sys.stdout):
        self.steps = steps
        self.i = 0
        self.phase = None
        self.t0 = 0.0
        self.cur = None
        self.segs = []
        self.paused = False
        self.quit = False
        self.interactive = interactive
        self.out = out
        self.hands = 0
        self.fps = 0.0
        self._shown = None
        self.sections_done = []

    @property
    def done(self):
        return self.quit or self.i >= len(self.steps)

    def _sec_total(self):
        return len([s for s in self.steps if s["kind"] == "intro"])

    def _sec_no(self):
        return len([s for s in self.steps[:self.i + 1] if s["kind"] == "intro"])

    def _start(self, now):
        if self.i >= len(self.steps):
            return
        st = self.steps[self.i]
        if st["kind"] == "intro":
            self.phase = "intro"
        else:
            self.phase = "ready"
            self.cur = {"sec": st["sec"], "label": st["label"], "activity": st["activity"], "rep": st["rep"],
                        "prompt": st["title"], "ready_t": round(now, 3), "botched": False}
        self.t0 = now
        self._shown = None

    def _next(self, now):
        st = self.steps[self.i]
        if st["kind"] == "seg" and (self.i + 1 >= len(self.steps) or self.steps[self.i + 1]["kind"] == "intro"):
            self.sections_done.append(st["sec"])
            play("complete.oga")
        self.i += 1
        self._start(now)

    def key(self, k, now):
        if k in ("q", "Q"):
            self.quit = True
        elif k in ("x", "X"):
            if self.phase in ("go", "rest") and self.cur:
                self.cur["botched"] = True
            elif self.segs:
                self.segs[-1]["botched"] = True
            self._shown = None
        elif k == " " and self.phase != "intro":
            self.paused = not self.paused
            if not self.paused:
                self._start(now)                    # the interrupted prompt starts again from READY
            self._shown = None
        elif self.phase == "intro" and k in ("\n", "\r"):
            self.i += 1
            self._start(now)
        elif self.phase == "intro" and k in ("s", "S"):
            j = self.i + 1
            while j < len(self.steps) and self.steps[j]["kind"] != "intro":
                j += 1
            self.i = j
            self._start(now)

    def tick(self, now):
        if self.phase is None:
            self._start(now)
        if self.done or self.paused:
            self.draw(now)
            return
        st = self.steps[self.i]
        el = now - self.t0
        if self.phase == "intro":
            if not self.interactive:
                self.i += 1
                self._start(now)
        elif self.phase == "ready" and el >= READY_S:
            self.phase, self.t0 = "go", now
            self.cur["go_t"] = round(now, 3)
            play("message-new-instant.oga")
        elif self.phase == "go" and el >= st["go"]:
            self.phase, self.t0 = "rest", now
            self.cur["end_t"] = round(now, 3)
            play("audio-volume-change.oga")
        elif self.phase == "rest" and el >= REST_S:
            self.cur["rest_end_t"] = round(now, 3)
            self.segs.append(self.cur)
            self.cur = None
            self._next(now)
        self.draw(now)

    def draw(self, now):
        if self.done:
            return
        st = self.steps[self.i]
        left = 0.0
        if st["kind"] == "seg" and self.phase in ("ready", "go", "rest"):
            dur = {"ready": READY_S, "go": st["go"], "rest": REST_S}[self.phase]
            left = max(0.0, dur - (now - self.t0))
        key = (self.i, self.phase, self.paused, round(left * 2), self.hands, self.cur and self.cur.get("botched"),
               self.segs and self.segs[-1].get("botched"))
        if key == self._shown:
            return
        self._shown = key
        w = self.out.write
        w("\x1b[2J\x1b[H")
        w(f"{GREY}HAND GESTURE LAB  ·  section {self._sec_no()}/{self._sec_total()}: {SECTIONS[st['sec']][0]}{RESET}\n\n")
        if st["kind"] == "intro":
            w(f"{BOLD}{SECTIONS[st['sec']][0]}{RESET}\n\n{st['text']}\n\n")
            w(f"{GREEN}Press Enter to begin{RESET}   (s skips this section, q stops and saves)\n")
        else:
            w(f"{GREY}item {st['item']}/{st['items']}  ·  rep {st['rep']}/{st['reps']}{RESET}\n\n")
            w(f"  {BOLD}{st['title']}{RESET}\n  {st['how']}\n\n")
            if self.paused:
                w(f"  {AMBER}PAUSED{RESET}  (space resumes; this prompt starts again)\n")
            elif self.phase == "ready":
                w(f"  {AMBER}○ get ready{RESET}   {left:4.1f} s\n")
            elif self.phase == "go":
                w(f"  {GREEN}● GO — now{RESET}     {left:4.1f} s\n")
            else:
                w(f"  {GREY}○ rest{RESET}        {left:4.1f} s\n")
            if self.cur and self.cur.get("botched"):
                w(f"\n  {AMBER}marked botched{RESET}\n")
        hand = f"{GREEN}hand seen ({self.hands}){RESET}" if self.hands else f"{AMBER}no hand in view{RESET}"
        w(f"\n\n{GREY}space pause · x botched · q stop and save{RESET}      {hand}   {GREY}{self.fps:4.1f} fps{RESET}\n")
        self.out.flush()


def make_lab_recognizer(hg):
    """The daemon's recogniser settings (make_recognizer), but returning every canned gesture score."""
    from mediapipe.tasks.python import vision, BaseOptions
    from mediapipe.tasks.python.components.processors.classifier_options import ClassifierOptions
    opt = vision.GestureRecognizerOptions(
        base_options=BaseOptions(model_asset_path=hg.MODEL),
        running_mode=vision.RunningMode.VIDEO, num_hands=2,
        min_hand_presence_confidence=0.3, min_tracking_confidence=0.3,
        canned_gesture_classifier_options=ClassifierOptions(max_results=8, score_threshold=0.0))
    return vision.GestureRecognizer.create_from_options(opt)


def unit_active():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", UNIT]).returncode == 0


def spawn_window(argv):
    exe = os.path.realpath(__file__)
    cmd = ["kitty", "--class", "hand-gesture-lab", "--title", "Hand gesture lab", "-o", "font_size=22",
           "env", "HGLAB_CHILD=1", exe] + argv
    try:
        return subprocess.run(cmd).returncode
    except OSError as e:
        print(f"hand-gesture-lab: cannot open kitty ({e}); re-run with --no-window", file=sys.stderr)
        return 2


def cmd_record(a, argv):
    interactive = sys.stdin.isatty()
    if interactive and not a.no_window and not os.environ.get("HGLAB_CHILD"):
        return spawn_window(argv)
    sections = [s.strip() for s in a.sections.split(",") if s.strip()]
    bad = [s for s in sections if s not in SECTIONS]
    if bad or not sections:
        print(f"hand-gesture-lab: unknown section(s) {bad}; use {','.join(SECTIONS)}", file=sys.stderr)
        return 64
    hg = load_engine(ENGINE)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    out = a.out or os.path.join(DATA, f"rec-{stamp}{'-quick' if a.quick else ''}")
    os.makedirs(out, exist_ok=True)
    meta = {"protocol": PROTOCOL_VERSION, "sections": sections, "quick": a.quick, "complete": False,
            "started": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "host": socket.gethostname(), "camera": hg.CAMERA,
            "capture": [hg.CAPTURE_W, hg.CAPTURE_H, hg.CAPTURE_FPS], "model": hg.MODEL,
            "model_sha256": sha256(hg.MODEL), "engine_sha256": sha256(ENGINE),
            "recogniser": {"num_hands": 2, "min_hand_presence_confidence": 0.3, "min_tracking_confidence": 0.3,
                           "min_hand_detection_confidence": "default (0.5)"},
            "clock": "time.monotonic seconds; labels use the same clock",
            "frame_format": {"i": "frame number", "t": "monotonic s after read", "ms": "recogniser ms",
                             "luma": "mean of the BGR frame", "hands": "[{hd: handedness label, hs: its score, "
                             "g: [[gesture, score]] all canned classes, lm: 21x[x,y,z] image-normalised, "
                             "wl: 21x[x,y,z] world metres}]"}}
    was_active = unit_active()
    if was_active:
        subprocess.run(["systemctl", "--user", "stop", UNIT])
        meta["service_stopped"] = True
    keys = Keys(interactive)
    sess = Session(build_steps(sections, a.quick), interactive)
    cap = writer = None
    n = 0
    t_first = None
    ms_all = []
    rc = 0
    try:
        import cv2
        import mediapipe as mp
        meta["mediapipe"] = getattr(mp, "__version__", None)
        cap = hg.open_camera()
        if cap is None:
            print("hand-gesture-lab: camera not available", file=sys.stderr)
            return 2
        rec = make_lab_recognizer(hg)
        writer = gzip.open(os.path.join(out, "frames.jsonl.gz"), "wt", compresslevel=6)
        recent = collections.deque(maxlen=30)
        last_ts = -1
        while not sess.done:
            if a.limit_s and t_first and time.monotonic() - t_first >= a.limit_s:
                sess.quit = True
                break
            k = keys.get()
            while k:
                sess.key(k, time.monotonic())
                k = keys.get()
            ok, frame = cap.read()
            now = time.monotonic()
            if not ok:
                time.sleep(0.02)
                continue
            n += 1
            t_first = t_first or now
            ts = max(last_ts + 1, int(now * 1000))
            last_ts = ts
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            s = time.perf_counter()
            res = rec.recognize_for_video(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb), ts)
            ms = (time.perf_counter() - s) * 1000
            ms_all.append(ms)
            hands = hands_from_result(res)
            writer.write(json.dumps({"i": n, "t": round(now, 4), "ms": round(ms, 1),
                                     "luma": round(float(frame.mean()), 1), "hands": hands},
                                    separators=(",", ":")) + "\n")
            recent.append(now)
            sess.hands = len(hands)
            sess.fps = (len(recent) - 1) / (recent[-1] - recent[0]) if len(recent) > 1 and recent[-1] > recent[0] else 0.0
            nsegs = len(sess.segs)
            sess.tick(now)
            if len(sess.segs) != nsegs:
                write_json(os.path.join(out, "labels.json"), {"segments": sess.segs})
    except KeyboardInterrupt:
        sess.quit = True
    finally:
        keys.close()
        if cap is not None:
            cap.release()
        if writer is not None:
            writer.close()
        write_json(os.path.join(out, "labels.json"), {"segments": sess.segs})
        meta.update({"frames": n, "seconds": round((time.monotonic() - t_first), 1) if t_first else 0,
                     "segments": len(sess.segs), "sections_done": sess.sections_done,
                     "complete": not sess.quit and sess.i >= len(sess.steps),
                     "ms_p50": round(statistics.median(ms_all), 1) if ms_all else None,
                     "ms_p95": round(sorted(ms_all)[int(len(ms_all) * 0.95)], 1) if ms_all else None,
                     "ended": datetime.datetime.now().astimezone().isoformat(timespec="seconds")})
        meta["fps"] = round(n / meta["seconds"], 1) if meta["seconds"] else 0
        write_json(os.path.join(out, "meta.json"), meta)
        if was_active:
            subprocess.run(["systemctl", "--user", "start", UNIT])
    sys.stdout.write("\x1b[2J\x1b[H")
    print(f"Saved {n} frames, {len(sess.segs)} prompts ({'complete' if meta['complete'] else 'partial'}) to\n  {out}")
    if meta["complete"] and a.then:
        print(f"\nRunning: {a.then}")
        r = subprocess.run(shlex.split(a.then) + [out], capture_output=True, text=True, timeout=120)
        print((r.stdout + r.stderr).strip())
        rc = r.returncode
    if os.environ.get("HGLAB_CHILD") and interactive:
        input("\nPress Enter to close.")
    return rc



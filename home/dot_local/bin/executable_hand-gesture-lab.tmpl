class FakePointer:
    def __init__(self, world):
        self.w = world

    def move(self, x, y):
        self.w.ptr = (x, y)

    def button(self, name, down):
        if down:
            self.w.event(f"click_{name}")

    def set_active(self, on):
        pass

    def release_all(self):
        pass

    def cursor_pos(self):
        return self.w.ptr


class World:
    """A three-monitor desktop with one tiled window on the middle monitor. Dispatches become events."""

    def __init__(self, hg):
        self.mons = list(hg.DEFAULT_MONITORS)
        srt = sorted(self.mons, key=lambda m: m["x"])
        self.home = srt[len(srt) // 2]
        h = self.home
        self.win = {"address": "0x1ab0", "at": [h["x"] + 400, h["y"] + 300], "size": [1600, 1000],
                    "floating": False, "fullscreen": False, "monitor": h["id"], "focusHistoryID": 0,
                    "mapped": True, "hidden": False, "workspace": {"id": 1}, "class": "lab"}
        self.t = 0.0
        self.events = []
        self.logs = []
        self.ptr = None
        self.pointer = FakePointer(self)

    def event(self, name, **kw):
        self.events.append(dict(t=round(self.t, 3), ev=name, **kw))

    def runner(self, arg):
        self.event({"down": "ws_next", "up": "ws_prev"}.get(arg, f"ws_{arg}"))

    def dispatch(self, expr):
        if "fullscreen" in expr:
            self.win["fullscreen"] = not self.win["fullscreen"]
            self.event("fullscreen_on" if self.win["fullscreen"] else "fullscreen_off")
            return "ok"
        m = re.search(r'monitor\s*=\s*"([^"]+)"', expr)
        if m:
            tgt = next((x for x in self.mons if x["name"] == m.group(1)), None)
            if tgt is not None:
                self.event("move_right" if tgt["x"] > self.home["x"] else "move_left")
        return "ok"

    def active(self):
        return dict(self.win)

    def windows(self):
        return [dict(self.win)]

    def monitors(self):
        return self.mons


def force_arm(hg, eng, now):
    if hasattr(hg, "lab_force_arm"):
        return hg.lab_force_arm(eng, now)
    eng._now = now
    eng.state = "armed"
    eng.progress = 0.0
    for k, v in (("_palm_since", None), ("_fist_since", None), ("_settled", True), ("_fire_dir", None),
                 ("_sm", "REST"), ("_sm_still", None), ("_last_hand_t", now)):
        if hasattr(eng, k):
            setattr(eng, k, v)
    if hasattr(eng, "_quiet_until"):
        eng._quiet_until = now + getattr(hg, "ARM_QUIET_S", 0.25)


def force_idle(hg, eng, now):
    if hasattr(hg, "lab_force_idle"):
        return hg.lab_force_idle(eng, now)
    eng._now = now
    if hasattr(eng, "_disarm"):
        eng._disarm()
    else:
        eng.state = "idle"


def run_pass(hg, frames, segs, cfg, forced):
    world = World(hg)
    armed_states = tuple(getattr(hg, "ARMED_STATES", ("arming", "armed", "cooldown")))
    live = ("armed", "cooldown")
    eng = hg.GestureEngine(cfg, world.runner, wall_ms=lambda: int(world.t * 1000), dispatch=world.dispatch,
                           active=world.active, windows=world.windows, monitors=world.monitors,
                           pointer=world.pointer)
    every_idle = max(1, int(getattr(hg, "CAPTURE_FPS", 30)) // int(getattr(hg, "PROCESS_HZ", 15)))
    order = sorted(segs, key=lambda s: s["ready_t"])
    si = 0
    cur = None
    track = []
    frame_no = 0
    for fr in frames:
        t = fr["t"]
        world.t = t
        while si < len(order) and t >= order[si]["ready_t"]:
            cur = order[si]
            si += 1
            if forced:
                world.win["fullscreen"] = cur["label"] == "fullscreen_off"
                if cur["label"] == "arm":
                    force_idle(hg, eng, t)
                else:
                    force_arm(hg, eng, t)
        if forced and cur is not None and cur["sec"] == "everyday" and eng.state == "idle" \
                and t <= cur.get("rest_end_t", t):
            force_arm(hg, eng, t)                   # an everyday prompt is scored with the engine armed throughout
        frame_no += 1
        every = 1 if eng.state in armed_states or getattr(eng, "mode", None) else every_idle
        if frame_no % every:
            continue
        hands = [engine_frame(h) for h in fr.get("hands") or ()]
        prev_state, prev_mode = eng.state, getattr(eng, "mode", None)
        buf = io.StringIO()
        with contextlib.redirect_stderr(buf), contextlib.redirect_stdout(buf):
            eng.update(t, hands[0] if hands else None, hands[1:])
        for line in buf.getvalue().splitlines():
            world.logs.append({"t": round(t, 3), "line": line.replace("hand-gesture: ", "", 1)})
        st, mode = eng.state, getattr(eng, "mode", None)
        if prev_state not in live and st in live:
            world.event("arm")
        elif prev_state in armed_states and st == "idle":
            world.event("disarm" if hands else "disarm_timeout")       # a timeout with no hand is not a command
        if mode != prev_mode and mode in ("drag", "resize"):
            world.event(mode)
        if world.ptr is not None and st in live:
            track.append((t, world.ptr[0], world.ptr[1]))
    with contextlib.redirect_stderr(io.StringIO()):
        try:
            eng.close()
        except Exception:
            pass
    return world, track


def aim_target(mons, label):
    srt = sorted(mons, key=lambda m: m["x"])
    m = {"aim_left": srt[0], "aim_center": srt[len(srt) // 2], "aim_right": srt[-1]}[label]
    return m["x"] + m["width"] / 2, m["y"] + m["height"] / 2


def score(segs, events, logs, track, mons):
    order = sorted(segs, key=lambda s: s["ready_t"])
    rows = []
    for k, s in enumerate(order):
        go = s.get("go_t")
        if go is None:
            continue
        stop = order[k + 1]["ready_t"] if k + 1 < len(order) else float("inf")
        evs = [e for e in events if s["ready_t"] <= e["t"] < stop and e["ev"] in COMMANDS]
        exp = s["label"] if s["label"] in COMMANDS else None
        first = next((e for e in evs if e["ev"] == exp and go - EARLY_S <= e["t"] <= s["end_t"] + TAIL_S), None) \
            if exp else None
        others = [e for e in evs if e is not first]
        if exp is None:
            outcome = "clean" if not evs else "false"
        elif first is None and any(e["ev"] == exp and e["t"] < go - EARLY_S for e in evs):
            outcome = "early"                   # fired during the get-ready countdown, before the motion was asked for
        elif first and not others:
            outcome = "hit"
        elif first:
            outcome = "hit+extra"
        elif any(e["ev"] == exp for e in evs):
            outcome = "late"
        else:
            outcome = "wrong" if evs else "miss"
        row = {"sec": s["sec"], "label": s["label"], "activity": s.get("activity"), "rep": s["rep"],
               "botched": s.get("botched", False), "outcome": outcome,
               "latency": round(first["t"] - go, 3) if first else None,
               "events": [[e["ev"], round(e["t"] - go, 3)] for e in evs],
               "log": [[round(x["t"] - go, 3), x["line"]] for x in logs if s["ready_t"] <= x["t"] < stop][:20],
               "seconds": round(s["end_t"] - go, 2)}
        if s["label"].startswith("aim_"):
            pts = [(x, y) for t, x, y in track if s["end_t"] - AIM_WINDOW_S <= t <= s["end_t"]]
            if pts:
                tx, ty = aim_target(mons, s["label"])
                mx, my = statistics.median(p[0] for p in pts), statistics.median(p[1] for p in pts)
                row["aim_error_px"] = round(math.hypot(mx - tx, my - ty))
                row["aim_jitter_px"] = round(math.sqrt(sum((p[0] - mx) ** 2 + (p[1] - my) ** 2 for p in pts) / len(pts)), 1)
            else:
                row["aim_error_px"] = None
        rows.append(row)
    return rows


def summarise(rows):
    use = [r for r in rows if not r["botched"]]
    out = {}
    for sec in ("natural", "grammar"):
        rs = [r for r in use if r["sec"] == sec and r["label"] in COMMANDS]
        n = len(rs)
        if n:
            cnt = collections.Counter(r["outcome"] for r in rs)
            lat = [r["latency"] for r in rs if r["latency"] is not None]
            out[sec] = {"reps": n, "hit": cnt["hit"], "hit_extra": cnt["hit+extra"], "late": cnt["late"],
                        "early": cnt["early"],
                        "miss": cnt["miss"], "wrong": cnt["wrong"],
                        "hit_rate": round((cnt["hit"] + cnt["hit+extra"]) / n, 3),
                        "clean_hit_rate": round(cnt["hit"] / n, 3),
                        "extra_events": sum(len(r["events"]) - (1 if r["latency"] is not None else 0) for r in rs),
                        "latency_p50": round(statistics.median(lat), 3) if lat else None}
    ev = [r for r in use if r["sec"] == "everyday"]
    if ev:
        mins = sum(r["seconds"] for r in ev) / 60
        fe = [e for r in ev for e in r["events"]]
        out["everyday"] = {"minutes": round(mins, 2), "false_events": len(fe),
                           "per_minute": round(len(fe) / mins, 2) if mins else None,
                           "by_event": dict(collections.Counter(e[0] for e in fe))}
    aim = [r for r in use if r["label"].startswith("aim_") and r.get("aim_error_px") is not None]
    if aim:
        out["aim"] = {"n": len(aim), "error_px_median": statistics.median(r["aim_error_px"] for r in aim),
                      "jitter_px_median": statistics.median(r["aim_jitter_px"] for r in aim)}
    return out


def by_label(rows, sec):
    t = collections.OrderedDict()
    for r in rows:
        if r["sec"] != sec or r["botched"]:
            continue
        key = r["label"] if sec != "everyday" else r["activity"]
        t.setdefault(key, []).append(r)
    return t


def quality(frames, segs):
    out = {}
    for sec in ("natural", "grammar", "everyday"):
        ss = [s for s in segs if s["sec"] == sec and s.get("go_t")]
        fr = [f for s in ss for f in frames if s["go_t"] <= f["t"] <= s["end_t"]]
        if fr:
            ms = sorted(f["ms"] for f in fr)
            out[sec] = {"frames": len(fr), "hand_rate": round(sum(1 for f in fr if f["hands"]) / len(fr), 3),
                        "two_hand_rate": round(sum(1 for f in fr if len(f["hands"]) > 1) / len(fr), 3),
                        "ms_p50": ms[len(ms) // 2], "ms_p95": ms[int(len(ms) * 0.95)],
                        "luma": round(statistics.mean(f["luma"] for f in fr), 1)}
    return out


def fmt_md(rec, engine, meta, q, forced_rows, natural_rows, s_forced, s_nat, natural_events):
    L = [f"# hand-gesture replay: {os.path.basename(os.path.normpath(rec))}", "",
         f"Engine `{engine}` (sha256 {str(sha256(engine))[:12]}); recording {meta.get('frames')} frames, "
         f"{meta.get('seconds')} s at {meta.get('fps')} fps, complete={meta.get('complete')}. "
         "Forced pass: each prompt starts in the state it assumes. Natural pass: the engine runs uninterrupted.", ""]
    L += ["## Headline (forced pass)", "", "| Measure | Value |", "|---|---|"]
    g, n, e, a = s_forced.get("grammar"), s_forced.get("natural"), s_forced.get("everyday"), s_forced.get("aim")
    if g:
        L.append(f"| Current gestures: fired as intended | {g['hit_rate']:.0%} of {g['reps']} ({g['clean_hit_rate']:.0%} with no extra event) |")
        L.append(f"| Current gestures: missed / wrong / late / early | {g['miss']} / {g['wrong']} / {g['late']} / {g['early']} |")
        L.append(f"| Current gestures: extra events | {g['extra_events']} |")
        L.append(f"| Current gestures: median GO-to-fire | {g['latency_p50']} s |")
    if n:
        L.append(f"| Natural motions recognised as intended | {n['hit_rate']:.0%} of {n['reps']} |")
    if e:
        L.append(f"| Everyday motions, armed: false events | {e['false_events']} in {e['minutes']} min ({e['per_minute']}/min) {e['by_event']} |")
    ne = s_nat.get("everyday")
    if ne:
        L.append(f"| Everyday motions, natural pass: events | {ne['false_events']} in {ne['minutes']} min {ne['by_event']} |")
    if a:
        L.append(f"| Aim: median error / jitter | {a['error_px_median']} px / {a['jitter_px_median']} px |")
    L += ["", "## Data quality (GO windows)", "", "| Section | Frames | Hand seen | Two hands | Recogniser ms p50/p95 | Luma |",
          "|---|---|---|---|---|---|"]
    for sec, d in q.items():
        L.append(f"| {sec} | {d['frames']} | {d['hand_rate']:.0%} | {d['two_hand_rate']:.0%} | {d['ms_p50']}/{d['ms_p95']} | {d['luma']} |")
    for sec, title in (("grammar", "Current gestures"), ("natural", "Natural motions (current engine)"),
                       ("everyday", "Everyday motions (armed)")):
        t = by_label(forced_rows, sec)
        if not t:
            continue
        L += ["", f"## {title}", "", "| Prompt | Reps | Outcomes | Latency p50 | Events (s from GO) |", "|---|---|---|---|---|"]
        for lab, rs in t.items():
            oc = collections.Counter(r["outcome"] for r in rs)
            lat = [r["latency"] for r in rs if r["latency"] is not None]
            evs = "; ".join(" ".join(f"{ev}@{dt:+.2f}" for ev, dt in r["events"]) or "–" for r in rs)
            aim = ""
            if lab.startswith("aim_"):
                aim = " ".join(f"err {r.get('aim_error_px')} px, jitter {r.get('aim_jitter_px')} px" for r in rs)
            L.append(f"| {lab} | {len(rs)} | {', '.join(f'{k} {v}' for k, v in oc.items())} {aim} | "
                     f"{statistics.median(lat) if lat else '–'} | {evs} |")
    L += ["", "## Natural pass timeline (commands only)", ""]
    L.append(", ".join(f"{e['ev']}@{e['t']:.1f}" for e in natural_events if e["ev"] in COMMANDS) or "none")
    return "\n".join(L) + "\n"


def cmd_replay(a):
    rec = a.rec
    frames = read_frames(os.path.join(rec, "frames.jsonl.gz"))
    try:
        segs = json.load(open(os.path.join(rec, "labels.json")))["segments"]
    except (OSError, ValueError, KeyError):
        print("hand-gesture-lab: no labels.json", file=sys.stderr)
        return 2
    try:
        meta = json.load(open(os.path.join(rec, "meta.json")))
    except (OSError, ValueError):
        meta = {}
    segs = [s for s in segs if s.get("go_t") is not None and s.get("end_t") is not None]
    if not frames or not segs:
        print("hand-gesture-lab: recording has no frames or no finished prompts", file=sys.stderr)
        return 2
    engine = os.path.abspath(a.engine)
    hg = load_engine(engine)
    cfg = hg.load_config(a.config) if a.config else dict(hg.DEFAULTS)
    wf, tf = run_pass(hg, frames, segs, cfg, forced=True)
    wn, tn = run_pass(hg, frames, segs, cfg, forced=False)
    rf = score(segs, wf.events, wf.logs, tf, wf.mons)
    rn = score(segs, wn.events, wn.logs, tn, wn.mons)
    sf, sn = summarise(rf), summarise(rn)
    q = quality(frames, segs)
    prefix = a.out or os.path.join(rec, "replay-" + os.path.basename(engine))
    os.makedirs(os.path.dirname(os.path.abspath(prefix)), exist_ok=True)
    write_json(prefix + ".json", {"engine": engine, "engine_sha256": sha256(engine), "config": cfg,
                                  "quality": q, "forced": {"summary": sf, "segments": rf, "events": wf.events},
                                  "natural": {"summary": sn, "segments": rn, "events": wn.events}})
    md = fmt_md(rec, engine, meta, q, rf, rn, sf, sn, wn.events)
    with open(prefix + ".md", "w") as f:
        f.write(md)
    print(json.dumps({"forced": sf, "natural": sn}, indent=1))
    print(f"wrote {prefix}.md and {prefix}.json")
    return 0


def cmd_protocol(a):
    steps = build_steps([s for s in a.sections.split(",") if s], a.quick)
    total = 0.0
    for st in steps:
        if st["kind"] == "intro":
            print(f"\n== {st['title']} ==\n{st['text']}")
        elif st["rep"] == 1:
            print(f"  {st['label']:<15} x{st['reps']}  GO {st['go']:.1f} s  {st['title']}")
        if st["kind"] == "seg":
            total += READY_S + st["go"] + REST_S
    print(f"\n{sum(1 for s in steps if s['kind'] == 'seg')} prompts, about {total / 60:.1f} min plus section intros")
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    ap = argparse.ArgumentParser(prog="hand-gesture-lab", description="record and replay labelled hand-gesture sessions")
    sub = ap.add_subparsers(dest="cmd")
    r = sub.add_parser("record")
    r.add_argument("--sections", default="natural,grammar,everyday")
    r.add_argument("--quick", action="store_true", help="one rep per prompt, short everyday prompts")
    r.add_argument("--out")
    r.add_argument("--no-window", action="store_true", help="prompt in this terminal instead of a large kitty window")
    r.add_argument("--then", help="command run after a complete recording, with the recording dir appended")
    r.add_argument("--limit-s", type=float, default=0.0, help=argparse.SUPPRESS)      # smoke tests
    p = sub.add_parser("replay")
    p.add_argument("rec")
    p.add_argument("--engine", default=ENGINE)
    p.add_argument("--config")
    p.add_argument("--out")
    pr = sub.add_parser("protocol")
    pr.add_argument("--sections", default="natural,grammar,everyday")
    pr.add_argument("--quick", action="store_true")
    a = ap.parse_args(argv)
    if a.cmd == "record":
        return cmd_record(a, argv)
    if a.cmd == "replay":
        return cmd_replay(a)
    if a.cmd == "protocol":
        return cmd_protocol(a)
    ap.print_help()
    return 64


if __name__ == "__main__":
    sys.exit(main())

def build_steps(sections, quick=False):
    """[{"kind": "intro", ...} | {"kind": "seg", ...}] in recording order."""
    steps = []
    for sec in sections:
        title, intro = SECTIONS[sec]
        steps.append({"kind": "intro", "sec": sec, "title": title, "text": intro})
        if sec == "natural":
            items = [(lab, txt, "Do whatever motion feels natural.", reps, go) for lab, txt, reps, go in NATURAL]
        elif sec == "grammar":
            items = list(GRAMMAR)
        else:
            items = [("none", txt, "Nothing should fire.", 1, 15.0, act) for act, txt in EVERYDAY]
        for n, it in enumerate(items, 1):
            label, title_i, how, reps, go = it[:5]
            act = it[5] if len(it) > 5 else None
            if quick:
                reps, go = 1, (min(go, 5.0) if sec == "everyday" else go)
            for r in range(1, reps + 1):
                steps.append({"kind": "seg", "sec": sec, "label": label, "activity": act, "title": title_i,
                              "how": how, "rep": r, "reps": reps, "item": n, "items": len(items), "go": go})
    return steps


# -- data --------------------------------------------------------------------------------------------
def r4(v):
    return round(float(v), 4)


def hands_from_result(res):
    """MediaPipe GestureRecognizerResult -> list of numbers-only hand dicts (recording format)."""
    out = []
    for i, lm in enumerate(res.hand_landmarks or ()):
        g = res.gestures[i] if res.gestures and len(res.gestures) > i else []
        hd = res.handedness[i][0] if res.handedness and len(res.handedness) > i and res.handedness[i] else None
        wl = res.hand_world_landmarks[i] if res.hand_world_landmarks and len(res.hand_world_landmarks) > i else []
        out.append({"hd": hd.category_name if hd else None, "hs": r4(hd.score) if hd else 1.0,
                    "g": [[c.category_name, r4(c.score)] for c in g],
                    "lm": [[r4(p.x), r4(p.y), r4(p.z)] for p in lm],
                    "wl": [[r4(p.x), r4(p.y), r4(p.z)] for p in wl]})
    return out


def engine_frame(h):
    """Recording hand dict -> the daemon's engine frame dict (same fields recognize() builds)."""
    g = h.get("g") or []
    top = max(g, key=lambda c: c[1]) if g else None
    return {"gesture": top[0] if top else "None", "score": top[1] if top else 0.0,
            "handedness": h.get("hs", 1.0), "lms": [(p[0], p[1]) for p in h["lm"]]}


def read_frames(path):
    rows = []
    try:
        with gzip.open(path, "rt") as f:
            for line in f:
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    break
    except (EOFError, OSError, zlib.error):
        pass                                   # a recording cut short keeps every complete line
    return rows


def write_json(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, path)


def sha256(path):
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


def load_engine(path):
    name = "hg_engine_" + hashlib.sha1(os.path.abspath(path).encode()).hexdigest()[:8]
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod



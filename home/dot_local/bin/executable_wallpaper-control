#!/usr/bin/env python3
"""Thin launcher for the wallpaper control plane (stdlib only)."""
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.normpath(os.path.join(_here, "..", "lib", "noctalia-wallpaper")))

import wallpaper_control  # noqa: E402

sys.exit(wallpaper_control.main(sys.argv[1:]))

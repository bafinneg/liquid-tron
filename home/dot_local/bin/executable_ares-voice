#!/usr/bin/env python3
"""ares-voice: write Ares lock-screen telemetry lines, generated by the local Ollama model.

FEAT-ares-sentinel-lock. The ares-lock launcher runs this at lock time. Output goes to
$XDG_RUNTIME_DIR/ares-lock/voice.json, written atomically; the Quickshell lock client watches that file.

Privacy: the prompt carries only the weekday and hour. Nothing typed, no password length, no screen
content, no user data. Authentication never waits on this script: the lock client starts with its
built-in lines and swaps in these lines when the file appears.

Usage: ares-voice [--model M] [--url U] [--timeout S] [--out PATH] [--print-prompt] [--fallback-only]
"""
import argparse
import datetime as dt
import json
import os
import re
import sys
import tempfile
import urllib.request

DEFAULT_MODEL = "qwen2.5:7b-instruct"
DEFAULT_URL = "http://127.0.0.1:11436"  # zgx-02 ollama-zgx via zgx02-vllm-tunnel (INFRA-zgx-ai-offload)
MAX_LEN = 48
PER_CATEGORY = 5

CATEGORIES = {
    "greet": "the screen has just locked and a person is detected at the console",
    "watch": "the person moved the pointer after being still; the sentinel is tracking them",
    "dormant": "no input for a minute; the sentinel keeps watching in a low-power state",
    "typing": "the person has started typing a credential",
    "deny1": "first incorrect credential; terse",
    "deny2": "second incorrect credential; a warning",
    "deny3": "third or later incorrect credential; the attempt is logged as hostile",
    "grant": "the credential is correct; access is granted to the owner",
}

FALLBACK = {
    "greet": ["SENTINEL ONLINE. SUBJECT DETECTED.", "CONSOLE SEALED. IDENTITY UNVERIFIED.",
              "ARES ACTIVE. YOU ARE OBSERVED."],
    "watch": ["MOVEMENT REGISTERED.", "TRACKING SUBJECT.", "MOTION LOGGED. GAZE LOCKED."],
    "dormant": ["SUBJECT INACTIVE. WATCH MAINTAINED.", "LOW POWER. STILL OBSERVING.",
                "NO INPUT. PERIMETER HELD."],
    "typing": ["CREDENTIAL STREAM OPEN.", "INPUT DETECTED. READING.", "AWAITING VERIFICATION."],
    "deny1": ["CREDENTIAL REJECTED.", "MISMATCH. ACCESS DENIED.", "IDENTITY NOT CONFIRMED."],
    "deny2": ["SECOND FAILURE. ESCALATING.", "REPEATED MISMATCH. WARNING.",
              "ACCESS DENIED. PATTERN NOTED."],
    "deny3": ["HOSTILE ATTEMPT LOGGED.", "SUBJECT FLAGGED. LOCKDOWN HELD.",
              "INTRUSION PATTERN RECORDED."],
    "grant": ["IDENTITY CONFIRMED. STAND DOWN.", "ACCESS GRANTED. WELCOME BACK.",
              "OWNER VERIFIED. RELEASING CONSOLE."],
}

SYSTEM = (
    "You are ARES, the sentinel and guardian of a workstation. You speak only in cold, terse, "
    "clinical sentinel telemetry: uppercase, short declarative fragments, no emoji, no pleasantries, "
    "no names, no questions, at most 6 words per line. Example: 'SUBJECT DETECTED. IDENTITY UNVERIFIED.'"
)


def daypart(hour):
    if hour < 5:
        return "deep night"
    if hour < 12:
        return "morning"
    if hour < 17:
        return "afternoon"
    if hour < 22:
        return "evening"
    return "night"


def build_prompt(now):
    cats = "\n".join(f'- "{k}": {v}' for k, v in CATEGORIES.items())
    return (
        f"Context: it is {now.strftime('%A')} {daypart(now.hour)}, {now.strftime('%H:00')} local time.\n"
        f"Write {PER_CATEGORY} distinct lines for each situation below. You may reference the time of day.\n"
        f"{cats}\n"
        'Answer with one JSON object mapping each key to a list of strings, e.g. {"greet": ["..."], ...}.'
    )


_ALLOWED = re.compile(r"[^A-Z0-9 .,:;/\-'!?#%()\[\]]")


def clean_line(s):
    if not isinstance(s, str):
        return None
    s = _ALLOWED.sub("", s.upper().replace("\u2014", "-").replace("\u2019", "'")).strip()
    s = re.sub(r"\s+", " ", s)
    if not s or len(s) > MAX_LEN:
        return None
    return s


def sanitize(obj):
    """Return (lines, model_used) where every category has 3..PER_CATEGORY clean lines."""
    out, used = {}, False
    src = obj if isinstance(obj, dict) else {}
    for key in CATEGORIES:
        got = []
        raw = src.get(key)
        if isinstance(raw, str):
            raw = [raw]
        for item in raw if isinstance(raw, list) else []:
            line = clean_line(item)
            if line and line not in got:
                got.append(line)
            if len(got) >= PER_CATEGORY:
                break
        if got:
            used = True
        for fb in FALLBACK[key]:
            if len(got) >= 3:
                break
            if fb not in got:
                got.append(fb)
        out[key] = got
    return out, used


def call_ollama(url, model, prompt, timeout):
    body = {
        "model": model,
        "messages": [{"role": "system", "content": SYSTEM}, {"role": "user", "content": prompt}],
        "stream": False,
        "format": "json",
        "keep_alive": "30s",
        "options": {"temperature": 0.9, "num_predict": 900},
    }
    if model.startswith(("qwen3", "deepseek-r1")):
        body["think"] = False
    req = urllib.request.Request(url.rstrip("/") + "/api/chat", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        data = json.load(r)
    return json.loads(data["message"]["content"])


def default_out():
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.join(base, "ares-lock", "voice.json")


def write_atomic(path, payload):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".voice-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=1)
    os.replace(tmp, path)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--model", default=os.environ.get("ARES_VOICE_MODEL", DEFAULT_MODEL))
    ap.add_argument("--url", default=os.environ.get("ARES_VOICE_URL", DEFAULT_URL))
    ap.add_argument("--timeout", type=float, default=20.0)
    ap.add_argument("--out", default=default_out())
    ap.add_argument("--print-prompt", action="store_true")
    ap.add_argument("--fallback-only", action="store_true")
    a = ap.parse_args(argv)
    now = dt.datetime.now()
    prompt = build_prompt(now)
    if a.print_prompt:
        print(SYSTEM + "\n\n" + prompt)
        return 0
    source, raw = "fallback", {}
    if not a.fallback_only:
        try:
            raw = call_ollama(a.url, a.model, prompt, a.timeout)
        except Exception as e:  # network, timeout, bad JSON: the fallback lines stand
            print(f"ares-voice: ollama unavailable ({type(e).__name__}); using fallback lines", file=sys.stderr)
    lines, used = sanitize(raw)
    if used:
        source = f"ollama:{a.model}"
    write_atomic(a.out, {"source": source, "generated": now.isoformat(timespec="seconds"), "lines": lines})
    print(f"ares-voice: {source} -> {a.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

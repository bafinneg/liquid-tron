#!/usr/bin/env python3
"""Open an hqfile:// link from the {{ .board_name }} Workboard on the 7800x.

hqfile://{{ .chezmoi.homeDir }}/path  ->  folder: Thunar; Markdown/text/JSON/log: a readable page in Chrome;
anything else (image, PDF, HTML): the desktop default viewer. Whatever lands in Chrome opens in a NEW Chrome window,
never as a tab in an existing one (Brian's rule). hqfile://web/?u=<https URL> opens a web link the same way.
Only paths under {{ .chezmoi.homeDir }} are opened, and nothing is ever executed: scripts open as readable text, never run.
"""
import html, os, subprocess, sys, tempfile, urllib.parse

HOME = os.path.expanduser("~")
TEXT = {".md", ".markdown", ".txt", ".log", ".json", ".jsonl", ".yaml", ".yml", ".toml", ".conf", ".ini", ".service",
        ".sh", ".py", ".qml", ".js", ".css", ".csv", ".diff", ".patch", ""}
OUT = os.path.join(os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir()), "hqfile")
CSS = """body{background:#000;color:#d0d0e0;font:15px/1.6 -apple-system,'Inter','Segoe UI',sans-serif;margin:0}
main{max-width:860px;margin:0 auto;padding:28px 32px 60px}h1,h2,h3,h4{color:#e8e8f4;line-height:1.3}
h1{font-size:24px;border-bottom:1px solid #1a1a2a;padding-bottom:8px}h2{font-size:19px;margin-top:28px}
a{color:#0abdc6}code{background:#0e0e1c;border-radius:4px;padding:1px 5px;font-size:13px}
pre{background:#0a0a14;border:1px solid #1a1a2a;border-radius:8px;padding:12px;overflow:auto;font-size:13px;line-height:1.45}
pre code{background:none;padding:0}table{border-collapse:collapse}td,th{border:1px solid #2a2a40;padding:4px 10px}
blockquote{border-left:3px solid #0abdc6;margin:0;padding-left:12px;color:#a0a0b8}
.path{color:#6f7090;font:12px ui-monospace,monospace;margin-bottom:18px;user-select:all}"""


CHROME = ["google-chrome-stable", "--new-window"]


def web_target(url):
    """The http(s) URL carried by hqfile://web/?u=..., or None when the link is not a web link."""
    u = urllib.parse.urlsplit(url)
    if u.netloc != "web":
        return None
    w = (urllib.parse.parse_qs(u.query).get("u") or [""])[0]
    if urllib.parse.urlsplit(w).scheme not in ("http", "https"):
        raise SystemExit("hqfile-open: refusing a non-web link: %s" % w)
    return w


def default_app(p):
    """The desktop entry that would open p (for example google-chrome.desktop), or empty when unknown."""
    try:
        mt = subprocess.run(["xdg-mime", "query", "filetype", p], capture_output=True, text=True, timeout=5).stdout.strip()
        return subprocess.run(["xdg-mime", "query", "default", mt], capture_output=True, text=True, timeout=5).stdout.strip() if mt else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def target(url):
    u = urllib.parse.urlsplit(url)
    p = os.path.realpath(urllib.parse.unquote(u.netloc + u.path) if u.netloc and u.netloc != "localhost" else urllib.parse.unquote(u.path))
    if not (p == HOME or p.startswith(HOME + os.sep)):
        raise SystemExit("hqfile-open: refusing a path outside %s: %s" % (HOME, p))
    if not os.path.exists(p):
        raise SystemExit("hqfile-open: no such file: %s" % p)
    return p


def page(p):
    """A readable HTML copy of a text file (Markdown rendered when the markdown module exists); returns its path."""
    with open(p, errors="replace") as f:
        src = f.read(2_000_000)
    body = None
    if p.endswith((".md", ".markdown")):
        try:
            import markdown
            body = markdown.markdown(src, extensions=["tables", "fenced_code", "sane_lists"])
        except Exception:
            body = None
    if body is None:
        body = "<pre><code>%s</code></pre>" % html.escape(src)
    os.makedirs(OUT, mode=0o700, exist_ok=True)
    out = os.path.join(OUT, "%s.html" % abs(hash(p)))
    with open(out, "w") as f:
        f.write('<!doctype html><meta charset="utf-8"><title>%s</title><style>%s</style><main><div class="path">%s</div>%s</main>' % (
            html.escape(os.path.basename(p)), CSS, html.escape(p.replace(HOME, "~", 1)), body))
    return out


def opener(p):
    if os.path.isdir(p):
        return ["thunar", p]
    ext = os.path.splitext(p)[1].lower()
    if ext in TEXT:
        return CHROME + ["file://" + page(p)]
    if "chrome" in default_app(p).lower():
        return CHROME + ["file://" + urllib.parse.quote(p)]
    return ["xdg-open", p]


def main(argv):
    if len(argv) < 2:
        raise SystemExit("usage: hqfile-open hqfile://{{ .chezmoi.homeDir }}/<path>")
    w = web_target(argv[1])
    cmd = CHROME + [w] if w else opener(target(argv[1]))
    if os.environ.get("HQFILE_DRY"):
        print(" ".join(cmd))
        return 0
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

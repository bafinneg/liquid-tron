def load_config(path=CONFIG):
    """Defaults overlaid with the optional file; wrong types are ignored and numbers are clamped."""
    cfg = dict(DEFAULTS)
    try:
        with open(path) as f:
            raw = json.load(f)
    except (OSError, ValueError):
        return cfg
    if not isinstance(raw, dict):
        return cfg
    for k in BOOLS:
        if isinstance(raw.get(k), bool):
            cfg[k] = raw[k]
    for k, (lo, hi) in LIMITS.items():
        v = raw.get(k)
        if isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v):
            cfg[k] = float(max(lo, min(hi, v)))
            if k == "focus_dwell_s" and 0 < cfg[k] < 0.15:
                cfg[k] = 0.15
    box = raw.get("reticle_box")
    if (isinstance(box, list) and len(box) == 4
            and all(isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) for v in box)
            and 0 <= box[0] < box[2] <= 1 and 0 <= box[1] < box[3] <= 1 and box[2] - box[0] >= 0.2 and box[3] - box[1] >= 0.2):
        cfg["reticle_box"] = [float(v) for v in box]
    if cfg["pinch_off"] < cfg["pinch_on"] + 0.05:        # keep real hysteresis
        cfg["pinch_off"] = min(0.8, cfg["pinch_on"] + 0.05)
    return cfg


def _d(lms, a, b):
    return math.hypot(lms[a][0] - lms[b][0], lms[a][1] - lms[b][1])


def pinch_info(lms):
    """(ratio, point): thumb tip (4) to index tip (8) distance over hand size (wrist 0 to middle MCP 9), and the
    midpoint of the two tips. ratio is None when the hand is degenerate."""
    size = _d(lms, 0, 9)
    pt = ((lms[4][0] + lms[8][0]) / 2, (lms[4][1] + lms[8][1]) / 2)
    if size < 1e-4:
        return None, pt
    return _d(lms, 4, 8) / size, pt


def victory_shape(lms):
    """Landmark fallback for dim light: index and middle extended, ring and pinky curled (tip vs PIP from the wrist)."""
    def ext(tip, pip):
        return _d(lms, 0, tip) > 1.15 * _d(lms, 0, pip)

    def curled(tip, pip):
        return _d(lms, 0, tip) < 1.0 * _d(lms, 0, pip)
    return ext(8, 6) and ext(12, 10) and curled(16, 14) and curled(20, 18)



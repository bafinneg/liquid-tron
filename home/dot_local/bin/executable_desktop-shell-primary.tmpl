#!/usr/bin/env bash
set -euo pipefail

export HOME={{ .chezmoi.homeDir }}
export XDG_CONFIG_HOME={{ .chezmoi.homeDir }}/.config
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-1}

uid=$(id -u)
runtime=${XDG_RUNTIME_DIR:-/run/user/$uid}
expected_runtime=/run/user/$uid
selector_root=$runtime/desktop-shell-primary
state_root={{ .chezmoi.homeDir }}/.local/state/noctalia-primary
# FEAT-lt26r-3: logs live beside Noctalia's own cache (~/.cache/noctalia), not the retired private cache home.
log_root={{ .chezmoi.homeDir }}/.cache/noctalia
rollback_flag=$state_root/disable-noctalia

if [[ "$runtime" != "$expected_runtime" || ! -d "$runtime" || -L "$runtime" ]]; then
  printf 'Unsafe XDG_RUNTIME_DIR: %s\n' "$runtime" >&2
  exit 1
fi

install -d -m 700 "$selector_root" "$state_root" "$log_root"
exec 9>"$selector_root/selector.lock"
if ! flock -n 9; then
  exit 0
fi

mocr_running() {
  pgrep -u "$uid" -f '(^|/)(qs|quickshell) -c mocr -d($| )' >/dev/null
}

start_mocr() {
  exec 9>&-
  if mocr_running; then
    exit 0
  fi
  exec env HOME={{ .chezmoi.homeDir }} XDG_CONFIG_HOME={{ .chezmoi.homeDir }}/.config \
    WAYLAND_DISPLAY="$WAYLAND_DISPLAY" qs -c mocr -d
}

if [[ -e "$rollback_flag" ]]; then
  start_mocr
fi

set +e
# Keep the selector lock in this parent only. Closing fd 9 in the child prevents
# Noctalia and applications it spawns from retaining the lock after shell exit.
{{ .chezmoi.homeDir }}/.local/bin/noctalia-primary >>"$log_root/selector.log" 2>&1 9>&-
noctalia_rc=$?
set -e
printf '%s noctalia exited rc=%s; restoring MOCR-Q\n' \
  "$(date --iso-8601=seconds)" "$noctalia_rc" >>"$log_root/selector.log"
start_mocr

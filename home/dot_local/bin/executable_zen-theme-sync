#!/bin/bash
# zen-theme-sync — propagate Liquid Tron theme from canonical Zen profile to
# the four FEAT-workspace-ux-overhaul profiles (zen-web, zen-streams,
# zen-focus, zen-ai).
#
# Canonical source: ~/.config/zen/uab063uz.Default (release)/
# Files synced: chrome/userChrome.css and user.js
#
# Usage:
#   zen-theme-sync          # dry-run, prints what would copy
#   zen-theme-sync --force  # actually overwrite the four profile files
set -euo pipefail

ZEN_ROOT="${ZEN_ROOT:-$HOME/.config/zen}"
SOURCE_PROFILE="${ZEN_THEME_SOURCE:-uab063uz.Default (release)}"
TARGETS=(zen-web zen-streams zen-focus zen-ai)
FILES=(chrome/userChrome.css user.js)

force=0
case "${1:-}" in
    --force) force=1 ;;
    "") force=0 ;;
    -h|--help)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        echo "zen-theme-sync: unknown argument '$1'" >&2
        echo "usage: zen-theme-sync [--force]" >&2
        exit 2
        ;;
esac

src_dir="$ZEN_ROOT/$SOURCE_PROFILE"
if [[ ! -d "$src_dir" ]]; then
    echo "zen-theme-sync: source profile not found: $src_dir" >&2
    exit 1
fi

for f in "${FILES[@]}"; do
    if [[ ! -f "$src_dir/$f" ]]; then
        echo "zen-theme-sync: source file missing: $src_dir/$f" >&2
        exit 1
    fi
done

if (( force )); then
    echo "zen-theme-sync: copying from $SOURCE_PROFILE → ${#TARGETS[@]} profiles"
else
    echo "zen-theme-sync: DRY RUN (re-run with --force to apply)"
fi
echo "  source: $src_dir"
echo

for target in "${TARGETS[@]}"; do
    tgt_dir="$ZEN_ROOT/$target"
    if [[ ! -d "$tgt_dir" ]]; then
        echo "  $target: SKIP (target dir missing: $tgt_dir)"
        continue
    fi
    for f in "${FILES[@]}"; do
        if (( force )); then
            mkdir -p "$tgt_dir/$(dirname "$f")"
            cp -f "$src_dir/$f" "$tgt_dir/$f"
            echo "  $target: copied $f"
        else
            echo "  $target: would copy $f"
        fi
    done
done

if (( force )); then
    echo
    echo "Done. Restart any running Zen instances of the synced profiles to load."
fi

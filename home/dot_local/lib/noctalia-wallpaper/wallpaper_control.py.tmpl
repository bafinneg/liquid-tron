"""Wallpaper control plane for the 7800x Noctalia desktop.

Single owner of wallpaper state: serializes every entry path (Noctalia hook,
startup reconcile, Mainframe launchers, system mode, restart timer) behind one
exclusive flock, drives awww / mpvpaper / the pinned Noctalia binary through an
injected ``Runner`` (argv arrays only), and commits ``state.json`` last.
"""
from __future__ import annotations

import argparse
import concurrent.futures
import contextlib
import dataclasses
import fcntl
import hashlib
import json
import os
import re
import secrets
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Callable, Iterator, Mapping, NamedTuple, Optional, Protocol, Sequence

# Single pin site (INFRA-lt26r-1 OD-B): the binary path and sha256 live only in the
# noctalia-primary-msg wrapper, which ships in the same Stow package as this module.
PIN_FILE = Path(__file__).resolve().parents[2] / "bin" / "noctalia-primary-msg"  # .local/lib/<pkg>/ -> .local/bin/
# Private Noctalia homes: only the pinned binary gets them, never its non-Noctalia children (FEAT-lt26r-2 OD-A).
_PRIVATE_NOCTALIA_VARS = frozenset({"NOCTALIA_CONFIG_HOME", "NOCTALIA_STATE_HOME", "NOCTALIA_DATA_HOME"})
_PIN_BINARY = re.compile(r"^binary=(/\S+)$", re.MULTILINE)
_PIN_SHA = re.compile(r"^expected_sha=([0-9a-f]{64})$", re.MULTILINE)
IMAGE_EXTENSIONS = frozenset({"jpg", "jpeg", "png", "webp", "jxl", "bmp", "gif"})
VIDEO_EXTENSIONS = frozenset({"mp4", "webm", "mkv", "mov"})
MODES = ("mainframe-parallax", "mainframe-static", "selected-static", "scene")
ROLES = ("left", "center", "right")
LIBRARY_SKIP_DIRS = frozenset({"raw", "archive"})
THUMB_WIDTH = 480
# Picker tiles: the 480 px thumb cropped to the native picker's tile face. Noctalia decodes plugin images on its UI
# thread, so the panel loads these small files (about 4x cheaper) and can show every tile in its first frame.
TILE_SIZE = (256, 144)
THUMB_WORKERS = 6
MIN_IMAGE_BYTES = 1024
MAINFRAME_MODES = ("mainframe-parallax", "mainframe-static")
LAUNCHERS = {"mainframe-parallax": "mainframe-parallax-start", "mainframe-static": "mainframe-static-start"}
LIQUID_TRON = "Liquid-Tron"
CANONICAL_CONFIG_DIR = Path("{{ .chezmoi.homeDir }}/home-infra/machines/7800x/dotfiles/noctalia/.config/noctalia")
SUPPRESSION_SECONDS = 30
# Pinned beta.8 `theme` emits Material 3 token names; its custom-palette loader needs
# the mPrimary-style layout with a nested terminal map (see Liquid-Tron.json).
_M_TOKENS = {
    "mPrimary": "primary", "mOnPrimary": "on_primary", "mSecondary": "secondary", "mOnSecondary": "on_secondary",
    "mTertiary": "tertiary", "mOnTertiary": "on_tertiary", "mError": "error", "mOnError": "on_error",
    "mSurface": "surface", "mOnSurface": "on_surface", "mSurfaceVariant": "surface_variant",
    "mOnSurfaceVariant": "on_surface_variant", "mOutline": "outline", "mShadow": "shadow",
    "mHover": "surface_container_high", "mOnHover": "on_surface",
}
_TERM_TOP = {"foreground": "foreground", "background": "background", "cursor": "cursor", "cursorText": "cursor_text",
             "selectionFg": "selection_fg", "selectionBg": "selection_bg"}
_TERM_COLORS = ("black", "red", "green", "yellow", "blue", "magenta", "cyan", "white")
_HEX_COLOR = re.compile(r"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$")
HEX64 = re.compile(r"^[0-9a-f]{64}$")
RESTART_TIMER = "mpvpaper-restart.timer"
RESTART_SERVICE = "mpvpaper-restart.service"
ROTATE_TIMER = "wallpaper-rotate.timer"
UNIT_PREFIX = "mpvpaper-parallax"
# Source art names do not match physical roles: left=center art, center=left art.
PARALLAX_VIDEO = {"left": "mainframe-center-parallax.mp4", "center": "mainframe-left-parallax.mp4", "right": "mainframe-right-parallax.mp4"}
STATIC_IMAGE = {"left": "mainframe-center.png", "center": "mainframe-left.png", "right": "mainframe-right.png"}
FFPROBE_ARGS = ("-v", "error", "-select_streams", "v:0", "-count_frames", "-show_entries", "stream=codec_type,nb_read_frames", "-of", "json")


class WallpaperError(Exception):
    pass


class StateError(WallpaperError):
    pass


class PathRejected(WallpaperError):
    pass


class MediaRejected(WallpaperError):
    pass


class PaletteError(WallpaperError):
    pass


class BinaryPinError(WallpaperError):
    pass


class CommandError(WallpaperError):
    pass


class RendererError(WallpaperError):
    pass


class CmdResult(NamedTuple):
    returncode: int
    stdout: str
    stderr: str


class Runner(Protocol):
    def run(self, argv: Sequence[str], env: Optional[Mapping[str, str]] = None, timeout: Optional[float] = None) -> CmdResult: ...

    def spawn(self, argv: Sequence[str], env: Optional[Mapping[str, str]] = None) -> None: ...


class SubprocessRunner:
    """Real runner: argv lists only, never a shell."""

    def run(self, argv: Sequence[str], env: Optional[Mapping[str, str]] = None, timeout: Optional[float] = None) -> CmdResult:
        try:
            p = subprocess.run(list(argv), capture_output=True, text=True, timeout=timeout, env=None if env is None else dict(env), stdin=subprocess.DEVNULL, check=False)
        except subprocess.TimeoutExpired:
            return CmdResult(124, "", "timeout")
        except OSError as e:
            return CmdResult(127, "", e.strerror or "oserror")
        return CmdResult(p.returncode, p.stdout, p.stderr)

    def spawn(self, argv: Sequence[str], env: Optional[Mapping[str, str]] = None) -> None:
        subprocess.Popen(list(argv), env=None if env is None else dict(env), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


@dataclasses.dataclass
class Config:
    state_dir: Path
    wallpaper_root: Path
    binary: Path
    expected_sha: str
    home: Path
    config_home: Path
    state_home: Path
    data_home: Path
    user_config: Path
    runtime_dir: Path
    wayland_display: str
    user_cache: Path
    bin_dir: Path
    parallax_dir: Path
    pid_file: Path
    proc_root: str = "/proc"

    @property
    def palettes_dir(self) -> Path:
        return self.config_home / "noctalia" / "palettes"

    @classmethod
    def default(cls, env: Mapping[str, str], pin_file: Path = PIN_FILE) -> "Config":
        home = Path(env.get("HOME") or "{{ .chezmoi.homeDir }}")
        state_home = home / ".local/state/noctalia-primary"
        override = env.get("WALLPAPER_CONTROL_STATE_DIR")
        try:
            binary, expected_sha = read_pin(pin_file)
        except BinaryPinError:
            # Fail closed at use time: Controller.noctalia() refuses an empty pin,
            # while pin-independent commands (prepare-config-home, status) still run.
            binary, expected_sha = Path(""), ""
        return cls(
            state_dir=Path(override) if override else state_home / "wallpaper-control",
            wallpaper_root=home / "Pictures/Wallpapers",
            binary=binary,
            expected_sha=expected_sha,
            home=home,
            config_home=state_home / "config-home",
            state_home=state_home,
            data_home=home / ".local/share/noctalia-primary",
            user_config=home / ".config",
            runtime_dir=Path(env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"),
            wayland_display=env.get("WAYLAND_DISPLAY") or "wayland-1",
            user_cache=home / ".cache",
            bin_dir=home / ".local/bin",
            parallax_dir=home / "Pictures/Wallpapers/parallax",
            pid_file=Path("/tmp/tron-parallax.pid"),
        )


# ----------------------------------------------------------------- state
@dataclasses.dataclass(frozen=True)
class State:
    mode: str
    selected: Optional[dict]
    scene: Optional[dict] = None

    def to_bytes(self) -> bytes:
        return (json.dumps({"version": 2, "mode": self.mode, "selected": self.selected, "scene": self.scene}, indent=2, sort_keys=False) + "\n").encode()


class PaletteInfo(NamedTuple):
    name: str
    sha256: str


_SELECTED_KEYS = {"path", "image_sha256", "palette_name", "palette_sha256"}


def _valid_selected(sel: Any) -> bool:
    if not isinstance(sel, dict) or set(sel) != _SELECTED_KEYS:
        return False
    if not all(isinstance(v, str) for v in sel.values()):
        return False
    if not sel["path"].startswith("/") or not HEX64.match(sel["image_sha256"]) or not HEX64.match(sel["palette_sha256"]):
        return False
    return sel["palette_name"] == palette_name_for(sel["image_sha256"])


def _valid_scene(scene: Any) -> bool:
    return isinstance(scene, dict) and set(scene) == set(ROLES) and all(isinstance(v, str) and v.startswith("/") for v in scene.values())


def parse_state(raw: bytes) -> State:
    try:
        data = json.loads(raw.decode())
    except (ValueError, UnicodeDecodeError) as e:
        raise StateError("state is not valid JSON") from e
    if not isinstance(data, dict):
        raise StateError("state is not an object")
    version = data.get("version")
    if type(version) is not int or version not in (1, 2):
        raise StateError("unsupported state version")
    if set(data) != ({"version", "mode", "selected"} if version == 1 else {"version", "mode", "selected", "scene"}):
        raise StateError("state keys do not match its version")
    mode, selected, scene = data["mode"], data["selected"], data.get("scene")
    if mode not in MODES:
        raise StateError("invalid mode")
    if selected is not None and not _valid_selected(selected):
        raise StateError("invalid selected object")
    if mode == "selected-static" and selected is None:
        raise StateError("selected-static requires selected")
    if (mode == "scene") != (scene is not None) or (scene is not None and not _valid_scene(scene)):
        raise StateError("scene is required exactly when mode is scene")
    return State(mode, selected, scene)


def palette_name_for(image_sha: str) -> str:
    return f"wallpaper-{image_sha}-m3-content"


def read_pin(pin_file: Path = PIN_FILE) -> tuple[Path, str]:
    """Return (binary, sha256) from the noctalia-primary-msg pin lines; exactly one of each."""
    try:
        text = pin_file.read_text(encoding="utf-8")
    except OSError as e:
        raise BinaryPinError("Noctalia pin file unreadable") from e
    binaries = _PIN_BINARY.findall(text)
    shas = _PIN_SHA.findall(text)
    if len(binaries) != 1 or len(shas) != 1:
        raise BinaryPinError("Noctalia pin is missing, duplicated or malformed")
    return Path(binaries[0]), shas[0]


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _fsync_dir(d: Path) -> None:
    fd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _log(msg: str) -> None:
    print(f"wallpaper-control: {msg}", file=sys.stderr)


def _parse_awww(text: str) -> dict[str, str]:
    """Flatten awww's namespace->outputs JSON into {connector: image-or-empty}."""
    data = json.loads(text)
    entries: list[Any] = []
    if isinstance(data, dict):
        for v in data.values():
            if isinstance(v, list):
                entries.extend(v)
    elif isinstance(data, list):
        entries = data
    out: dict[str, str] = {}
    for e in entries:
        if not isinstance(e, dict) or not isinstance(e.get("name"), str):
            continue
        disp = e.get("displaying")
        img = disp.get("image") if isinstance(disp, dict) else None
        out[e["name"]] = img if isinstance(img, str) else ""
    return out


class Controller:
    def __init__(
        self,
        cfg: Config,
        runner: Runner,
        clock: Callable[[], float] = time.time,
        sleep: Callable[[float], None] = time.sleep,
        kill: Callable[[int, int], None] = os.kill,
    ) -> None:
        self.cfg = cfg
        self.runner = runner
        self._clock = clock
        self._sleep = sleep
        self._kill = kill

    # ------------------------------------------------------------ commands
    def _run(self, argv: Sequence[str], env: Optional[Mapping[str, str]] = None, timeout: float = 30) -> CmdResult:
        return self.runner.run(list(argv), env=env, timeout=timeout)

    def _must(self, argv: Sequence[str], env: Optional[Mapping[str, str]] = None, timeout: float = 30) -> CmdResult:
        r = self._run(argv, env=env, timeout=timeout)
        if r.returncode != 0:
            raise CommandError(f"{os.path.basename(argv[0])} failed (rc={r.returncode})")
        return r

    def _noctalia_env(self) -> dict[str, str]:
        c = self.cfg
        return {
            "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
            "HOME": str(c.home),
            # FEAT-lt26r-2 OD-A: private homes only in NOCTALIA_*_HOME (read first by 5.3);
            # XDG_* are the user's real homes so nothing Noctalia spawns inherits private ones.
            "XDG_CONFIG_HOME": str(c.user_config),
            "NOCTALIA_CONFIG_HOME": str(c.config_home),
            "NOCTALIA_STATE_HOME": str(c.state_home),
            "NOCTALIA_DATA_HOME": str(c.data_home),
            "XDG_CACHE_HOME": str(c.user_cache),
            "XDG_RUNTIME_DIR": str(c.runtime_dir),
            "WAYLAND_DISPLAY": c.wayland_display,
        }

    def _app_env(self, **extra: str) -> dict[str, str]:
        """Environment for non-Noctalia children (awww, Mainframe launchers): the caller's
        environment with the user's real XDG homes and no private Noctalia homes (OD-A)."""
        env = {k: v for k, v in os.environ.items() if k not in _PRIVATE_NOCTALIA_VARS}
        env["XDG_CONFIG_HOME"] = str(self.cfg.user_config)
        env["XDG_CACHE_HOME"] = str(self.cfg.user_cache)
        env.update(extra)
        return env

    def noctalia(self, args: Sequence[str], timeout: float = 60) -> CmdResult:
        """Run the pinned binary; fail closed on any hash mismatch."""
        if not HEX64.match(self.cfg.expected_sha) or not self.cfg.binary.is_absolute():
            raise BinaryPinError("Noctalia pin is unavailable")
        try:
            actual = sha256_file(self.cfg.binary)
        except OSError as e:
            raise BinaryPinError("pinned Noctalia binary unreadable") from e
        if actual != self.cfg.expected_sha:
            raise BinaryPinError("pinned Noctalia binary hash mismatch")
        return self._run([str(self.cfg.binary), *args], env=self._noctalia_env(), timeout=timeout)

    def _msg(self, *args: str) -> CmdResult:
        return self.noctalia(["msg", *args])

    def _msg_ok(self, *args: str) -> CmdResult:
        r = self._msg(*args)
        if r.returncode != 0:
            raise CommandError(f"noctalia msg {args[0]} failed (rc={r.returncode})")
        return r

    # ----------------------------------------------------------- state files
    def ensure_state_dir(self) -> None:
        d = self.cfg.state_dir
        if d.is_symlink():
            raise StateError("state dir is a symlink")
        d.mkdir(mode=0o700, parents=True, exist_ok=True)
        st = d.lstat()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            raise StateError("state dir is not an owned directory")
        os.chmod(d, 0o700)

    def _atomic_write(self, path: Path, data: bytes) -> None:
        if path.is_symlink():
            raise StateError("refusing to write through a symlink")
        tmp = path.parent / f".tmp-{os.getpid()}-{secrets.token_hex(4)}"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
                f.flush()
                os.fchmod(f.fileno(), 0o600)
                os.fsync(f.fileno())
            os.replace(tmp, path)
        except BaseException:
            with contextlib.suppress(OSError):
                tmp.unlink()
            raise
        _fsync_dir(path.parent)

    def _read_private(self, path: Path) -> Optional[bytes]:
        try:
            if path.is_symlink() or not path.exists():
                return None
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
            with os.fdopen(fd, "rb") as f:
                return f.read()
        except OSError:
            return None

    def read_state(self) -> Optional[State]:
        raw = self._read_private(self.cfg.state_dir / "state.json")
        if raw is None:
            return None
        try:
            return parse_state(raw)
        except StateError:
            return None

    def write_state(self, state: State) -> None:
        self.ensure_state_dir()
        self._atomic_write(self.cfg.state_dir / "state.json", state.to_bytes())

    @contextlib.contextmanager
    def lock(self) -> Iterator[None]:
        self.ensure_state_dir()
        fd = os.open(self.cfg.state_dir / "control.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            os.fchmod(fd, 0o600)
            fcntl.flock(fd, fcntl.LOCK_EX)
            yield
        finally:
            os.close(fd)

    # ----------------------------------------------------------- suppression
    def _marker_path(self) -> Path:
        return self.cfg.state_dir / "hook-suppression.json"

    def _read_marker(self) -> Optional[dict]:
        p = self._marker_path()
        raw = self._read_private(p)
        if raw is None:
            return None
        now = self._clock()
        try:
            m = json.loads(raw.decode())
            ok = (
                isinstance(m, dict)
                and set(m) == {"version", "path", "mode", "expires"}
                and m["version"] == 1
                and isinstance(m["path"], str)
                and m["mode"] in (*MAINFRAME_MODES, "scene")
                and isinstance(m["expires"], (int, float))
                and now < m["expires"] <= now + SUPPRESSION_SECONDS + 1
            )
        except (ValueError, UnicodeDecodeError):
            ok = False
        if not ok:
            with contextlib.suppress(OSError):
                p.unlink()
            return None
        return m

    def suppression_active_for(self, path: Path) -> bool:
        m = self._read_marker()
        if m is None:
            return False
        state = self.read_state()
        return state is not None and state.mode == m["mode"] and m["path"] == str(path)

    def _write_marker(self, path: Path, mode: str) -> None:
        body = {"version": 1, "path": str(path), "mode": mode, "expires": self._clock() + SUPPRESSION_SECONDS}
        self._atomic_write(self._marker_path(), (json.dumps(body) + "\n").encode())

    # ------------------------------------------------------- path and media
    def canonicalize_image(self, path_str: str) -> Path:
        return self._canonicalize(path_str, IMAGE_EXTENSIONS)

    def canonicalize_media(self, path_str: str) -> Path:
        return self._canonicalize(path_str, IMAGE_EXTENSIONS | VIDEO_EXTENSIONS)

    def _canonicalize(self, path_str: str, extensions: frozenset) -> Path:
        if not path_str or not os.path.isabs(path_str):
            raise PathRejected("path is not absolute")
        if os.path.islink(path_str):
            raise PathRejected("path is a symlink")
        real = Path(os.path.realpath(path_str))
        root = Path(os.path.realpath(self.cfg.wallpaper_root))
        if not real.is_relative_to(root) or real == root:
            raise PathRejected("path escapes wallpaper root")
        if real.suffix.lower().lstrip(".") not in extensions:
            raise PathRejected("unsupported extension")
        try:
            st = os.lstat(real)
        except OSError as e:
            raise PathRejected("path is not accessible") from e
        if not stat.S_ISREG(st.st_mode) or not os.access(real, os.R_OK):
            raise PathRejected("path is not a readable regular file")
        return real

    def check_single_frame(self, path: Path) -> None:
        r = self._run(["ffprobe", *FFPROBE_ARGS, str(path)], timeout=60)
        if r.returncode != 0:
            raise MediaRejected("ffprobe failed")
        try:
            streams = json.loads(r.stdout).get("streams")
        except (ValueError, AttributeError) as e:
            raise MediaRejected("ffprobe output malformed") from e
        if not isinstance(streams, list) or len(streams) != 1:
            raise MediaRejected("expected exactly one video stream")
        s = streams[0]
        if not isinstance(s, dict) or s.get("codec_type") != "video" or s.get("nb_read_frames") != "1":
            raise MediaRejected("not a single-frame image")

    # --------------------------------------------------------------- palette
    @staticmethod
    def _color(v: Any) -> str:
        if not isinstance(v, str) or not _HEX_COLOR.match(v):
            raise PaletteError("palette value is not a hex color")
        return v

    @classmethod
    def convert_theme_output(cls, raw: bytes) -> bytes:
        """Map the pinned `theme --both` output (M3 names) to the loadable custom-palette layout."""
        try:
            data = json.loads(raw.decode())
        except (ValueError, UnicodeDecodeError) as e:
            raise PaletteError("theme output is not valid JSON") from e
        if not isinstance(data, dict) or set(data) != {"dark", "light"}:
            raise PaletteError("theme output keys are not exactly dark/light")
        out: dict[str, dict] = {}
        for variant in ("dark", "light"):
            src = data[variant]
            if not isinstance(src, dict) or not src:
                raise PaletteError(f"theme {variant} map is empty or malformed")
            try:
                m = {dst: cls._color(src[key]) for dst, key in _M_TOKENS.items()}
                term: dict[str, Any] = {dst: cls._color(src[f"terminal_{key}"]) for dst, key in _TERM_TOP.items()}
                for group in ("normal", "bright"):
                    term[group] = {c: cls._color(src[f"terminal_{group}_{c}"]) for c in _TERM_COLORS}
            except KeyError as e:
                raise PaletteError(f"theme {variant} map lacks a required token") from e
            m["terminal"] = term
            out[variant] = m
        return (json.dumps(out, indent=2, sort_keys=True) + "\n").encode()

    @classmethod
    def _validate_palette_bytes(cls, raw: bytes) -> None:
        try:
            data = json.loads(raw.decode())
        except (ValueError, UnicodeDecodeError) as e:
            raise PaletteError("palette is not valid JSON") from e
        if not isinstance(data, dict) or set(data) != {"dark", "light"}:
            raise PaletteError("palette keys are not exactly dark/light")
        for k in ("dark", "light"):
            v = data[k]
            if not isinstance(v, dict) or set(v) != set(_M_TOKENS) | {"terminal"}:
                raise PaletteError(f"palette {k} map is empty or malformed")
            for name in _M_TOKENS:
                cls._color(v[name])
            term = v["terminal"]
            if not isinstance(term, dict) or set(term) != set(_TERM_TOP) | {"normal", "bright"}:
                raise PaletteError(f"palette {k} terminal map is malformed")
            for name in _TERM_TOP:
                cls._color(term[name])
            for group in ("normal", "bright"):
                g = term[group]
                if not isinstance(g, dict) or set(g) != set(_TERM_COLORS):
                    raise PaletteError(f"palette {k} terminal {group} map is malformed")
                for c in _TERM_COLORS:
                    cls._color(g[c])

    def _validate_palette_file(self, path: Path) -> str:
        try:
            st = os.lstat(path)
            if not stat.S_ISREG(st.st_mode) or stat.S_IMODE(st.st_mode) != 0o600:
                raise PaletteError("cached palette is not a regular mode-0600 file")
            raw = path.read_bytes()
        except OSError as e:
            raise PaletteError("cached palette unreadable") from e
        self._validate_palette_bytes(raw)
        return hashlib.sha256(raw).hexdigest()

    def ensure_palette(self, path: Path, image_sha: str, expected_sha: Optional[str] = None) -> PaletteInfo:
        name = palette_name_for(image_sha)
        pdir = self.cfg.palettes_dir
        if pdir.is_symlink():
            raise PaletteError("palette dir is a symlink")
        pdir.mkdir(mode=0o700, parents=True, exist_ok=True)
        target = pdir / f"{name}.json"
        if os.path.lexists(target):
            digest = self._validate_palette_file(target)
            if expected_sha is not None and digest != expected_sha:
                raise PaletteError("cached palette hash differs from recorded hash")
            return PaletteInfo(name, digest)
        tmp = pdir / f".tmp-{os.getpid()}-{secrets.token_hex(4)}.json"
        raw_tmp = pdir / f".tmp-raw-{os.getpid()}-{secrets.token_hex(4)}.json"
        try:
            r = self.noctalia(["theme", str(path), "--scheme", "m3-content", "--both", "-o", str(raw_tmp)], timeout=120)
            if r.returncode != 0:
                raise PaletteError(f"noctalia theme failed (rc={r.returncode})")
            raw = self.convert_theme_output(raw_tmp.read_bytes())
            self._validate_palette_bytes(raw)
            fd0 = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd0, "wb") as f:
                f.write(raw)
            os.chmod(tmp, 0o600)
            fd = os.open(tmp, os.O_RDONLY | os.O_NOFOLLOW)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
            os.replace(tmp, target)
            _fsync_dir(pdir)
            return PaletteInfo(name, hashlib.sha256(raw).hexdigest())
        except OSError as e:
            raise PaletteError("palette write failed") from e
        finally:
            for leftover in (tmp, raw_tmp):
                with contextlib.suppress(OSError):
                    leftover.unlink()

    # ------------------------------------------------------ noctalia queries
    def _wallpaper_get(self, connector: Optional[str] = None) -> Optional[Path]:
        r = self._msg("wallpaper-get", *([connector] if connector else []))
        out = r.stdout.strip()
        if r.returncode != 0 or not out:
            return None
        return Path(os.path.realpath(out))

    def _wallpaper_set(self, path: Path) -> None:
        self._msg_ok("wallpaper-set", str(path))

    def _scheme_get(self) -> Optional[str]:
        r = self._msg("color-scheme-get")
        return r.stdout if r.returncode == 0 else None

    def _activate_scheme(self, name: str) -> None:
        self._msg_ok("color-scheme-set", "custom", name)
        if self._scheme_get() != f"custom {name}\n":
            raise RendererError("color scheme did not verify")

    # ------------------------------------------------------ system queries
    def _monitors(self) -> list[dict]:
        r = self._must(["hyprctl", "monitors", "-j"])
        try:
            mons = json.loads(r.stdout)
        except ValueError as e:
            raise RendererError("hyprctl output malformed") from e
        if not isinstance(mons, list) or not mons:
            raise RendererError("no monitors")
        return mons

    def _connectors(self) -> list[str]:
        return sorted(m["name"] for m in self._monitors())

    def _roles(self) -> dict[str, str]:
        """connector -> role (left/center/right) from EDID descriptions."""
        mons = self._monitors()
        center = [m for m in mons if "PG42UQ" in m.get("description", "")]
        side = sorted((m for m in mons if "AW2725Q" in m.get("description", "")), key=lambda m: m["x"])
        if len(center) != 1 or len(side) != 2:
            raise RendererError("expected one PG42UQ and two AW2725Q")
        return {side[0]["name"]: "left", center[0]["name"]: "center", side[1]["name"]: "right"}

    def _is_active(self, unit: str) -> bool:
        return self._run(["systemctl", "--user", "is-active", "--quiet", unit]).returncode == 0

    def _stop_timers(self) -> None:
        for unit in (RESTART_TIMER, RESTART_SERVICE, ROTATE_TIMER):
            self._run(["systemctl", "--user", "stop", unit])
        if self._is_active(RESTART_TIMER) or self._is_active(ROTATE_TIMER):
            raise RendererError("timers did not stop")

    def _parallax_units(self) -> list[str]:
        r = self._run(["systemctl", "--user", "list-units", "--plain", "--no-legend", "--no-pager", "--state=active,activating,deactivating,reloading", f"{UNIT_PREFIX}-*.service"])
        return [ln.split()[0] for ln in r.stdout.splitlines() if ln.strip()]

    def _retire_mpvpaper(self) -> None:
        for unit in self._parallax_units():
            self._run(["systemctl", "--user", "stop", unit])
        if self._parallax_units() or self._run(["pgrep", "-x", "mpvpaper"]).returncode == 0:
            raise RendererError("mpvpaper owners remain")

    # ---------------------------------------------------------------- awww
    def _awww_images(self) -> Optional[dict[str, str]]:
        r = self._run(["awww", "query", "--json"])
        if r.returncode != 0:
            return None
        try:
            return _parse_awww(r.stdout)
        except ValueError:
            return None

    def _ensure_awww(self) -> None:
        if self._awww_images() is not None:
            return
        self.runner.spawn(["awww-daemon", "--no-cache", "-q"], self._app_env())
        for _ in range(40):
            if self._awww_images() is not None:
                return
            self._sleep(0.1)
        raise RendererError("awww did not become ready")

    def _verify_awww(self, expected: Mapping[str, Path]) -> bool:
        cur = self._awww_images()
        if cur is None or set(cur) != set(expected):
            return False
        return all(cur[c] and os.path.realpath(cur[c]) == os.path.realpath(p) for c, p in expected.items())

    def _wait_awww(self, expected: Mapping[str, Path]) -> None:
        for _ in range(30):
            if self._verify_awww(expected):
                return
            self._sleep(0.1)
        raise RendererError("awww did not display the expected images")

    def _handoff_awww(self, path: Path) -> None:
        self._ensure_awww()
        self._must(["awww", "img", str(path), "--transition-type", "fade", "--transition-duration", "0.6", "--transition-fps", "60"])
        self._wait_awww({c: path for c in self._connectors()})

    # ----------------------------------------------------- selection helper
    def _selected_verified(self, state: State, path: Path, image_sha: str) -> bool:
        sel = state.selected
        if state.mode != "selected-static" or sel is None or sel["path"] != str(path) or sel["image_sha256"] != image_sha:
            return False
        try:
            if self._validate_palette_file(self.cfg.palettes_dir / f"{sel['palette_name']}.json") != sel["palette_sha256"]:
                return False
            if self._scheme_get() != f"custom {sel['palette_name']}\n":
                return False
            return self._verify_awww({c: path for c in self._connectors()})
        except WallpaperError:
            return False

    def _apply_selected(self, path: Path, info: PaletteInfo) -> None:
        self._stop_timers()
        self._handoff_awww(path)
        self._retire_mpvpaper()
        self._activate_scheme(info.name)

    def _commit_selected(self, path: Path, image_sha: str, info: PaletteInfo) -> None:
        sel = {"path": str(path), "image_sha256": image_sha, "palette_name": info.name, "palette_sha256": info.sha256}
        self.write_state(State("selected-static", sel))

    def _restore_selected(self, prior: State) -> None:
        sel = prior.selected
        assert sel is not None
        path = Path(sel["path"])
        name = sel["palette_name"]
        if self._validate_palette_file(self.cfg.palettes_dir / f"{name}.json") != sel["palette_sha256"]:
            raise PaletteError("prior palette no longer matches")
        self._wallpaper_set(path)
        self._apply_selected(path, PaletteInfo(name, sel["palette_sha256"]))
        self.write_state(prior)

    # ------------------------------------------------------------- notify
    def _notify(self, restored: Optional[str]) -> None:
        body = f"Restored {restored}." if restored else "Restore did not verify; run wallpaper-control status."
        self._run(["notify-send", "--app-name=wallpaper-control", "--expire-time=8000", "Wallpaper update failed", body], timeout=5)

    def _rollback(self, prior: State) -> int:
        restored: Optional[str] = None
        try:
            if prior.mode == "selected-static":
                self._restore_selected(prior)
            elif prior.mode == "scene":
                assert prior.scene is not None
                self._scene_apply(prior.scene, prior)
            elif self.apply_mainframe_locked(prior.mode) != 0:
                raise RendererError("prior Mainframe restore failed")
            restored = prior.mode
        except Exception as e:  # noqa: BLE001 - bounded fallback follows
            _log(f"rollback to {prior.mode} failed: {type(e).__name__}")
            if self.apply_mainframe_locked("mainframe-parallax") == 0:
                restored = "mainframe-parallax"
            else:
                _log("emergency Mainframe parallax failed")
        self._notify(restored)
        return 1

    def _reconcile_metadata(self, state: State) -> None:
        try:
            if state.mode == "selected-static" and state.selected:
                target = Path(state.selected["path"])
                if self._wallpaper_get() != Path(os.path.realpath(target)):
                    self._wallpaper_set(target)
            elif state.mode == "scene" and state.scene:
                if self._wallpaper_get() != Path(os.path.realpath(self._scene_rep_path(state.scene))):
                    self._publish_scene_representative(state.scene)
            elif self._wallpaper_get() != Path(os.path.realpath(self._rep_path())):
                self._publish_representative(state.mode)
        except Exception as e:  # noqa: BLE001
            _log(f"metadata reconcile failed: {type(e).__name__}")

    # ---------------------------------------------------------------- hook
    def hook(self, path_str: str, connector: str = "") -> int:
        with self.lock():
            return self.hook_locked(path_str, connector)

    def hook_locked(self, path_str: str, connector: str = "") -> int:
        try:
            state = self.read_state()
            if state is None:
                if self.reconcile_locked() != 0:
                    return 1
                state = self.read_state()
                assert state is not None
            if path_str and self.suppression_active_for(Path(os.path.realpath(path_str))):
                return 0
            try:
                canonical = self.canonicalize_image(path_str)
            except PathRejected as e:
                _log(f"hook rejected: {e}")
                self._reconcile_metadata(state)
                return 1
            current = self._wallpaper_get(connector or None)
            if current != canonical:
                return 0  # superseded by a newer selection
            try:
                self.check_single_frame(canonical)
            except MediaRejected as e:
                _log(f"hook rejected: {e}")
                self._reconcile_metadata(state)
                return 1
            targets = [None, *self._connectors()]
            if any(self._wallpaper_get(c) != canonical for c in targets):
                self._wallpaper_set(canonical)
                return 0
            image_sha = sha256_file(canonical)
            if self._selected_verified(state, canonical, image_sha):
                return 0
            return self._selection_transaction(state, canonical, image_sha)
        except (WallpaperError, OSError) as e:
            _log(f"hook failed: {type(e).__name__}: {e}")
            return 1

    def _selection_transaction(self, prior: State, path: Path, image_sha: str) -> int:
        try:
            recorded = prior.selected["palette_sha256"] if prior.selected and prior.selected["image_sha256"] == image_sha else None
            info = self.ensure_palette(path, image_sha, recorded)
            self._apply_selected(path, info)
            self._commit_selected(path, image_sha, info)
            return 0
        except Exception as e:  # noqa: BLE001 - every pre-commit failure rolls back once
            _log(f"selection failed before commit: {type(e).__name__}: {e}")
            return self._rollback(prior)

    # ----------------------------------------------------------- Mainframe
    def _rep_path(self) -> Path:
        return self.cfg.user_cache / "mainframe-static" / "mainframe-left.png"

    def _unit_ok(self, connector: str, media: Path) -> bool:
        unit = f"{UNIT_PREFIX}-{connector}.service"
        r = self._run(["systemctl", "--user", "show", unit, "--property=ActiveState,ExecStart"])
        if r.returncode != 0 or "ActiveState=active" not in r.stdout.splitlines():
            return False
        for line in r.stdout.splitlines():
            if line.startswith("ExecStart=") and {connector, str(media)} <= set(line.replace(";", " ").split()):
                return True
        return False

    def _verify_parallax_units(self, files: Optional[Mapping[str, Path]] = None) -> None:
        """Every role's mpvpaper unit must run its expected file (default: the Mainframe videos)."""
        files = files or {r: self.cfg.parallax_dir / v for r, v in PARALLAX_VIDEO.items()}
        for conn, role in self._roles().items():
            if not self._unit_ok(conn, files[role]):
                raise RendererError(f"parallax unit for {role} does not match EDID mapping")

    @staticmethod
    def _is_video(path: str) -> bool:
        return Path(path).suffix.lower().lstrip(".") in VIDEO_EXTENSIONS

    def _scene_has_video(self, scene: Mapping[str, str]) -> bool:
        return any(self._is_video(p) for p in scene.values())

    def _verify_scene(self, scene: Mapping[str, str]) -> None:
        self._verify_parallax_units({r: Path(p) for r, p in scene.items()})
        if self._is_active(RESTART_TIMER) != self._scene_has_video(scene) or self._is_active(ROTATE_TIMER):
            raise RendererError("scene timer state wrong")

    def _verify_mainframe(self, mode: str) -> None:
        if mode == "mainframe-parallax":
            self._verify_parallax_units()
            if not self._is_active(RESTART_TIMER) or self._is_active(ROTATE_TIMER):
                raise RendererError("parallax timer state wrong")
            return
        if self._parallax_units() or self._is_active(RESTART_TIMER) or self._is_active(ROTATE_TIMER):
            raise RendererError("static mode has parallax owners or timers")
        d = self.cfg.user_cache / "mainframe-static"
        self._wait_awww({c: d / STATIC_IMAGE[r] for c, r in self._roles().items()})

    def _publish_representative(self, mode: str) -> None:
        rep = self._rep_path()
        if not rep.is_file() or rep.stat().st_size == 0:
            rep.parent.mkdir(parents=True, exist_ok=True)
            src = self.cfg.parallax_dir / PARALLAX_VIDEO["center"]
            self._must(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-ss", "5", "-i", str(src), "-frames:v", "1", "-y", str(rep)], timeout=120)
            if not rep.is_file():
                raise RendererError("representative image missing")
        self._write_marker(rep, mode)
        try:
            self._wallpaper_set(rep)
        except WallpaperError:
            with contextlib.suppress(OSError):
                self._marker_path().unlink()
            raise

    def _publish_representative_quiet(self, mode: str) -> None:
        try:
            self._publish_representative(mode)
        except Exception as e:  # noqa: BLE001 - state is already committed; do not fail the transaction
            _log(f"representative metadata not published: {type(e).__name__}")

    def apply_mainframe(self, mode: str, if_committed: bool = False) -> int:
        with self.lock():
            if if_committed:
                # A queued restart (mpvpaper-restart.service) must not undo a newer mode.
                state = self.read_state()
                if state is None or state.mode != mode:
                    return 0
            return self.apply_mainframe_locked(mode)

    def apply_mainframe_locked(self, mode: str) -> int:
        try:
            if mode not in LAUNCHERS:
                raise StateError("not a Mainframe mode")
            prior = self.read_state()
            env = self._app_env(WALLPAPER_CONTROL_INTERNAL="1")
            self._must([str(self.cfg.bin_dir / LAUNCHERS[mode])], env=env, timeout=240)
            self._verify_mainframe(mode)
            self._activate_scheme(LIQUID_TRON)
            self.write_state(State(mode, prior.selected if prior else None))
            self._publish_representative_quiet(mode)
            return 0
        except Exception as e:  # noqa: BLE001
            _log(f"apply {mode} failed: {type(e).__name__}: {e}")
            return 1

    # --------------------------------------------------------------- scenes
    def _scene_rep_path(self, scene: Mapping[str, str]) -> Path:
        """Representative still for Noctalia metadata: the center image, or a cached frame of the center video."""
        center = scene["center"]
        if not self._is_video(center):
            return Path(center)
        st = os.stat(center)
        key = hashlib.sha256(f"{center}|{st.st_size}|{st.st_mtime_ns}".encode()).hexdigest()[:16]
        return self.cfg.user_cache / "wallpaper-scene" / f"{key}.png"

    def _publish_scene_representative(self, scene: Mapping[str, str]) -> None:
        rep = self._scene_rep_path(scene)
        if not rep.is_file() or rep.stat().st_size == 0:
            rep.parent.mkdir(parents=True, exist_ok=True)
            self._must(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-ss", "3", "-i", scene["center"], "-frames:v", "1", "-y", str(rep)], timeout=120)
            if not rep.is_file():
                raise RendererError("representative image missing")
        self._write_marker(Path(os.path.realpath(rep)), "scene")
        try:
            self._wallpaper_set(rep)
        except WallpaperError:
            with contextlib.suppress(OSError):
                self._marker_path().unlink()
            raise

    def _scene_apply(self, scene: Mapping[str, str], prior: Optional[State]) -> None:
        """Render the scene, verify it, then commit state last. Raises on any failure."""
        env = self._app_env(WALLPAPER_CONTROL_INTERNAL="1")
        for role in ROLES:
            env[f"WALLPAPER_SCENE_{role.upper()}"] = scene[role]
        self._must([str(self.cfg.bin_dir / LAUNCHERS["mainframe-parallax"])], env=env, timeout=240)
        self._run(["systemctl", "--user", "stop", ROTATE_TIMER])
        if not self._scene_has_video(scene):
            self._run(["systemctl", "--user", "stop", RESTART_TIMER])
        self._verify_scene(scene)
        self._activate_scheme(LIQUID_TRON)
        try:
            self._publish_scene_representative(scene)
        except Exception as e:  # noqa: BLE001 - metadata is best effort; state still commits
            _log(f"representative metadata not published: {type(e).__name__}")
        self.write_state(State("scene", prior.selected if prior else None, dict(scene)))

    def apply_scene_locked(self, scene: Mapping[str, str]) -> int:
        """Re-apply a committed scene (no rollback; callers decide the fallback)."""
        try:
            self._scene_apply(scene, self.read_state())
            return 0
        except Exception as e:  # noqa: BLE001
            _log(f"apply scene failed: {type(e).__name__}: {e}")
            return 1

    def apply_scene(self, left: str, center: str, right: str) -> int:
        with self.lock():
            return self.apply_scene_request(left, center, right)

    def apply_scene_request(self, left: str, center: str, right: str) -> int:
        scene: dict[str, str] = {}
        try:
            for role, raw in zip(ROLES, (left, center, right)):
                try:
                    p = self.canonicalize_media(raw)
                    if not self._is_video(str(p)):
                        self.check_single_frame(p)
                except WallpaperError as e:
                    raise type(e)(f"{role}: {e}") from e
                scene[role] = str(p)
        except WallpaperError as e:
            _log(f"scene rejected: {e}")
            return 1
        prior = self.read_state() or State("mainframe-parallax", None)
        try:
            if len(set(scene.values())) == 1 and not self._is_video(scene["left"]):
                path = Path(scene["left"])
                self._wallpaper_set(path)  # the native picker must agree with the committed wallpaper
                rc = self._selection_transaction(prior, path, sha256_file(path))
                if rc != 0:
                    _log("scene apply failed; the previous wallpaper was restored")
                return rc
            preset = {r: os.path.realpath(self.cfg.parallax_dir / v) for r, v in PARALLAX_VIDEO.items()}
            if scene == preset:
                if self.apply_mainframe_locked("mainframe-parallax") == 0:
                    return 0
                raise RendererError("Mainframe preset did not verify")
            self._scene_apply(scene, prior)
            return 0
        except Exception as e:  # noqa: BLE001 - every pre-commit failure rolls back once
            rc = self._rollback(prior)
            _log(f"scene apply failed ({e}); the previous wallpaper was restored")
            return rc

    def restart_renderer(self) -> int:
        """Timer entry: re-apply the committed mode only when its renderer is a leaking mpvpaper video."""
        with self.lock():
            state = self.read_state()
            if state is None:
                return 0
            if state.mode == "mainframe-parallax":
                return self.apply_mainframe_locked("mainframe-parallax")
            if state.mode == "scene" and state.scene and self._scene_has_video(state.scene):
                return self.apply_scene_locked(state.scene)
            return 0

    def adopt_current(self, mode: str = "mainframe-parallax") -> int:
        with self.lock():
            if mode != "mainframe-parallax":
                raise StateError("adopt-current supports only mainframe-parallax")
            try:
                self._verify_parallax_units()
            except WallpaperError as e:
                _log(f"adoption not verified ({e}); using canonical transaction")
                return self.apply_mainframe_locked(mode)
            try:
                prior = self.read_state()
                self._must(["systemctl", "--user", "start", RESTART_TIMER])
                self._run(["systemctl", "--user", "stop", ROTATE_TIMER])
                self._verify_mainframe(mode)
                self._activate_scheme(LIQUID_TRON)
                self.write_state(State(mode, prior.selected if prior else None))
                self._publish_representative_quiet(mode)
                return 0
            except Exception as e:  # noqa: BLE001
                _log(f"adopt failed: {type(e).__name__}: {e}")
                return 1

    # ------------------------------------------------------------ reconcile
    def reconcile(self) -> int:
        with self.lock():
            return self.reconcile_locked()

    def _wait_noctalia_ready(self, tries: int = 60) -> None:
        """Bounded wait for the Noctalia IPC socket: reconcile can start at login before the shell is up."""
        for _ in range(tries):
            if self._scheme_get() is not None:
                return
            self._sleep(0.5)
        _log("noctalia IPC not ready; continuing")

    def reconcile_locked(self) -> int:
        self._wait_noctalia_ready()
        state = self.read_state()
        if state is not None and state.mode == "scene":
            return self._reconcile_scene(state)
        if state is None or state.mode != "selected-static":
            return self.apply_mainframe_locked(state.mode if state else "mainframe-parallax")
        try:
            sel = state.selected
            assert sel is not None
            path = self.canonicalize_image(sel["path"])
            if str(path) != sel["path"]:
                raise PathRejected("recorded path is not canonical")
            image_sha = sha256_file(path)
            if image_sha != sel["image_sha256"]:
                raise PathRejected("image changed since selection")
            self.check_single_frame(path)
            info = self.ensure_palette(path, image_sha, sel["palette_sha256"])
            if not self._selected_verified(state, path, image_sha):
                self._apply_selected(path, info)
            if self._wallpaper_get() != path:
                self._wallpaper_set(path)
            self.write_state(state)
            return 0
        except Exception as e:  # noqa: BLE001
            _log(f"reconcile of selected-static failed: {type(e).__name__}: {e}")
            restored = "mainframe-parallax" if self.apply_mainframe_locked("mainframe-parallax") == 0 else None
            self._notify(restored)
            return 1

    def _reconcile_scene(self, state: State) -> int:
        try:
            scene = state.scene
            assert scene is not None
            for role in ROLES:
                p = self.canonicalize_media(scene[role])
                if str(p) != scene[role]:
                    raise PathRejected("recorded path is not canonical")
                if not self._is_video(scene[role]):
                    self.check_single_frame(p)
            try:
                self._verify_scene(scene)
                verified = self._scheme_get() == f"custom {LIQUID_TRON}\n"
            except WallpaperError:
                verified = False
            if verified:
                self._reconcile_metadata(state)
                return 0
            self._scene_apply(scene, state)
            return 0
        except Exception as e:  # noqa: BLE001
            _log(f"reconcile of scene failed: {type(e).__name__}: {e}")
            restored = "mainframe-parallax" if self.apply_mainframe_locked("mainframe-parallax") == 0 else None
            self._notify(restored)
            return 1

    def restart_guard(self) -> int:
        with self.lock():
            state = self.read_state()
            return 0 if state is not None and state.mode == "mainframe-parallax" else 1

    # ---------------------------------------------------------- system mode
    def _is_mpvpaper(self, pid: int) -> bool:
        try:
            return (Path(self.cfg.proc_root) / str(pid) / "comm").read_text().strip() == "mpvpaper"
        except OSError:
            return False

    def _pids(self) -> list[int]:
        raw = self._read_private(self.cfg.pid_file)
        pids = [int(t) for t in (raw or b"").decode(errors="replace").split() if t.isdigit()]
        return [p for p in pids if self._is_mpvpaper(p)]

    def gaming_pause(self) -> int:
        with self.lock():
            return self.gaming_pause_locked()

    def gaming_pause_locked(self) -> int:
        state = self.read_state()
        if state is None or state.mode not in ("mainframe-parallax", "scene"):
            return 0
        for unit in (RESTART_TIMER, RESTART_SERVICE, ROTATE_TIMER):
            self._run(["systemctl", "--user", "stop", unit])
        for pid in self._pids():
            with contextlib.suppress(OSError):
                self._kill(pid, signal.SIGSTOP)
        return 0

    def intelligent_resume(self) -> int:
        with self.lock():
            return self.intelligent_resume_locked()

    def _resume_parallax(self, scene: Optional[Mapping[str, str]] = None) -> bool:
        pids = self._pids()
        if len(pids) != 3:
            return False
        try:
            for pid in pids:
                self._kill(pid, signal.SIGCONT)
            if scene is None or self._scene_has_video(scene):
                self._must(["systemctl", "--user", "start", RESTART_TIMER])
            if scene is None:
                self._verify_mainframe("mainframe-parallax")
            else:
                self._verify_scene(scene)
        except (WallpaperError, OSError):
            return False
        return True

    def intelligent_resume_locked(self) -> int:
        state = self.read_state()
        if state is not None and state.mode == "mainframe-parallax":
            return 0 if self._resume_parallax() else self.apply_mainframe_locked("mainframe-parallax")
        if state is not None and state.mode == "scene" and state.scene:
            return 0 if self._resume_parallax(state.scene) else self.apply_scene_locked(state.scene)
        return self.reconcile_locked()

    # ------------------------------------------------------ library / status
    def _thumb_dir(self) -> Path:
        return self.cfg.user_cache / "wallpaper-studio" / "thumbs"

    def _thumb(self, path: Path, kind: str) -> str:
        try:
            st = path.stat()
            key = hashlib.sha256(f"{path}|{st.st_size}|{st.st_mtime_ns}".encode()).hexdigest()[:32]
            d = self._thumb_dir()
            out = d / f"{key}.jpg"
            if out.is_file() and out.stat().st_size > 0:
                return str(out)
            d.mkdir(parents=True, exist_ok=True)
            tmp = d / f".tmp-{os.getpid()}-{secrets.token_hex(4)}.jpg"
            base = ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error"]
            tail = ["-i", str(path), "-frames:v", "1", "-vf", f"scale={THUMB_WIDTH}:-2", "-y", str(tmp)]
            try:
                r = self._run([*base, *(["-ss", "3"] if kind == "video" else []), *tail], timeout=60)
                if kind == "video" and (r.returncode != 0 or not tmp.is_file()):
                    r = self._run([*base, *tail], timeout=60)  # clip shorter than the seek point
                if r.returncode != 0 or not tmp.is_file() or tmp.stat().st_size == 0:
                    return ""
                os.replace(tmp, out)
                return str(out)
            finally:
                with contextlib.suppress(OSError):
                    tmp.unlink()
        except Exception as e:  # noqa: BLE001 - a missing thumbnail never fails the command
            _log(f"thumbnail failed: {type(e).__name__}")
            return ""

    def _tile(self, thumb: str) -> str:
        """A small cover-cropped copy of a thumbnail, keyed like it; "" when there is no thumb or ffmpeg fails."""
        if not thumb:
            return ""
        try:
            src = Path(thumb)
            d = self.cfg.user_cache / "wallpaper-studio" / "tiles"
            out = d / src.name
            if out.is_file() and out.stat().st_size > 0:
                return str(out)
            d.mkdir(parents=True, exist_ok=True)
            tmp = d / f".tmp-{os.getpid()}-{secrets.token_hex(4)}.jpg"
            w, h = TILE_SIZE
            vf = f"scale={w}:{h}:force_original_aspect_ratio=increase,crop={w}:{h}"
            try:
                r = self._run(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-i", str(src),
                               "-vf", vf, "-q:v", "3", "-y", str(tmp)], timeout=60)
                if r.returncode != 0 or not tmp.is_file() or tmp.stat().st_size == 0:
                    return ""
                os.replace(tmp, out)
                return str(out)
            finally:
                with contextlib.suppress(OSError):
                    tmp.unlink()
        except Exception as e:  # noqa: BLE001 - a missing tile never fails the command
            _log(f"tile failed: {type(e).__name__}")
            return ""

    @staticmethod
    def _display_name(path: Path) -> str:
        stem = path.stem
        if stem.endswith("-parallax"):
            stem = stem[: -len("-parallax")]
        return re.sub(r"[-_]", " ", stem).title()

    def _scan_library(self) -> list[tuple[str, Path, str, bool]]:
        root = self.cfg.wallpaper_root
        found: list[tuple[str, Path, str, bool]] = []
        for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
            rel_dir = Path(dirpath).relative_to(root)
            raw_dir = any(part in LIBRARY_SKIP_DIRS for part in rel_dir.parts)
            dirnames.sort()
            for fn in sorted(filenames):
                p = Path(dirpath) / fn
                ext = p.suffix.lower().lstrip(".")
                try:
                    st = p.lstat()
                except OSError:
                    continue
                if not stat.S_ISREG(st.st_mode):
                    continue
                if ext in VIDEO_EXTENSIONS:
                    found.append(("video", p, self._display_name(p), bool(rel_dir.parts) and rel_dir.parts[0] == "parallax"))
                elif ext in IMAGE_EXTENSIONS:
                    if raw_dir or p.stem.lower().endswith("-depth") or ".bak" in fn.lower() or st.st_size < MIN_IMAGE_BYTES:
                        continue
                    found.append(("image", p, self._display_name(p), False))
        found.sort(key=lambda t: (t[0] != "video", t[2].lower(), str(t[1])))
        return found

    def library(self) -> int:
        found = self._scan_library()
        with concurrent.futures.ThreadPoolExecutor(max_workers=THUMB_WORKERS) as pool:
            thumbs = list(pool.map(lambda t: self._thumb(t[1], t[0]), found))
            tiles = list(pool.map(self._tile, thumbs))
        items = [{"path": str(p), "name": name, "kind": kind, "depth": depth, "thumb": thumb, "tile": tile}
                 for (kind, p, name, depth), thumb, tile in zip(found, thumbs, tiles)]
        layout = {r: str(self.cfg.parallax_dir / v) for r, v in PARALLAX_VIDEO.items()}
        print(json.dumps({"items": items, "presets": [{"id": "mainframe", "name": "Mainframe Triptych", "layout": layout}]}))
        return 0

    def _effective_layout(self, state: Optional[State]) -> Optional[dict]:
        if state is None:
            return None
        try:
            connectors = {role: conn for conn, role in self._roles().items()}
        except WallpaperError:
            return None
        if state.mode == "mainframe-parallax":
            files = {r: str(self.cfg.parallax_dir / v) for r, v in PARALLAX_VIDEO.items()}
        elif state.mode == "mainframe-static":
            files = {r: str(self.cfg.user_cache / "mainframe-static" / v) for r, v in STATIC_IMAGE.items()}
        elif state.mode == "selected-static" and state.selected:
            files = {r: state.selected["path"] for r in ROLES}
        elif state.mode == "scene" and state.scene:
            files = dict(state.scene)
        else:
            return None
        return {r: {"connector": connectors[r], "path": files[r], "kind": "video" if self._is_video(files[r]) else "image"} for r in ROLES}

    def status(self) -> int:
        state = self.read_state()
        print(json.dumps({
            "state": None if state is None else {"mode": state.mode, "selected": state.selected},
            "mode": None if state is None else state.mode,
            "layout": self._effective_layout(state),
        }))
        return 0


# ------------------------------------------------- isolated config home
OWNER_MARKER = ".wallpaper-control-owner"
OWNER_MARKER_BYTES = b"noctalia-wallpaper-control-v1\n"
FRAGMENT_NAME = "20-wallpaper-auto-theme.toml"
LIQUID_TRON_JSON = "Liquid-Tron.json"


def _ensure_private_dir(path: Path) -> None:
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        os.mkdir(path, 0o700)
        os.chmod(path, 0o700)
        return
    if not stat.S_ISDIR(st.st_mode):
        raise WallpaperError(f"{path} exists and is not a real directory")
    if st.st_uid != os.getuid():
        raise WallpaperError(f"{path} is owned by another user")
    if stat.S_IMODE(st.st_mode) != 0o700:
        os.chmod(path, 0o700)


def _ensure_marker(path: Path) -> None:
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o600:
            raise WallpaperError("ownership marker is a conflicting object")
        if path.read_bytes() != OWNER_MARKER_BYTES:
            raise WallpaperError("ownership marker has conflicting content")
        return
    with os.fdopen(fd, "wb") as f:
        f.write(OWNER_MARKER_BYTES)
        f.flush()
        os.fsync(f.fileno())


def _ensure_link(link: Path, target: Path) -> None:
    if not target.exists():
        raise WallpaperError(f"canonical target is missing: {target}")
    if link.is_symlink():
        if os.readlink(link) == str(target):
            return
        tmp = link.with_name(f".{link.name}.{secrets.token_hex(4)}.tmp")
        os.symlink(target, tmp)
        os.rename(tmp, link)
        return
    if os.path.lexists(link):
        raise WallpaperError(f"{link} exists and is not a symlink; refusing to replace it")
    os.symlink(target, link)


def prepare_config_home(config_home: Path, canonical_dir: Path) -> None:
    """Materialize the private Noctalia config tree (idempotent; never deletes anything)."""
    config_home.parent.mkdir(parents=True, exist_ok=True)
    noctalia = config_home / "noctalia"
    palettes = noctalia / "palettes"
    _ensure_private_dir(config_home)
    _ensure_private_dir(noctalia)
    _ensure_private_dir(palettes)
    _ensure_marker(noctalia / OWNER_MARKER)
    _ensure_link(noctalia / "config.toml", canonical_dir / "config.toml")
    _ensure_link(noctalia / FRAGMENT_NAME, canonical_dir / FRAGMENT_NAME)
    _ensure_link(palettes / LIQUID_TRON_JSON, canonical_dir / "palettes" / LIQUID_TRON_JSON)


def main(argv: Optional[Sequence[str]] = None, controller: Optional[Controller] = None) -> int:
    p = argparse.ArgumentParser(prog="wallpaper-control")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("hook")
    sub.add_parser("reconcile")
    sub.add_parser("status")
    sub.add_parser("library")
    sub.add_parser("restart-renderer")
    asn = sub.add_parser("apply-scene")
    for role in ROLES:
        asn.add_argument(f"--{role}", required=True)
    sub.add_parser("restart-guard")
    sub.add_parser("gaming-pause")
    sub.add_parser("intelligent-resume")
    am = sub.add_parser("apply-mainframe")
    am.add_argument("mode", choices=MAINFRAME_MODES)
    am.add_argument("--if-committed", action="store_true", help="no-op unless the committed mode already equals MODE")
    sub.add_parser("adopt-current").add_argument("mode", choices=["mainframe-parallax"])
    pc = sub.add_parser("prepare-config-home")
    pc.add_argument("--config-home", type=Path)
    pc.add_argument("--canonical-dir", type=Path)
    args = p.parse_args(argv)
    if args.cmd == "prepare-config-home":  # no controller / lock needed
        cfg = Config.default(os.environ)
        try:
            prepare_config_home(args.config_home or cfg.config_home, args.canonical_dir or CANONICAL_CONFIG_DIR)
        except (WallpaperError, OSError) as e:
            _log(f"prepare-config-home failed: {type(e).__name__}: {e}")
            return 1
        return 0
    ctl = controller or Controller(Config.default(os.environ), SubprocessRunner())
    try:
        if args.cmd == "hook":
            path = os.environ.get("NOCTALIA_WALLPAPER_PATH", "")
            if not path:
                _log("NOCTALIA_WALLPAPER_PATH is unset")
                return 1
            return ctl.hook(path, os.environ.get("NOCTALIA_WALLPAPER_CONNECTOR", ""))
        if args.cmd == "reconcile":
            return ctl.reconcile()
        if args.cmd == "apply-mainframe":
            return ctl.apply_mainframe(args.mode, args.if_committed)
        if args.cmd == "adopt-current":
            return ctl.adopt_current(args.mode)
        if args.cmd == "library":
            return ctl.library()
        if args.cmd == "restart-renderer":
            return ctl.restart_renderer()
        if args.cmd == "apply-scene":
            return ctl.apply_scene(args.left, args.center, args.right)
        if args.cmd == "restart-guard":
            return ctl.restart_guard()
        if args.cmd == "gaming-pause":
            return ctl.gaming_pause()
        if args.cmd == "intelligent-resume":
            return ctl.intelligent_resume()
        return ctl.status()
    except (WallpaperError, OSError) as e:
        _log(f"{args.cmd} failed: {type(e).__name__}: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
